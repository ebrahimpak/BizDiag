/**
 * Run `ollama list` on the host and return an array of model names (or null on failure).
 */
function getOllamaModels() {
  try {
    pb.redirectErrorStream(true);
    const proc = pb.start();
    const reader = new BufferedReader(new InputStreamReader(proc.getInputStream(), "UTF-8"));
    const models = [];
    let line;
    while ((line = reader.readLine()) !== null) {
      line = line.trim();
      if (!line) continue;
      if (/^name\b|^model\b|^-+$/i.test(line)) continue; // skip headers/separators
      const token = line.split(/\s+/)[0];
      if (token && models.indexOf(token) === -1) models.push(token);
    }
    reader.close();
    try { proc.waitFor(); } catch (e) {}
    return models.length > 0 ? models : null;
  } catch (error) {
    console.log("Error running ollama list:", error);
    return null;
  }
}

const paragiha = $(selection);

shell.setTextDirection(SWT.LEFT_TO_RIGHT);

/* function kewud(message, options) creates a dialog with 4 buttons:
"Replace Documentation" & "Append to Documentation" &
"Create Assessment" & "Cancel" (automatically added)

Return Values Explained:
When dialog.open() returns:
0 for first button >> ("Replace Documentation")
1 for second button >> ("Append to Documentation")
2 for third button >> ("Create Assessment")
3 for "Cancel" button

The function then transforms these:
return result == options.length ? null : (result + 1).toString();

So:
0 becomes "1" >> (Replace Documentation)
1 becomes "2" >> (Append Documentation)
2 becomes "3" >> (Create Assessment)
3 (Cancel) becomes null

Why 0 isn't handled: Because the code checks for specific values:
if (updateDocumentation == "3") {
    // Create Assessment
} 
else if (updateDocumentation == "2") {
    // Append Documentation
}
else if (updateDocumentation == "1") {
    // Replace Documentation
}

0 isn't possible because the function adds 1 to all results. If Cancel is clicked (result = 3),
it returns null, which doesn't match any conditions and effectively does nothing. */
function kewud(message, options) {
  // Enhanced dialog: supports optional models dropdown when caller passes a third parameter.
  // Backwards-compatible signature: kewud(message, options) -> returns string as before.
  // New signature: kewud(message, options, modelsArray) -> returns { choice: string|null, model: string }
  const args = Array.prototype.slice.call(arguments);
  const models = args.length >= 3 ? args[2] : null;

  const tmpShell = new org.eclipse.swt.widgets.Shell(
    shell,
    org.eclipse.swt.SWT.DIALOG_TRIM |
      org.eclipse.swt.SWT.APPLICATION_MODAL |
      org.eclipse.swt.SWT.LEFT_TO_RIGHT
  );
  tmpShell.setText("Analyzing the Selected Element");
  tmpShell.setLayout(new GridLayout(1, false));

  // Message label
  const msgLabel = new org.eclipse.swt.widgets.Label(tmpShell, SWT.WRAP);
  msgLabel.setText(message);
  msgLabel.setLayoutData(new GridData(SWT.FILL, SWT.CENTER, true, false));

  // Model selector (optional)
  let combo = null;
  if (models && Array.isArray(models) && models.length > 0) {
    const comboLabel = new org.eclipse.swt.widgets.Label(tmpShell, SWT.NONE);
    comboLabel.setText("Select AI Model:");
    comboLabel.setLayoutData(new GridData(SWT.FILL, SWT.CENTER, true, false));

    combo = new org.eclipse.swt.widgets.Combo(tmpShell, SWT.DROP_DOWN | SWT.READ_ONLY);
    combo.setItems(models);
    combo.select(0);
    combo.setLayoutData(new GridData(SWT.FILL, SWT.CENTER, true, false));
  }

  // Buttons area
  const buttonComposite = new org.eclipse.swt.widgets.Composite(tmpShell, SWT.NONE);
  buttonComposite.setLayoutData(new GridData(SWT.RIGHT, SWT.CENTER, false, false));
  buttonComposite.setLayout(new GridLayout(options.length + 1, false));

  // Create option buttons
  const btns = [];
  for (let i = 0; i < options.length; i++) {
    const b = new Button(buttonComposite, SWT.PUSH);
    b.setText(options[i]);
    btns.push(b);
  }
  // Cancel button
  const cancelBtn = new Button(buttonComposite, SWT.PUSH);
  cancelBtn.setText("Cancel");

  // Result holders
  let chosen = null;
  let selectedModel = null;

  const listener = new Listener({
    handleEvent: function (e) {
      for (let i = 0; i < btns.length; i++) {
        if (e.widget === btns[i]) {
          chosen = (i + 1).toString();
          break;
        }
      }
      if (e.widget === cancelBtn) chosen = null;

      // Read combo selection BEFORE closing the shell to avoid "Widget is disposed" exceptions
      if (combo) {
        try {
          // Check widget disposed state first
          if (typeof combo.isDisposed === 'function') {
              if (combo.isDisposed()) {
                // combo disposed; skip reading
              } else {
                const sel = combo.getSelectionIndex();
                if (sel >= 0) {
                  try {
                    selectedModel = combo.getItem(sel);
                  } catch (innerErr) {
                    selectedModel = null;
                  }
                }
              }
          } else {
            // Fallback: attempt to read safely
            const sel = combo.getSelectionIndex();
            if (sel >= 0) selectedModel = combo.getItem(sel);
          }
        } catch (err) {
          // widget may already be disposed in rare race conditions; ignore
          selectedModel = null;
        }
      }

      tmpShell.close();
    },
  });

  // Attach listeners
  btns.forEach((b) => b.addListener(SWT.Selection, listener));
  cancelBtn.addListener(SWT.Selection, listener);

  tmpShell.pack();
  tmpShell.open();
  while (!tmpShell.isDisposed()) {
    if (!display.readAndDispatch()) display.sleep();
  }

  if (models) {
    return { choice: chosen, model: selectedModel };
  }
  return chosen;
}

