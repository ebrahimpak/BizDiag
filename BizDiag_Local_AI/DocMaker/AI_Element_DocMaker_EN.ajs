/**
 * Creates and shows a custom dialog to confirm batch processing, showing a list of items.
 * @param {object[]} components - The array of selected components.
 * @returns {boolean} - True if the user clicks "Continue", false otherwise.
 */
function showBatchConfirmationDialog(components) {
  // This variable will hold the dialog's result. It's 'false' by default.
  let proceed = false;

  // Create the main dialog window (Shell). It's modal, so it blocks interaction with the main app.
  const dialogShell = new org.eclipse.swt.widgets.Shell(
    shell,
    SWT.DIALOG_TRIM | SWT.APPLICATION_MODAL | SWT.LEFT_TO_RIGHT
  );
  dialogShell.setText("Confirm Group Analysis"); // Set the window title.
  // Use a GridLayout with 1 column to arrange widgets vertically.
  dialogShell.setLayout(new GridLayout(1, false));

  // Create a text label to display the main instruction message.
  const label = new org.eclipse.swt.widgets.Label(dialogShell, SWT.WRAP);
  label.setText(
    `You have selected ${components.length} . Element documentations will be generated, for each element. Are you certain you want to succeed?`
  );
  // Create a Table widget with checkboxes, borders, and scrollbars.
  // The SWT.CHECK style is what automatically adds a checkbox to each row.
  let labelData = new GridData(SWT.FILL, SWT.CENTER, true, false);
  labelData.verticalIndent = 10;
  labelData.horizontalIndent = 10;
  label.setLayoutData(labelData);

  const table = new Table(
    dialogShell,
    SWT.BORDER |
      SWT.V_SCROLL |
      SWT.H_SCROLL |
      SWT.FULL_SELECTION |
      SWT.MULTI |
      SWT.CHECK
  );
  // Configure the table's layout data to fill available space and set a preferred height.
  let tableData = new GridData(SWT.FILL, SWT.FILL, true, true);
  tableData.heightHint = 150;
  tableData.horizontalIndent = 0;
  table.setLayoutData(tableData);
  table.setHeaderVisible(true);
  table.setLinesVisible(true);

  // Create three columns: Index, Element Name, Status
  const col1 = new tableColumn(table, SWT.NONE);
  col1.setText("Having Documentation");
  col1.setWidth(50);

  const col2 = new tableColumn(table, SWT.NONE);
  col2.setText("Element Name");
  col2.setWidth(350);

  const col3 = new tableColumn(table, SWT.NONE);
  col3.setText("Current Documentation");
  col3.setWidth(150);

  const verylightblue = new color(display, new rgb(214, 255, 255));

  // Loop through the selected components and create a TableItem for each one, so as to populate the table.
  for (let i = 0; i < components.length; i++) {
    // A TableItem represents a single row in the table.
    const item = new TableItem(table, SWT.NONE);
    if (i % 2 === 0) {
      item.setBackground(verylightblue);
    }
    //item.setText(0, `${i + 1}`); // column 0: index
    if (components[i].documentation != 0) {
      item.setChecked(true);
    } // Set the checkbox for this row to be checked by default.
    item.setText(1, components[i].name);
    item.setText(2, `${components[i].documentation}`);
  }
  col1.setAlignment(SWT.CENTER);
  col2.setAlignment(SWT.CENTER);
  col3.setAlignment(SWT.CENTER);
  col1.pack();
  col2.pack();
  col3.setWidth(500);

  // Create a Composite widget to group the buttons together on the right side.
  const buttonComposite = new org.eclipse.swt.widgets.Composite(
    dialogShell,
    SWT.NONE
  );
  // Align the composite to the right.
  buttonComposite.setLayoutData(
    new GridData(SWT.RIGHT, SWT.CENTER, false, false)
  );
  // Use a GridLayout with 2 columns for the buttons.
  buttonComposite.setLayout(new GridLayout(2, false));

  // Create the "Continue" button.
  const continueButton = new Button(buttonComposite, SWT.PUSH);
  continueButton.setText("YHes, please continue.");
  // Set this as the default button (activated when Enter is pressed).
  dialogShell.setDefaultButton(continueButton);

  // Create the "Cancel" button.
  const cancelButton = new Button(buttonComposite, SWT.PUSH);
  cancelButton.setText("Cancel");

  // Create a single, reusable event listener for both buttons.
  const listener = new Listener({
    handleEvent: function (e) {
      // Check if the "Continue" button was the one that was clicked.
      if (e.widget == continueButton) {
        proceed = true; // If so, set our result variable to true.
      }
      // In either case (Continue or Cancel), close the dialog.
      dialogShell.close();
    },
  });

  // Attach the listener to the 'Selection' event of both buttons.
  continueButton.addListener(SWT.Selection, listener);
  cancelButton.addListener(SWT.Selection, listener);

  // Automatically resize the dialog to fit its contents.
  dialogShell.pack();
  // Open the dialog to make it visible and active.
  dialogShell.open();

  // This is the UI event loop. It keeps the dialog open and responsive.
  // It continuously reads and dispatches UI events (like clicks) until the shell is disposed (closed).
  while (!dialogShell.isDisposed()) {
    if (!display.readAndDispatch()) {
      display.sleep();
    }
  }

  // Once the dialog is closed, return the result.
  return proceed;
}

async function processComponents(components) {
  for (let idx = 0; idx < components.length; idx++) {
    const parag = components[idx];
    console.log(`Generating Summary for component:${parag.name}`);
    console.log("Selected component type:", parag.type);
    console.log(
      "Selected component documentation:",
      parag.documentation
    );

    // First get the user's choice (show model selector populated from Ollama)
    console.log("Showing initial dialog for user choice...");
    let models = null;
    try {
      models = getOllamaModels();
      console.log("Found Ollama models:", models);
    } catch (err) {
      console.log("Unable to fetch Ollama models:", err);
      models = null;
    }

    const kewudResult = kewud(
      `\nAnalysis, for the element:\n:${parag.name}`,
      ["Replace Documentation", "Add to Current Documentation", "Create Assessment Element"],
      models
    );

    let updateDocumentation = null;
    let selectedModel = null;
    if (kewudResult && typeof kewudResult === "object") {
      updateDocumentation = kewudResult.choice;
      selectedModel = kewudResult.model;
    } else {
      updateDocumentation = kewudResult;
    }

    console.log("User selected option:", updateDocumentation, "model:", selectedModel);

    if (!updateDocumentation) {
      console.log("User cancelled - skipping this component");
      continue;
    }

    // Then generate the analysis with the appropriate isReplacement flag.
    console.log(
      "Generating analysis with isReplacement =",
      updateDocumentation === "1"
    );
    /* Await the async AI call so that summary is a resolved string. The await keyword pauses
       the for loop at this point, waits for the AI to respond and for the Promise to resolve
       with the Summary text, and only then continues to the next part of the loop. Because
       await is used here, the processComponents function signature must be async. */
    let summary = await generateAnalysis(
      parag,
      markdownContent,
      updateDocumentation === "1", // true if Replace Documentation was chosen.
      components.length > 1 ? `${idx + 1}/${components.length}` : null,
      selectedModel
    );

    console.log("Analysis generated, length:", summary ? summary.length : 0);

    // Show the generated summary
    kewud(
      `\nAnalysis for the Element:\n${parag.name}\n\r${summary}`,
      ["Ok"]
    );

    if (updateDocumentation == "3") {
      // Create Assessment
      let theAnalysis = model.createElement(
        "assessment",
        `Analysis for the Element:${parag.name}`
      );

      theAnalysis.documentation = summary;

      //const paydag = $(selection).parent();   :This would have picked only non-nested elements.
      const paydag = $(selection)
        .parents()
        .filter("archimate-diagram-model")
        .first();
      //This picks non-nested & free elements.
      const hamunPaydag = [paydag].flat()[0];

      /* overload signature: add(element, x, y, width, height). This method Add a new element to the view.
        Alternative overload signatures: add(relationship, sourceDiagramObj, targetDiagramObj), add(diagramObject, x, y) */
      let analysisDiagramObj = hamunPaydag.add(theAnalysis, 200, 150, 180, 50);

      // Set font properties for the diagram object
      analysisDiagramObj.fontName = "Arial";
      analysisDiagramObj.fontSize = "11"; // font size in points
      analysisDiagramObj.fontColor = "#0b839c"; // RGB color in hex
      analysisDiagramObj.textAlignment = 2; // 2 = center alignment
      analysisDiagramObj.textPosition = 0; // 0 = center position

      let associationR = model.createRelationship(
        "association-relationship",
        "",
        parag.concept ? parag.concept : parag,
        theAnalysis
      );

      console.log(`The constructed relationship is: ${associationR}`);

      if (!analysisDiagramObj) {
        console.log(
          "Unfortunately, I cannot find the Element in the Diagram."
        );
      } else {
        // Add the relationship to the view using diagram objects only
        hamunPaydag.add(
          associationR,
          parag, // source diagram object
          analysisDiagramObj // target diagram object
        );
      }
    } // end create-assessment branch
    else if (updateDocumentation == "2") {
      //Append Documentation
      console.log("Appending documentation");
      parag.documentation += summary;
      console.log("Documentation appended successfully");
    } else if (updateDocumentation == "1") {
      // Replace Documentation
      console.log("Replacing documentation");
      parag.documentation = summary;
      console.log("Documentation replaced successfully");
    }
  } // end for
} // end processComponents

// Main execution using an async IIFE for top-level await
(async function main() {
  try {
    // If no components are selected, do nothing.
    if (paragiha.length === 0) {
      kewud(
        "Please select one or more elements for analysis.",
        ["OK"]
      );
      return;
    }

    // Check if multiple components are selected and show the custom confirmation dialog.
    if (paragiha.length > 1) {
      const proceed = showBatchConfirmationDialog(paragiha);

      if (!proceed) {
        console.log("User cancelled batch processing.");
        return; // Exit if user cancels
      }
    }

    // Await the completion of the entire process
    await processComponents(paragiha);
    console.log("All selected components have been processed.");
  } catch (error) {
    console.log(
      `An unexpected error occurred in the main execution block: " + ${error.stack}`
    );
    kewud(`An unexpected error occurred.${error.message}`, [
      "OK",
    ]);
  }
})();

/* The following function builds a structured prompt string containing component details. Function Parameters:
    parag: The ArchiMate element being analyzed   /   theContext: The markdown content of the current view
    It starts with component name, then adds component type, adds specialization if it exists (using ternary operator),
    and finally adds documentation if it exists and is not empty (using ternary operator)
    Example Output:
    If we have a component named "Process Data" with type "application-process", the componentPrompt might look like:
    Component Name: "Process Data", Component Type: "application-process", Property: "status" = "active"
    This is then combined with the promptTemplate and sent to the AI service for analysis.
    */
function generateAnalysis(
  parag,
  theContext,
  isReplacement = false,
  progressText = null,
  modelName = null
) {
  let componentPrompt = `Component Name: \"${
    parag.name
  }\", Component Type: \"${parag.type}\"${
    parag.specialization != null
      ? ', Component Specialization: "' + parag.specialization + '"'
      : ""
  }${
    parag.documentation != "" && parag.documentation != null
      ? ', Current Documentation: "' + parag.documentation + '"'
      : ""
  }`;
  parag.prop().forEach(function (prop) {
    // Iterates through all properties of the component and add them to the prompt

    componentPrompt += ` Property: "${prop}" = "${parag.prop(prop)}",`;
  });

  // --- Create and show a "Please Wait" dialog ---
  // A modal dialog shell that blocks other UI interaction. LEFT_TO_RIGHT ensures correct English layout.
  const waitShell = new org.eclipse.swt.widgets.Shell(
    shell,
    SWT.DIALOG_TRIM | SWT.APPLICATION_MODAL | SWT.LEFT_TO_RIGHT
  );
  waitShell.setText("⧗ Please be patient ⧖"); // Set the dialog window title.
  // A grid layout with 1 column.
  const gridLayout = new org.eclipse.swt.layout.GridLayout(1, false);
  gridLayout.marginWidth = 25; // Add horizontal padding inside the dialog.
  gridLayout.marginHeight = 25; // Add vertical padding inside the dialog.
  waitShell.setLayout(gridLayout); // Apply the layout to the shell.

  // Create a label to display the wait message and icon.
  const waitLabel = new org.eclipse.swt.widgets.Label(waitShell, SWT.NONE);
  let waitText =
    "Generating analysis for the selected Element, by Artificial Intelligence...⏳";
  if (progressText) {
    waitText = ` ${progressText} \u202B: \u202C ${waitText}`;
  }
  waitLabel.setText(waitText); // Set text with Unicode hourglass.

  waitShell.pack(); // Resize the shell to be just big enough for its contents.
  waitShell.open(); // Open the shell to make it visible.
  while (display.readAndDispatch()) {} // Process UI events to ensure the dialog is drawn immediately.
  // --- End of "Please Wait" dialog ---

  try {
    const result = ai(
      `${promptTemplate}, analyse ${componentPrompt} in the context of:\n ${theContext}`,
      parag,
      isReplacement,
      modelName
    ); // Sends the complete prompt to the AI service with proper isReplacement flag and optional model
    return result;
  } finally {
    // Ensure the wait dialog is closed even if an error occurs
    if (waitShell && !waitShell.isDisposed()) {
      waitShell.close();
    }
  }
}
