 * @fileoverview Archi/jArchi entry point for identifying the capability-map scope and preparing inputs.
 *
 * Move 1 reflects the capability identification and capability-map framing in "Capability-Based
 * Planning, The Link between Strategy and Enterprise Architecture" and "Capability-based Planning in
 * 7 moves!". The map contains existing Capability elements and their explicitly modeled hierarchy.
 * It does not derive or create Capabilities from Value Streams, Resources, Courses of Action, or
 * other elements. Courses of Action remain separate potential strategy inputs.
 */
console.clear();
console.show();

/**
 * Runs Move 1: validates model and increments, discovers the approved scope, prepares editable
 * properties/worklists, and persists the run checkpoint for Moves 2-7.
 *
 * The user reviews, edits, and saves the model before separately launching the continuation.
 * This preserves the human-in-the-loop assessment and planning workflow described in the CBP
 * literature rather than combining identification and assessment into automatic inference.
 */
(function() {
    "use strict";

    const rootDirectory = __DIR__;
    load(rootDirectory + "lib/CBP_Model_Inputs.js");
    load(rootDirectory + "lib/CBP_Run_State.js");
    load(rootDirectory + "lib/CBP_View_Generator.js");

    /**
     * Writes a visible phase header to the Archi script console.
     * @param {string} text Phase label.
     */
    function logHeader(text) { console.log("=== " + text + " ==="); }

    /**
     * Writes a consistently prefixed Move 1 error to the Archi console.
     * @param {string} text Error message.
     */
    function logError(text) { console.error("[ERROR] " + text); }

    try {
        logHeader("CBP Move 1 - Setup");
        if (typeof model === "undefined" || !model) {
            throw new Error("No active ArchiMate model is available.");
        }
        const activeModel = model;
        const modelIdentity = cbpRunState.modelIdentity(activeModel);
        const priorRun = cbpRunState.readRun(activeModel);
        if (priorRun && priorRun.status === "INPUTS_PENDING") {
            const decision = window.promptSelection(
                "A CBP run is still pending for '" + priorRun.model.name + "'. Continue setup would replace its scope. " +
                "Choose whether to explicitly abort it.",
                ["Abort pending run and start a new Move 1 setup", "Cancel"]
            );
            if (decision !== "Abort pending run and start a new Move 1 setup") {
                console.log("CBP Move 1 cancelled; the pending run was preserved.");
                return;
            }
            priorRun.status = "ABORTED";
            priorRun.abortedAt = new Date().toISOString();
            cbpRunState.writeRun(activeModel, priorRun);
        }
        if (priorRun && priorRun.status !== "INPUTS_PENDING" && priorRun.status !== "COMPLETED" &&
            priorRun.status !== "ABORTED") {
            throw new Error("The existing CBP run has an unsupported status: " + priorRun.status + ".");
        }

        let incrementText = cbpRunState.property(activeModel, "CBP.Increments");
        if (!incrementText) {
            incrementText = window.prompt(
                "Enter the consecutive four-digit planning years, separated by commas (for example 2027,2028).\n" +
                "These years are required to prepare all Move 5-7 inputs. CBP will not choose years for you.",
                ""
            );
            if (incrementText === null || incrementText === undefined) {
                console.log("CBP Move 1 cancelled before changing the model.");
                return;
            }
        }
        const incrementResult = cbpModelInputs.parseIncrements(incrementText);
        if (!incrementResult.valid) throw new Error(incrementResult.reason);

        const discovered = cbpRunState.discoverScope();
        const capabilities = discovered.capabilities.slice();
        if (!capabilities.length) {
            throw new Error("Move 1 requires at least one existing ArchiMate Capability. Value Streams, Resources, " +
                "Courses of Action, and other element types are not included in the Capability Map or converted " +
                "into generated Capability candidates.");
        }
        const potentialStrategies = cbpRunState.discoverPotentialStrategies();
        const stableViewIds = {};
        Object.keys(priorRun && priorRun.views || {}).forEach(function(key) {
            stableViewIds[key] = priorRun.views[key];
        });
        if (stableViewIds.profile) {
            stableViewIds["CBP - Capability Profiles and Inputs"] = stableViewIds.profile;
        }
        const viewPlans = cbpViewGenerator.preflightViews(activeModel, [
            cbpViewGenerator.NAMES.capabilityMap,
            cbpViewGenerator.NAMES.profile,
            cbpViewGenerator.NAMES.strategies
        ], stableViewIds, {
            "CBP - Capability Profiles and Inputs": "CBP - Capability Map and Profiles"
        });

        // ===== MOVE 1: Map existing Capabilities and prepare editable model inputs. =====
        const stableModelIdentity = cbpRunState.ensureModelIdentity(activeModel);
        if (!cbpRunState.property(activeModel, "CBP.Increments")) {
            cbpModelInputs.writeProperty(activeModel, "CBP.Increments", incrementResult.years.join(","));
        }
        const capabilityCodes = cbpRunState.ensureInputCodes(capabilities);
        const requiredCapabilityKeys = [
            "CBP.Maturity.People", "CBP.Maturity.Process", "CBP.Maturity.Technology"
        ];
        incrementResult.years.forEach(function(year) {
            requiredCapabilityKeys.push("CBP.TargetML." + year);
            cbpModelInputs.DIMENSIONS.forEach(function(dimension) {
                requiredCapabilityKeys.push("CBP.Target." + dimension + "." + year);
                requiredCapabilityKeys.push("CBP.Action." + dimension + "." + year);
                requiredCapabilityKeys.push("CBP.Project." + dimension + "." + year);
                requiredCapabilityKeys.push("CBP.ProjectPriority." + dimension + "." + year);
            });
        });
        capabilities.forEach(function(capability) {
            requiredCapabilityKeys.forEach(function(key) { cbpRunState.setIfAbsent(capability, key); });
        });

        potentialStrategies.forEach(function(strategy) {
            cbpRunState.setIfAbsent(strategy, "CBP.Role");
            capabilities.forEach(function(capability) {
                cbpRunState.setIfAbsent(strategy, cbpModelInputs.impactKey(capability));
            });
        });

        const runId = "cbp-" + Date.now().toString(36) + "-" +
            Math.floor(Math.random() * 0x1000000).toString(36);
        const run = {
            schema: 1,
            runId: runId,
            model: stableModelIdentity,
            capabilityIds: capabilities.map(cbpRunState.idOf),
            capabilityCodes: capabilityCodes,
            potentialStrategyIds: potentialStrategies.map(cbpRunState.idOf),
            strategyIds: potentialStrategies.filter(function(strategy) {
                return cbpRunState.property(strategy, "CBP.Role") === "Strategy";
            }).map(cbpRunState.idOf),
            increments: incrementResult.years,
            status: "INPUTS_PENDING",
            createdAt: new Date().toISOString(),
            views: {}
        };
        const setupViews = cbpViewGenerator.drawSetup(
            activeModel, capabilities, potentialStrategies, run, viewPlans
        );
        run.views.capabilityMap = cbpRunState.idOf(setupViews.capabilityMap);
        run.views.profile = cbpRunState.idOf(setupViews.profile);
        run.views.strategies = cbpRunState.idOf(setupViews.strategies);
        cbpRunState.writeRun(activeModel, run);

        console.log("[OK] Move 1 setup complete. Run ID: " + runId);
        console.log("Model: " + modelIdentity.name +
            " | Capabilities: " + capabilities.length +
            " | Courses of Action: " + potentialStrategies.length +
            " | Increments: " + incrementResult.years.join(", "));
        if (!setupViews.capabilityRelationshipCount && capabilities.length > 1) {
            console.log("[WARN] No existing Capability-to-Capability composition or aggregation relationships were " +
                "found in scope. The map shows the Capabilities without inventing a hierarchy; model their " +
                "decomposition to make the map structured.");
        }
        console.log("Open the Capability Map and the two CBP input worklists, enter the listed properties on their " +
            "model elements, and save " +
            "the model before running CBP_Continue_Moves_2_to_7.ajs.");
        if (!run.strategyIds.length) {
            console.log("[WARN] No Course of Action is currently marked CBP.Role=Strategy. Mark intended Courses of " +
                "Action before continuing; otherwise Move 3 will have no strategic-importance score.");
        }
    } catch (error) {
        const message = error && error.message ? error.message : String(error);
        logError("Move 1 stopped: " + message);
        if (error && error.stack) console.error(error.stack);
        window.alert("CBP Move 1 stopped:\n" + message);
    }
})();
