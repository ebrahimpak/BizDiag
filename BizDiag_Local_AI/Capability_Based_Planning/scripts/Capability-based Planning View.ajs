 *
 * Capability-based Planning View for jArchi
 * Version 2.0
 * Builds a capability-based planning view from existing model elements, their structural relationships, and the
 * seven-step CBP methodology.
 *
 * What is CEBA?
 * Capability-based Enterprise Architecture (CBEA) is a unified, business-led approach to enterprise architecture (EA)
 * that places business capabilities (BCs) at the center of architectural design, development, and governance, linking
 * organizational strategy to business and IT architecture. It responds to four principal drivers:
 *
 *   (1) business-led EA, emphasizing business outcomes
 *   (2) strategic architecture, supporting long-term organizational objectives
 *   (3) integrated planning, coordinating people, processes, and technology
 *   (4) architectural stability, leveraging capabilities as relatively stable units of enterprise functionality.
 *
 * CBEA conceptualizes the enterprise as a hierarchical map of interconnected capabilities that deliver business
 * services to internal and external stakeholders, orchestrated through value streams and supported by architectural
 * assets, including business actors, processes, applications, and technology services. Its generic roadmap comprises
 * five complementary stages:
 *
 *   (1) initial Capability Mapping
 *   (2) Capability-Based Planning through maturity assessment and strategic impact analysis
 *   (3) incremental Capability Development involving the redesign of services, processes, organizational structures, and supporting technologies
 *   (4) Enterprise Integration to coordinate capabilities and optimize shared architectural components
 *   (5) EA Management and governance to maintain strategic alignment and adapt to organizational and environmental changes.
 *
 * Overall, CBEA provides a consistent framework for translating strategic intent into an integrated enterprise
 * architecture and managing organizational transformation through the systematic development of business capabilities.
 *
 * CBP comprises seven steps:
 *
 *  (1) Identify and model business capabilities by constructing and refining a hierarchical Business Capability Map
 *  based on strategic documents, value streams, organizational structures, and reference models.
 *
 *  (2) Assess maturity by evaluating each capability’s people, process, and technology dimensions and calculating its
 *  overall maturity level.
 *
 *  (3) Assess strategic importance by evaluating each capability’s contribution to organizational strategies.
 *
 *  (4) Analyze the capability landscape by combining maturity and strategic importance in an ML–SI matrix to identify
 *  capability gaps, acceptable maturity levels, and potential risks to strategy execution.
 *
 *  (5) Set improvement goals by defining target maturity levels and incremental development milestones according to
 *  strategic priorities, resources, and timelines.
 *
 *  (6) Define actions by translating maturity improvement goals into specific initiatives addressing people, processes,
 *  and technology.
 *
 *  (7) Design the change portfolio by consolidating and prioritizing these actions into coordinated projects and
 *  programs, followed by implementation, monitoring, and iterative reassessment.
 *
 * Candidate Capabilities:
 * When the planning scope contains no Capability elements, eligible business functions, processes, or services can
 * seed provisional Capability candidates. Each candidate is a separate model element linked to its source by
 * provenance; the source is not converted or changed. Candidates are marked CBP.CandidateStatus=ReviewRequired,
 * assessed provisionally through the seven moves, and should be validated by a user before relying on their results.
 */
console.clear();
console.show();

/**
 * Orchestrates CBP analysis and view generation for the active Archi model.
 *
 * Resolves model scope, validates planning settings, assesses capabilities, materializes
 * the seven move records, rebuilds the supporting views, reports gaps, and opens the
 * overview. Existing model evidence and user-supplied planning properties remain
 * authoritative; missing assessments and portfolio decisions are not inferred.
 */
(function() {
    "use strict";

    const scriptName = "Capability-based Planning View";
    const viewName = "Capability-based Planning View";
    let activeModel = null;
    const diagramObjectsByElementId = {};
    let displayedRelationshipCount = 0;
    let methodologyRelationshipCount = 0;
    const diagramConnectionCounts = {};
    let omittedRelationshipCount = 0;
    let skippedLegacyRelationshipCount = 0;
    let skippedCapabilityMapPlaceholder = false;
    const generatedRelationshipNames = {
        "related to": true,
        "aggregation": true,
        "composition": true,
        "specialization": true,
        "serving": true,
        "triggering": true,
        "realization": true
    };
    const generatedElementNames = {
        "capability map": true,
        "capability-based planning": true,
        "maturity + strategic importance": true,
        "business value delivery": true,
        "action portfolio": true,
        "action roadmap": true,
        "capability assessment": true,
        "capability portfolio summary": true,
        "cbp step 1 - identify and model business capabilities": true,
        "cbp step 2 - assess maturity": true,
        "cbp step 3 - assess strategic importance": true,
        "cbp step 4 - analyze the capability landscape": true,
        "cbp step 5 - set improvement goals": true,
        "cbp step 6 - define actions": true,
        "cbp step 7 - design the change portfolio": true
    };
    // The seven Business Process concepts label the method workflow; analytical results are
    // separately calculated from the CBP.* model properties documented in each output view.
    const methodologySteps = [
        "CBP Step 1 - Identify and model business capabilities",
        "CBP Step 2 - Assess maturity",
        "CBP Step 3 - Assess strategic importance",
        "CBP Step 4 - Analyze the capability landscape",
        "CBP Step 5 - Set improvement goals",
        "CBP Step 6 - Define actions",
        "CBP Step 7 - Design the change portfolio"
    ];
    // Every Business Capability consists of 3 dimensions, viz. People; Process; Technology.
    const dimensions = ["People", "Process", "Technology"];
    // Keep analytical products in separate views so assessment evidence, strategic results,
    // change goals, and delivery packages are not visually conflated with the capability map.
    const analysisViewNames = {
        maturity: "CBP - Maturity and Strategic Importance",
        matrix: "CBP - ML-SI Matrix and Improvement Goals",
        portfolio: "CBP - Actions and Change Portfolio"
    };

    /**
     * Writes an informational message using the Archi console.
     * Warning messages elsewhere use console.log for runtime compatibility.
     * @param {string} message Message to write.
     */
    function logInfo(message) { console.log(message); }

    /**
     * Writes a warning message to the Archi console.
     * @param {string} message Warning text.
     */
    function logWarn(message) { console.log("[WARN] " + message); }

    /**
     * Writes a section heading to the Archi console.
     * @param {string} message Heading text.
     */
    function logHeader(message) { console.log("=== " + message + " ==="); }

    /**
     * Writes a success message to the Archi console.
     * @param {string} message Success text.
     */
    function logSuccess(message) { console.log("[OK] " + message); }

    /**
     * Writes an error message to the Archi console.
     * @param {string} message Error text.
     */
    function logError(message) { console.error("[ERROR] " + message); }

    /**
     * Attempts to load an optional jArchi helper script.
     * @param {string} path Path passed to jArchi's load function.
     * @returns {boolean} True when loading succeeds; false when the optional helper is unavailable.
     */
    function safeLoad(path) {
        try {
            load(path);
            return true;
        } catch (e) {
            return false;
        }
    }

    /**
     * Validates that the global jArchi model proxy is available before model operations.
     * @returns {Object|null} The active model, or null when it is unavailable.
     */
    function getCurrentModel() {
        try {
            if (typeof model === "undefined" || model === null) return null;
            if (typeof model.getName === "function") {
                model.getName();
            }
            if (typeof model.getViews === "function") {
                model.getViews();
            }
            return model;
        } catch (e) {
            return null;
        }
    }

    /**
     * Normalizes name access across jArchi wrappers and plain object-like values.
     * @param {Object} element Model element whose name is requested.
     * @returns {string} Element name, or "Unnamed" when unavailable.
     */
    function getName(element) {
        try {
            if (!element) return "Unnamed";
            if (typeof element.getName === "function") return element.getName() || "Unnamed";
            if (element.name) return element.name || "Unnamed";
            return "Unnamed";
        } catch (e) {
            return "Unnamed";
        }
    }

    /**
     * Normalizes access to an ArchiMate concept or relationship type.
     * @param {Object} element Model object whose type is requested.
     * @returns {string} Type identifier, or an empty string when unavailable.
     */
    function getTypeName(element) {
        try {
            if (!element) return "";
            if (typeof element.getType === "function") {
                const t = element.getType();
                if (t) return String(t);
            }
            if (element.type) return String(element.type);
            return "";
        } catch (e) {
            return "";
        }
    }

    /**
     * Determines whether an element belongs in the CBP planning scope.
     *
     * Excludes known generated artifacts and admits only supported architecture concepts.
     * Generated Capability candidates are also assessed provisionally for post-run review.
     * @param {Object} element Candidate model element.
     * @returns {boolean} True when the element is in scope.
     */
    function isPlanningScopeElement(element) {
        if (!element) return false;
        const planningTypes = [
            "capability",
            "business-function",
            "business-process",
            "business-service",
            "business-actor",
            "application-component",
            "technology-service",
            "goal",
            "outcome"
        ];
        const name = getName(element);
        if (generatedElementNames[name.toLowerCase()]) return false;
        if (/ — (People|Process|Technology):/.test(name)) return false;
        return planningTypes.indexOf(getTypeName(element)) !== -1;
    }

    /**
     * Identifies generated Capability candidates using their source-provenance property.
     * @param {Object} element Capability concept to inspect.
     * @returns {boolean} True when the element was generated as a candidate.
     */
    function isCapabilityCandidate(element) {
        return getProperty(element, "CBP.Candidate.SourceID") !== "";
    }

    /**
     * Retrieves elements selected in Archi, when the jArchi selection helper is available.
     * @returns {Object[]} Selected concepts; an empty array when none can be resolved.
     */
    function ensureSelectedConcepts() {
        const items = [];
        // A selection narrows the view when it contains supported concepts; otherwise scan the model.
        try {
            if (typeof resolveSelection !== "undefined" && resolveSelection && typeof resolveSelection.selectedConcepts === "function") {
                const sel = resolveSelection.selectedConcepts("element");
                if (sel && typeof sel.each === "function") {
                    sel.each(function(item) {
                        if (item) items.push(item);
                    });
                }
                if (items.length === 0 && sel && sel.size && sel.size() > 0) {
                    const n = sel.size();
                    for (let i = 0; i < n; i++) {
                        const it = sel.get(i);
                        if (it) items.push(it);
                    }
                }
            }
        } catch (e) {
            logWarn("Selection resolution unavailable; scanning the model instead.");
        }
        return items;
    }

    /**
     * Discovers supported CBP concepts from the selection, or scans the model when needed.
     *
     * A supported selection narrows the scope; when the selection is empty or contains no
     * supported concepts, the function scans the model for the supported type set. Elements
     * are deduplicated by model ID, and known generated artifacts are excluded so results
     * from previous runs are not mistaken for source architecture.
     * @returns {Object[]} Distinct planning-scope elements.
     */
    function discoverPlanningElements() {
        const items = [];
        const seen = {};

        /**
         * Adds a supported scope element once, keyed by model ID rather than name.
         * Different architecture concepts may legitimately share a name.
         * @param {Object} element Candidate model element.
         */
        function addCandidate(element) {
            if (!element) return;
            if (!isPlanningScopeElement(element)) {
                if (getTypeName(element) === "capability" && getName(element).toLowerCase() === "capability map") {
                    skippedCapabilityMapPlaceholder = true;
                }
                return;
            }
            const id = String(element.id);
            if (!id || id === "undefined" || seen[id]) return;
            seen[id] = true;
            items.push(element);
        }

        const selected = ensureSelectedConcepts();
        for (let i = 0; i < selected.length; i++) {
            const el = selected[i];
            if (isPlanningScopeElement(el)) {
                addCandidate(el);
            }
        }

        // Do a full-model scan only when selection did not yield any supported elements.
        if (items.length === 0) {
            const planningTypes = [
                "capability",
                "business-function",
                "business-process",
                "business-service",
                "business-actor",
                "application-component",
                "technology-service",
                "goal",
                "outcome"
            ];
            for (let i = 0; i < planningTypes.length; i++) {
                try {
                    $(planningTypes[i]).each(function(element) {
                        addCandidate(element);
                    });
                } catch (e) {
                    logWarn("Could not scan " + planningTypes[i] + " elements: " + e.message);
                }
            }
        }

        if (items.length === 0) {
            logWarn("No capability-planning elements were found in the current selection or active model.");
        }

        return items;
    }

    /**
     * Seeds Move 1 with review-required Capability hypotheses when the scope has none.
     *
     * Business functions, processes, and services can seed candidates. Existing candidates
     * are reused by source ID; missing ones are created with source provenance and
     * ReviewRequired status. The source concepts and relationships remain unchanged.
     * Candidates are assessed provisionally in this run and should be reviewed before relying on their results.
     * @param {Object[]} sourceElements Elements in the selected planning scope.
     * @returns {Object[]} Existing or newly created review-required Capability candidates.
     */
    function createCapabilityCandidates(sourceElements) {
        const existingBySourceId = {};
        const sourcesToConvert = [];
        const candidates = [];
        $("capability").each(function(capability) {
            const sourceId = getProperty(capability, "CBP.Candidate.SourceID");
            if (sourceId) existingBySourceId[sourceId] = capability;
        });

        for (let i = 0; i < sourceElements.length; i++) {
            const source = sourceElements[i];
            const sourceType = getTypeName(source);
            if (sourceType !== "business-function" &&
                sourceType !== "business-process" &&
                sourceType !== "business-service") continue;
            if (isCapabilityCandidate(source) || sourceType === "capability") continue;
            const sourceId = String(source.id);
            if (!existingBySourceId[sourceId]) sourcesToConvert.push(source);
            else candidates.push(existingBySourceId[sourceId]);
        }

        for (let i = 0; i < sourcesToConvert.length; i++) {
            const source = sourcesToConvert[i];
            const sourceId = String(source.id);
            const candidate = activeModel.createElement(
                "capability",
                "[CBP Candidate] " + getName(source) + " [" + getTypeName(source) + "]"
            );
            candidate.documentation =
                "Review-required CBP capability candidate derived from the existing " +
                getTypeName(source) + " '" + getName(source) + "'. Confirm whether this represents an " +
                "enterprise ability, then rename/refine it and complete its hierarchy and profile. This candidate " +
                "is assessed provisionally during generation; validate it and its assessment before relying on the " +
                "results, then set CBP.CandidateStatus=Approved. This generated concept is not a validated capability.";
            setProperty(candidate, "CBP.GeneratedBy", "Capability-based Planning View");
            setProperty(candidate, "CBP.Candidate.SourceID", sourceId);
            setProperty(candidate, "CBP.Candidate.SourceType", getTypeName(source));
            setProperty(candidate, "CBP.Candidate.SourceName", getName(source));
            setProperty(candidate, "CBP.CandidateStatus", "ReviewRequired");
            candidates.push(candidate);
        }
        return candidates;
    }

    /**
     * Collects accepted structural links for the overview's capability hierarchy.
     *
     * Only composition, aggregation, and specialization relationships between included
     * elements participate. Composition and aggregation retain source-to-target parentage;
     * specific-to-general specialization is reversed for layout only. The original
     * relationship object is retained for drawing in its actual model direction. Links that
     * would introduce a second parent or cycle are omitted; behavioral, dependency, serving,
     * and motivation relationships are not interpreted as hierarchy.
     * @param {Object[]} elements Elements included in the overview.
     * @returns {{
     *   childrenByParent: Object<string, Array<{id: string, relationship: Object, sourceId: string, targetId: string}>>,
     *   parentByChild: Object<string, string>,
     *   relationships: Object[]
     * }} Accepted hierarchy edges and layout-oriented parent/child indexes.
     */
    function collectHierarchyRelationships(elements) {
        const includedIds = {};
        const sets = {};
        const parentByChild = {};
        const childrenByParent = {};
        const selectedRelationships = [];
        // Composition and aggregation point from whole to part. Specialization points from
        // specific to general, so its layout parent/child order must be reversed below.
        // Only existing links are reused; the script does not invent a capability taxonomy.
        const hierarchyTypes = {
            "composition-relationship": true,
            "aggregation-relationship": true,
            "specialization-relationship": true
        };

        /**
         * Finds the current disjoint-set root used to reject cyclic hierarchy links.
         * @param {string} id Model ID of the element.
         * @returns {string} Root ID for the element's set.
         */
        function findRoot(id) {
            if (sets[id] !== id) sets[id] = findRoot(sets[id]);
            return sets[id];
        }

        for (let i = 0; i < elements.length; i++) {
            const id = String(elements[i].id);
            includedIds[id] = true;
            sets[id] = id;
            childrenByParent[id] = [];
        }

        // Only retain source-model links whose endpoints are both included in this view.
        $("relationship").each(function(relationship) {
            try {
                const source = relationship.getSource();
                const target = relationship.getTarget();
                if (!source || !target) return;

                const sourceId = String(source.getId());
                const targetId = String(target.getId());
                if (!includedIds[sourceId] || !includedIds[targetId]) return;

                const type = getTypeName(relationship);
                if (!hierarchyTypes[type]) return;

                const name = getName(relationship).toLowerCase();
                if (generatedRelationshipNames[name]) {
                    skippedLegacyRelationshipCount++;
                    return;
                }

                // Specialization is directed from specific to general, unlike composition
                // and aggregation. Reverse it for the hierarchy layout without changing the
                // source relationship or its direction in the model/view.
                const parentId = type === "specialization-relationship" ? targetId : sourceId;
                const childId = type === "specialization-relationship" ? sourceId : targetId;

                // Keep one parent per child and reject cycles to avoid a tangled layout.
                if (parentByChild[childId]) {
                    omittedRelationshipCount++;
                    return;
                }

                const parentRoot = findRoot(parentId);
                const childRoot = findRoot(childId);
                if (parentRoot === childRoot) {
                    omittedRelationshipCount++;
                    return;
                }

                sets[childRoot] = parentRoot;
                parentByChild[childId] = parentId;
                childrenByParent[parentId].push({
                    id: childId,
                    relationship: relationship,
                    sourceId: sourceId,
                    targetId: targetId
                });
                selectedRelationships.push(relationship);
            } catch (e) {
                logWarn("Could not inspect a relationship while building the capability hierarchy: " + e.message);
            }
        });

        return {
            childrenByParent: childrenByParent,
            parentByChild: parentByChild,
            relationships: selectedRelationships
        };
    }

    /**
     * Calculates a readable forest layout without implying priority or organizational meaning.
     *
     * Measures each tree by leaf span and depth, distributes roots into up to five columns
     * by current column height, and positions children beneath their parent while centering
     * each parent over its descendants. Unrelated elements remain independent roots; the
     * returned coordinates are presentation only.
     * @param {Object[]} elements Elements to position.
     * @param {Object} childrenByParent Hierarchy child lists keyed by parent ID.
     * @param {Object} parentByChild Parent IDs keyed by child ID.
     * @returns {Object<string, {x: number, y: number}>} Diagram coordinates keyed by element ID.
     */
    function layoutHierarchy(elements, childrenByParent, parentByChild) {
        // Reserve the left lane for the CBP workflow; lay out source-model hierarchies to its right.
        const nodeWidth = 170;
        const horizontalGap = 35;
        const verticalGap = 140;
        const columnGap = 90;
        const columnLimit = 5;
        const roots = [];
        const measures = {};
        const columns = [];

        /**
         * Measures the subtree's leaf count and depth to reserve diagram space.
         * @param {string} id Root element ID of the subtree.
         * @returns {{leaves: number, depth: number}} Subtree dimensions.
         */
        function measure(id) {
            const children = childrenByParent[id] || [];
            let leaves = 0;
            let maxDepth = 0;
            for (let i = 0; i < children.length; i++) {
                const childMeasure = measure(children[i].id);
                leaves += childMeasure.leaves;
                maxDepth = Math.max(maxDepth, childMeasure.depth + 1);
            }
            if (leaves === 0) leaves = 1;
            measures[id] = {leaves: leaves, depth: maxDepth};
            return measures[id];
        }

        /**
         * Assigns positions, centering each parent above its descendant span.
         * @param {string} id Element ID being positioned.
         * @param {number} left Left edge reserved for this subtree.
         * @param {number} top Top edge of the hierarchy.
         * @param {number} depth Hierarchy depth.
         * @param {Object} positions Mutable element-ID-to-position map.
         */
        function assignPositions(id, left, top, depth, positions) {
            const children = childrenByParent[id] || [];
            const nodeSpan = measures[id].leaves * (nodeWidth + horizontalGap) - horizontalGap;
            const x = left + Math.max(0, (nodeSpan - nodeWidth) / 2);
            positions[id] = {x: x, y: top + depth * verticalGap};

            let childLeft = left;
            for (let i = 0; i < children.length; i++) {
                const child = children[i];
                assignPositions(child.id, childLeft, top, depth + 1, positions);
                childLeft += measures[child.id].leaves * (nodeWidth + horizontalGap);
            }
        }

        // Elements without an accepted parent become roots of independent trees.
        for (let i = 0; i < elements.length; i++) {
            const id = String(elements[i].id);
            if (!parentByChild[id]) roots.push(id);
        }

        for (let i = 0; i < roots.length; i++) measure(roots[i]);
        const columnCount = Math.min(columnLimit, Math.max(1, roots.length));
        for (let i = 0; i < columnCount; i++) columns.push({height: 0, width: 0, roots: []});

        // Distribute larger trees first into the currently shortest column.
        roots.sort(function(a, b) { return measures[b].leaves - measures[a].leaves; });
        for (let i = 0; i < roots.length; i++) {
            let columnIndex = 0;
            for (let c = 1; c < columns.length; c++) {
                if (columns[c].height < columns[columnIndex].height) columnIndex = c;
            }
            const column = columns[columnIndex];
            column.roots.push(roots[i]);
            column.width = Math.max(
                column.width,
                measures[roots[i]].leaves * (nodeWidth + horizontalGap) - horizontalGap
            );
            column.height += (measures[roots[i]].depth + 1) * verticalGap + verticalGap;
        }

        const positions = {};
        let columnLeft = 450;
        for (let c = 0; c < columns.length; c++) {
            let top = 60;
            for (let i = 0; i < columns[c].roots.length; i++) {
                const root = columns[c].roots[i];
                assignPositions(root, columnLeft, top, 0, positions);
                top += (measures[root].depth + 1) * verticalGap + verticalGap;
            }
            columnLeft += columns[c].width + columnGap;
        }
        return positions;
    }

    /**
     * Finds an existing named view or creates it in the active model.
     * @param {string} name View name.
     * @returns {Object|null} Existing or new ArchiMate view, or null if unavailable.
     */
    function createView(name) {
        const modelRef = activeModel || getCurrentModel();
        if (!modelRef) return null;

        // Reuse the named view so repeated runs rebuild it instead of creating duplicates.
        let existing = null;
        try {
            const allViews = modelRef.getViews ? modelRef.getViews() : null;
            if (allViews && typeof allViews.each === "function") {
                allViews.each(function(view) {
                    if (getName(view) === name) {
                        existing = view;
                        return false;
                    }
                });
            }
        } catch (e) { }

        if (existing) return existing;
        try {
            return modelRef.createArchimateView(name);
        } catch (e) {
            return null;
        }
    }

    /**
     * Adds an ArchiMate concept to a view and indexes its diagram object for later connections.
     * @param {Object} view Target view.
     * @param {Object} element Concept to display.
     * @param {number} x Horizontal position.
     * @param {number} y Vertical position.
     * @param {number} width Diagram-object width.
     * @param {number} height Diagram-object height.
     * @returns {Object|null} Added diagram object, or null if adding fails.
     */
    function addObject(view, element, x, y, width, height) {
        try {
            if (view && view.add && element) {
                const diagramObject = view.add(element, x, y, width, height);
                // Keep the diagram-object references needed to draw model relationships afterward.
                if (diagramObject && element.id) {
                    diagramObjectsByElementId[String(element.id)] = diagramObject;
                }
                return diagramObject;
            }
            return null;
        } catch (e) {
            logWarn("Could not add " + getName(element) + " to the view: " + e.message);
            return null;
        }
    }

    /**
     * Clears diagram objects from a view without deleting their underlying model concepts.
     * @param {Object} view View whose presentation is to be rebuilt.
     */
    function clearView(view) {
        // Delete diagram children only; the underlying model elements and relationships remain intact.
        const children = [];
        $(view).children().each(function(child) {
            children.push(child);
        });
        for (let i = 0; i < children.length; i++) {
            try {
                children[i].delete();
            } catch (e) {
                logWarn("Could not clear an existing diagram object: " + e.message);
            }
        }
    }

    /**
     * Reuses or creates the Business Process concept that represents a CBP methodology move.
     * @param {string} name Method step name.
     * @returns {Object} Existing or newly created method-step concept.
     */
    function findOrCreateMethodStep(name) {
        // Reuse generated stage concepts across runs rather than creating duplicates.
        let existing = null;
        $("business-process").each(function(element) {
            if (!existing && getName(element) === name) existing = element;
        });
        return existing || activeModel.createElement("business-process", name);
    }

    /**
     * Reads a model property as trimmed text.
     * @param {Object} object Model or element holding the property.
     * @param {string} key Property name.
     * @returns {string} Trimmed property value, or an empty string when absent/unavailable.
     */
    function getProperty(object, key) {
        try {
            const value = object.prop(key); // .prop(key) is an accessor method while .prop(key, value) is a mutator one.
            return value === null || value === undefined ? "" : String(value).trim();
        } catch (e) {
            return "";
        }
    }

    /**
     * Writes a model property as a string value.
     * @param {Object} object Model or element to update.
     * @param {string} key Property name.
     * @param {*} value Value to store.
     */
    function setProperty(object, key, value) {
        object.prop(key, String(value));
    }
    /**
     * Reads a numeric model property and validates its range and optional integer constraint.
     * A missing property returns null so callers can report incomplete evidence explicitly.
     * @param {Object} object Model or element holding the property.
     * @param {string} key Property name to read.
     * @param {number} minimum Inclusive minimum accepted value.
     * @param {number} maximum Inclusive maximum accepted value.
     * @param {boolean} integerOnly Whether decimal values are invalid.
     * @returns {number|null} Validated numeric value, or null when the property is missing.
     * @throws {Error} If the value is outside the range or violates the integer constraint.
     */
    function parseScore(object, key, minimum, maximum, integerOnly) {
        const raw = getProperty(object, key);
        if (raw === "") return null;
        const value = Number(raw);
        if (isNaN(value) || value < minimum || value > maximum) {
            throw new Error(key + " must be between " + minimum + " and " + maximum + ".");
        }
        if (integerOnly && Math.floor(value) !== value) {
            throw new Error(key + " must be an integer.");
        }
        return value;
    }

    /**
     * Reads and validates the model's consecutive annual planning increments.
     * @returns {string[]} Sorted four-digit increment years.
     * @throws {Error} If years are malformed, duplicated, or nonconsecutive.
     */
    function getIncrements() {
        const raw = getProperty(activeModel, "CBP.Increments");
        if (!raw) return [];
        const parts = raw.split(",");
        const years = [];
        const seen = {};
        for (let i = 0; i < parts.length; i++) {
            const year = parts[i].trim();
            if (!/^\d{4}$/.test(year)) {
                throw new Error("CBP.Increments must be a comma-separated list of four-digit years.");
            }
            if (seen[year]) {
                throw new Error("CBP.Increments contains duplicate year " + year + ".");
            }
            seen[year] = true;
            years.push(year);
        }
        years.sort();
        for (let i = 1; i < years.length; i++) {
            if (Number(years[i]) !== Number(years[i - 1]) + 1) {
                throw new Error(
                    "CBP.Increments must be consecutive years; each planning increment is one year."
                );
            }
        }
        return years;
    }

    /**
     * Finds strategy concepts explicitly tagged for CBP strategic-importance scoring.
     *
     * Element type or name alone is not treated as evidence of strategic intent.
     * @returns {Object[]} Strategy elements with validated weights.
     * @throws {Error} If an explicitly supplied strategy weight is invalid.
     */
    function discoverStrategies() {
        const strategies = [];
        const seen = {};
        const strategyTypes = ["driver", "goal", "requirement", "course-of-action"];
        for (let i = 0; i < strategyTypes.length; i++) {
            $(strategyTypes[i]).each(function(element) {
                const id = String(element.id);
                if (seen[id] || getProperty(element, "CBP.Role").toLowerCase() !== "strategy") return;
                seen[id] = true;
                let weight = 1;
                const rawWeight = getProperty(element, "CBP.StrategyWeight");
                if (rawWeight !== "") {
                    weight = Number(rawWeight);
                    if (isNaN(weight) || !isFinite(weight) || weight <= 0) {
                        throw new Error(
                            "Strategy '" + getName(element) +
                            "' has invalid CBP.StrategyWeight; use a number greater than zero."
                        );
                    }
                }
                strategies.push({element: element, id: id, weight: weight});
            });
        }
        return strategies;
    }

    /**
     * Calculates one capability's maturity, strategic importance, goals, and improvement actions.
     *
     * Generated candidates are scored provisionally while retaining their review status.
     * Stale derived properties are cleared; maturity is the weighted mean of
     * all three dimension ratings, and strategic importance is the weighted mean of every
     * declared strategy impact normalized to 0-4. Exact scores determine the ML-SI zone using
     * the configured tolerance. Each increment is checked for complete, consistent targets,
     * monotonic progression, and final alignment with strategic importance. Valid targets
     * generate Goals; actual dimension increases additionally require explicit action text,
     * project assignment, and priority. Missing or invalid evidence blocks dependent results
     * instead of being guessed.
     * @param {Object} capability Capability being assessed.
     * @param {Object[]} strategies Validated strategy elements and weights.
     * @param {string[]} increments Consecutive planning years.
     * @param {number} tolerance Acceptance-band tolerance for the ML-SI comparison.
     * @returns {{
     *   capability: Object,
     *   errors: string[],
     *   actions: Array<{capability: Object, year: string, dimension: string, start: number, target: number,
     *     description: string, projectName: string, priority: number}>,
     *   goals: Array<Object>,
     *   maturity: number|null,
     *   importance: number|null,
     *   zone: string,
     *   gap: number|null
     * }} Assessment results. A null score/gap indicates incomplete evidence; actions and Goals
     *   contain only validated planning inputs.
     */
    function calculateCapability(capability, strategies, increments, tolerance) {
        // Derived scores are refreshed each run so stale results cannot survive changed or missing inputs.
        const oldResultProperties = [
            "CBP.Result.Maturity",
            "CBP.Result.StrategicImportance",
            "CBP.Result.Zone",
            "CBP.Result.Gap"
        ];
        for (let p = 0; p < oldResultProperties.length; p++) {
            try {
                capability.removeProp(oldResultProperties[p]);
            } catch (e) {
                logWarn(
                    "Could not clear prior derived property " + oldResultProperties[p] +
                    " on " + getName(capability) + ": " + e.message
                );
            }
        }
        const result = {
            capability: capability,
            errors: [],
            actions: [],
            goals: [],
            maturity: null,
            importance: null,
            zone: "Not assessed",
            gap: null
        };
        if (increments.length === 0) {
            result.errors.push(
                "Model property CBP.Increments is missing; improvement goals, actions, and projects were not generated."
            );
        }
        const dimensionScores = {};
        const dimensionWeights = {};
        let weightedMaturity = 0;
        let totalMaturityWeight = 0;

        // Move 2: calculate the weighted current maturity only when all three dimension ratings exist.
        // The calculated value is written to the Capability’s CBP.Result.Maturity model property, formatted to two
        // decimal places. Then rebuild the Maturity Heatmap view, placing each scored Capability in the nearest
        // integer band from 0 to 4. The cards show the exact score, and their colors run from reddish at low mturity
        // to green at high maturity.
        for (let i = 0; i < dimensions.length; i++) {
            const dimension = dimensions[i];
            const ratingKey = "CBP.Maturity." + dimension;
            const weightKey = "CBP.Weight." + dimension;
            try {
                const rating = parseScore(capability, ratingKey, 0, 4, true);
                if (rating === null) {
                    result.errors.push(ratingKey + " is missing.");
                    continue;
                }
                let weight = 1;
                const rawWeight = getProperty(capability, weightKey);
                if (rawWeight !== "") {
                    weight = Number(rawWeight);
                    if (isNaN(weight) || !isFinite(weight) || weight <= 0) {
                        result.errors.push(weightKey + " must be greater than zero.");
                        continue;
                    }
                }
                dimensionScores[dimension] = rating;
                dimensionWeights[dimension] = weight;
                weightedMaturity += rating * weight;
                totalMaturityWeight += weight;
            } catch (e) {
                result.errors.push(e.message);
            }
        }
        // A complete weighted mean is comparable only when all three assessed dimensions are present.
        if (totalMaturityWeight > 0 && Object.keys(dimensionScores).length === dimensions.length) {
            result.maturity = weightedMaturity / totalMaturityWeight;
            setProperty(capability, "CBP.Result.Maturity", result.maturity.toFixed(2));
        }
        const currentMaturityComplete = result.maturity !== null;

        // Move 3: weight every declared strategy impact, then normalize the result to the paper's 0-4 scale.
        if (strategies.length === 0) {
            result.errors.push("No strategy elements are marked CBP.Role=Strategy.");
        } else {
            let weightedImpact = 0;
            let totalStrategyWeight = 0;
            let completeImpactData = true;
            for (let i = 0; i < strategies.length; i++) {
                const strategy = strategies[i];
                const key = "CBP.Impact." + String(capability.id);
                try {
                    const score = parseScore(strategy.element, key, 0, 2, true);
                    if (score === null) {
                        result.errors.push(
                            key + " is missing on strategy '" + getName(strategy.element) + "'."
                        );
                        completeImpactData = false;
                    } else {
                        weightedImpact += score * strategy.weight;
                        totalStrategyWeight += strategy.weight;
                    }
                } catch (e) {
                    result.errors.push(e.message);
                    completeImpactData = false;
                }
            }
            // Normalize the weighted 0-2 impact scale to 0-4; every declared strategy must be scored,
            // otherwise omitting it would bias the capability's strategic-importance ranking.
            if (completeImpactData && totalStrategyWeight > 0) {
                result.importance = (weightedImpact / (2 * totalStrategyWeight)) * 4;
                setProperty(capability, "CBP.Result.StrategicImportance", result.importance.toFixed(2));
            }
        }

        // Move 4: compare assessed maturity and strategic importance to classify the capability's matrix zone.
        if (result.maturity !== null && result.importance !== null) {
            result.gap = result.importance - result.maturity;
            if (result.gap > tolerance) result.zone = "Gap";
            else if (result.gap < -tolerance) result.zone = "Comfort";
            else result.zone = "Acceptance";
            setProperty(capability, "CBP.Result.Zone", result.zone);
            setProperty(capability, "CBP.Result.Gap", result.gap.toFixed(2));
        }

        // Each increment starts from the prior assessed/target state, making action derivation traceable
        // to an explicit dimension-level maturity transition rather than a generic template.
        const previousDimensions = {};
        for (let i = 0; i < dimensions.length; i++) {
            previousDimensions[dimensions[i]] = dimensionScores[dimensions[i]];
        }

        /**
         * Move 5 validates each annual target against the dimension targets and the strategy-led acceptance band.
         *
         * For each configured year, this loop checks overall and dimension-level scores, verifies progression
         * and weighted-score consistency, and records only valid goals and improvement actions for later moves.
         * Missing or inconsistent inputs are reported in the capability result rather than inferred.
         */
        for (let y = 0; y < increments.length; y++) {
            const year = increments[y];
            const target = {year: year, dimensions: {}, actions: [], progressionValid: true};
            if (!currentMaturityComplete || result.importance === null) {
                result.errors.push(
                    "Move 5-7 require complete current maturity and strategic-importance assessments."
                );
                target.progressionValid = false;
            }
            const targetKey = "CBP.TargetML." + year;
            try {
                target.overall = parseScore(capability, targetKey, 0, 4, false);
                if (target.overall === null) {
                    result.errors.push(targetKey + " is missing.");
                }
            } catch (e) {
                result.errors.push(e.message);
            }

            let weightedTarget = 0;
            let totalTargetWeight = 0;
            let dimensionTargetsComplete = true;
            for (let d = 0; d < dimensions.length; d++) {
                const dimension = dimensions[d];
                const dimensionKey = "CBP.Target." + dimension + "." + year;
                const actionKey = "CBP.Action." + dimension + "." + year;
                const projectKey = "CBP.Project." + dimension + "." + year;
                const priorityKey = "CBP.ProjectPriority." + dimension + "." + year;
                let destination = null;
                try {
                    destination = parseScore(capability, dimensionKey, 0, 4, true);
                    if (destination === null) {
                        result.errors.push(dimensionKey + " is missing.");
                        dimensionTargetsComplete = false;
                        continue;
                    }
                } catch (e) {
                    result.errors.push(e.message);
                    dimensionTargetsComplete = false;
                    continue;
                }
                target.dimensions[dimension] = destination;
                const start = previousDimensions[dimension];
                if (start !== undefined && destination < start) {
                    result.errors.push(dimensionKey + " cannot be lower than the previous dimension target.");
                    target.progressionValid = false;
                }
                weightedTarget += destination * (dimensionWeights[dimension] || 1);
                totalTargetWeight += dimensionWeights[dimension] || 1;

                // Move 6 starts only for an actual maturity increase; unchanged dimensions do not create
                // improvement work. Require an architect-supplied action and portfolio placement.
                if (start !== undefined && destination > start) {
                    const description = getProperty(capability, actionKey);
                    const projectName = getProperty(capability, projectKey);
                    let priority = null;
                    try {
                        priority = parseScore(capability, priorityKey, 1, 999, true);
                    } catch (e) {
                        result.errors.push(e.message);
                    }
                    if (!description) result.errors.push(actionKey + " is required when the dimension target improves.");
                    if (!projectName) result.errors.push(projectKey + " is required for each improvement action.");
                    if (priority === null) result.errors.push(priorityKey + " is required (integer 1-999).");
                    if (description && projectName && priority !== null) {
                        // Keep the full planning trace in the action record until this year's target
                        // passes aggregate and progression validation below.
                        const action = {
                            capability: capability,
                            year: year,
                            dimension: dimension,
                            start: start,
                            target: destination,
                            description: description,
                            projectName: projectName,
                            priority: priority
                        };
                        target.actions.push(action);
                    }
                }
            }

            if (target.overall !== null && dimensionTargetsComplete && totalTargetWeight > 0) {
                const calculatedTarget = weightedTarget / totalTargetWeight;
                if (Math.abs(target.overall - calculatedTarget) > 0.01) {
                    result.errors.push(
                        targetKey + " does not match the weighted mean (" +
                        calculatedTarget.toFixed(2) + ") of this increment's dimension targets."
                    );
                } else {
                    target.dimensionsMatchOverall = true;
                }
            }
            if (y === increments.length - 1 && target.overall !== null &&
                result.importance !== null && target.overall + tolerance < result.importance) {
                result.errors.push(
                    targetKey + " remains below strategic importance and outside the acceptance band."
                );
                target.progressionValid = false;
            }
            // Do not publish downstream actions/goals if the aggregate and dimension targets disagree
            // or the proposed trajectory violates the planning checks above.
            if (target.dimensionsMatchOverall && target.progressionValid) {
                // Only validated increment actions flow to Move 6 portfolio generation.
                for (let a = 0; a < target.actions.length; a++) {
                    result.actions.push(target.actions[a]);
                }
            }
            if (target.overall !== null && target.dimensionsMatchOverall && target.progressionValid &&
                currentMaturityComplete && result.importance !== null) {
                target.goal = findOrCreateGeneratedElement(
                    "goal",
                    "CBP Goal - " + getName(capability) + " - " + year,
                    "Increment: " + year +
                        "\nOverall target maturity: " + target.overall.toFixed(2) +
                        "\nPeople target: " + target.dimensions.People +
                        "\nProcess target: " + target.dimensions.Process +
                        "\nTechnology target: " + target.dimensions.Technology +
                        "\nCurrent status: " + result.zone +
                        "\nStrategy importance: " + result.importance.toFixed(2) + ".",
                    String(capability.id)
                );
                result.goals.push(target);
            }
            // Advance the baseline only after this increment's targets pass validation.
            if (target.dimensionsMatchOverall && target.progressionValid) {
                for (let d = 0; d < dimensions.length; d++) {
                    const dimension = dimensions[d];
                    previousDimensions[dimension] = target.dimensions[dimension];
                }
            }
        }

        return result;
    }

    /**
     * Reuses or creates a script-owned generated concept, updating its documentation on reruns.
     * Provenance prevents similarly named user-authored concepts from being claimed.
     * @param {string} type ArchiMate concept type.
     * @param {string} name Generated concept name.
     * @param {string} documentation Generated concept documentation.
     * @param {string} sourceId Optional source capability ID.
     * @returns {Object} Existing or newly created generated concept.
     */
    function findOrCreateGeneratedElement(type, name, documentation, sourceId) {
        let existing = null;
        $(type).each(function(element) {
            if (getName(element) === name &&
                getProperty(element, "CBP.GeneratedBy") === "Capability-based Planning View" &&
                (!sourceId || getProperty(element, "CBP.SourceID") === sourceId)) {
                existing = element;
            }
        });
        if (existing) {
            existing.documentation = documentation;
            return existing;
        }
        const created = activeModel.createElement(type, name);
        created.documentation = documentation;
        setProperty(created, "CBP.GeneratedBy", "Capability-based Planning View");
        if (sourceId) setProperty(created, "CBP.SourceID", sourceId);
        return created;
    }

    /**
     * Reuses or creates a model relationship with the requested type and endpoints.
     * Model relationships are shared across views, avoiding duplicate semantic links.
     * @param {string} type ArchiMate relationship type.
     * @param {string} name Relationship name.
     * @param {Object} source Source concept.
     * @param {Object} target Target concept.
     * @returns {Object} Existing or newly created model relationship.
     */
    function ensureModelRelationship(type, name, source, target) {
        let existing = null;
        $("relationship").each(function(relationship) {
            if (existing || getTypeName(relationship) !== type) return;
            const from = relationship.getSource();
            const to = relationship.getTarget();
            if (from && to && String(from.getId()) === String(source.id) &&
                String(to.getId()) === String(target.id)) {
                existing = relationship;
            }
        });
        return existing || activeModel.createRelationship(type, name, source, target);
    }

    /**
     * Adds a visible view connection after validating its model and diagram endpoints.
     * @param {Object} view View receiving the connection.
     * @param {string} type ArchiMate relationship type.
     * @param {string} name Relationship name.
     * @param {Object} source Source model concept.
     * @param {Object} target Target model concept.
     * @param {Object} sourceObject Source diagram object in the view.
     * @param {Object} targetObject Target diagram object in the view.
     * @returns {Object} Created diagram connection.
     * @throws {Error} If diagram objects are missing or relationship endpoints mismatch.
     */
    function addModelConnection(view, type, name, source, target, sourceObject, targetObject) {
        if (!sourceObject || !targetObject) {
            throw new Error("Cannot draw '" + name + "': one or both endpoint objects are missing from the view.");
        }
        const relationship = ensureModelRelationship(type, name, source, target);
        const relationshipSource = relationship.getSource();
        const relationshipTarget = relationship.getTarget();
        if (!relationshipSource || !relationshipTarget ||
            String(relationshipSource.getId()) !== String(source.id) ||
            String(relationshipTarget.getId()) !== String(target.id)) {
            throw new Error("Relationship endpoints do not match the diagram objects for '" + name + "'.");
        }
        const connection = view.add(relationship, sourceObject, targetObject);
        const viewName = getName(view);
        diagramConnectionCounts[viewName] = (diagramConnectionCounts[viewName] || 0) + 1;
        return connection;
    }

    /**
     * Creates or reuses a generated Business Object and adds it to a view as an information card.
     * @param {Object} view Target view.
     * @param {string} name Card concept name.
     * @param {string} documentation Explanatory content stored on the generated concept.
     * @param {number} x Horizontal position.
     * @param {number} y Vertical position.
     * @param {number} width Diagram-object width.
     * @param {number} height Diagram-object height.
     * @param {string} [sourceId] Optional capability ID associated with the card.
     * @returns {Object|null} Added diagram object, or null if the view insertion fails.
     */
    function addGeneratedCard(view, name, documentation, x, y, width, height, sourceId) {
        const card = findOrCreateGeneratedElement("business-object", name, documentation, sourceId);
        return addObject(view, card, x, y, width, height);
    }

    /**
     * Clears cached diagram-object references before rebuilding a view.
     */
    function resetDiagramObjectIndex() {
        for (const id in diagramObjectsByElementId) {
            if (Object.prototype.hasOwnProperty.call(diagramObjectsByElementId, id)) {
                delete diagramObjectsByElementId[id];
            }
        }
    }
    /**
     * Converts a score to its nearest display band, bounded to the 0–4 scale.
     * The underlying calculated value is not changed.
     * @param {number} value Exact calculated score.
     * @returns {number} Integer display bucket from 0 through 4.
     */
    function scoreBucket(value) {
        return Math.max(0, Math.min(4, Math.round(value)));
    }

    /**
     * Builds the Move 1 view of capabilities, profile evidence, and candidate review status.
     *
     * Rebuilds the named view with each Capability beside a generated profile card and an
     * Association link between them. Cards display the user-supplied profile properties,
     * identify missing values, and show candidate provenance/status when applicable.
     * Profile information is presented as supplied; it is not inferred from related elements.
     * @param {Object[]} capabilities Capabilities included in the planning scope.
     * @returns {Object} Created or rebuilt profile view.
     */
    function drawCapabilityProfilesView(capabilities) {
        const name = "CBP - Capability Map and Profiles";
        const view = createView(name);
        if (!view) throw new Error("Could not create view '" + name + "'.");
        view.documentation =
            "CBP Move 1: shows explicitly modeled capabilities with their user-supplied profile information. " +
            "Candidates generated from business functions/processes/services are marked ReviewRequired and assessed " +
            "provisionally. Validate candidates and their assessments before relying on results. The script does not " +
            "infer capabilities from source documents; profile sources and content must be researched and entered on " +
            "each Capability as CBP.Profile.* properties.";
        clearView(view);
        resetDiagramObjectIndex();

        const profileFields = [
            ["Source", "Sources"],
            ["Definition", "Definition"],
            ["BusinessUnits", "Related business units"],
            ["Processes", "Related processes"],
            ["Applications", "Related application components"],
            ["StrategicElements", "Related strategic elements"],
            ["Measures", "Measures"]
        ];
        for (let i = 0; i < capabilities.length; i++) {
            const capability = capabilities[i];
            const y = 80 + (i * 150);
            const capabilityObject = addObject(view, capability, 60, y, 250, 80);
            const candidateStatus = getProperty(capability, "CBP.CandidateStatus");
            let profile = "";
            if (candidateStatus) {
                profile += "Candidate status: " + candidateStatus +
                    "\nSource: " + getProperty(capability, "CBP.Candidate.SourceType") +
                    " - " + getProperty(capability, "CBP.Candidate.SourceName") +
                    "\nAssessment is provisional until this candidate is reviewed and approved.\n";
            }
            for (let f = 0; f < profileFields.length; f++) {
                const field = profileFields[f];
                const value = getProperty(capability, "CBP.Profile." + field[0]);
                profile += field[1] + ": " + (value || "MISSING") + "\n";
            }
            const profileObject = addGeneratedCard(
                view,
                "[CBP] Profile - " + getName(capability),
                profile,
                360,
                y,
                500,
                110,
                String(capability.id)
            );
            try {
                addModelConnection(
                    view,
                    "association-relationship",
                    "Profile documents capability",
                    profileObject.concept,
                    capability,
                    profileObject,
                    capabilityObject
                );
            } catch (e) {
                logWarn("Could not connect the profile to " + getName(capability) + ": " + e.message);
            }
        }
        return view;
    }

    /**
     * Applies a fill color to a diagram object when supported by the active jArchi runtime.
     * @param {Object} diagramObject Diagram object to color.
     * @param {string} color Hexadecimal color string.
     */
    function setDiagramColor(diagramObject, color) {
        if (diagramObject && typeof diagramObject.setFillColor === "function") {
            try {
                diagramObject.setFillColor(color);
            } catch (e) {
                logWarn("Could not set a heatmap fill color: " + e.message);
            }
        }
    }

    /**
     * Builds a maturity or strategic-importance heatmap with a colored 0–4 legend.
     *
     * It first creates or gets the named view, documents how to interpret its scores, and clears its previous contents.
     * Then it chooses the appropriate five-color palette and adds colored score-band legend cards for 0–4.<br/>
     * For each result with a valid score, it rounds the score to the nearest band using scoreBucket(), places a colored
     * card in that band’s column, and includes the exact calculated value in the card documentation. It also adds the
     * Capability beneath the card and draws an association between them. Results without a score are shown separately
     * with an “INPUT REQUIRED” card listing the relevant validation or missing-input messages. The parameters control
     * which view is built: name and title identify it; resultProperty selects the score (for example, maturity or
     * importance); scoreDescription supplies card details; results contains the capability assessments; and
     * reverseColors selects the strategic-importance palette.<br/>
     * Scores use rounded display bands, while exact values remain in card documentation.
     * Missing scores are shown with input-required cards rather than being imputed.
     * @param {string} name Name of the Archi view to create or rebuild.
     * @param {string} title Human-readable measure title used in the view.
     * @param {string} resultProperty Assessment result field to plot.
     * @param {Function} scoreDescription Returns explanatory text for a result card.
     * @param {Object[]} results Capability assessment results to display.
     * @param {boolean} reverseColors Whether to use the strategic-importance palette.
     * @returns {Object} Created or rebuilt heatmap view.
     */
    function drawScoreView(name, title, resultProperty, scoreDescription, results, reverseColors) {
        const view = createView(name);
        if (!view) throw new Error("Could not create view '" + name + "'.");
        view.documentation = title + ". Values are calculated only from explicit CBP model properties. " +
            "Scores are shown in the nearest integer band; exact scores remain in each card's documentation. " +
            "The colored column headers are an absolute 0-4 score legend, not a relative ranking.";
        clearView(view);
        resetDiagramObjectIndex();

        const measureLabel = reverseColors ? "Strategic importance" : "Maturity";
        const scoreColors = reverseColors
            ? ["#B6D7A8", "#D9EAD3", "#FFF2CC", "#FCE5CD", "#F4CCCC"]
            : ["#F4CCCC", "#FCE5CD", "#FFF2CC", "#D9EAD3", "#B6D7A8"];
        const cardCounts = [0, 0, 0, 0, 0];
        for (let score = 0; score <= 4; score++) {
            let meaning = measureLabel + " " + score;
            if (score === 0) meaning += " - lowest";
            else if (score === 4) meaning += " - highest";
            const legendCard = addGeneratedCard(
                view,
                "[CBP] Legend - " + meaning,
                title + " score band " + score + " (0-4 scale). " + meaning +
                    ". This is an absolute score band, not a relative rank.",
                60 + (score * 235),
                60,
                210,
                60
            );
            setDiagramColor(legendCard, scoreColors[score]);
        }

        for (let i = 0; i < results.length; i++) {
            const result = results[i];
            const value = result[resultProperty];
            if (value === null || value === undefined) continue;
            const band = scoreBucket(value);
            const y = 150 + (cardCounts[band] * 95);
            cardCounts[band]++;
            const details = scoreDescription(result);
            const scoreCard = addGeneratedCard(
                view,
                "[CBP] " + title + " - " + getName(result.capability),
                details + "\nExact calculated score: " + value.toFixed(2) + ".",
                60 + (band * 235),
                y,
                210,
                75,
                String(result.capability.id)
            );
            setDiagramColor(scoreCard, scoreColors[band]);
            const capabilityObject = addObject(
                view,
                result.capability,
                60 + (band * 235),
                y + 77,
                210,
                55
            );
            try {
                addModelConnection(
                    view,
                    "association-relationship",
                    "Capability classified in " + title + " band " + band,
                    scoreCard.concept,
                    result.capability,
                    scoreCard,
                    capabilityObject
                );
            } catch (e) {
                logWarn("Could not connect heatmap entry for " + getName(result.capability) + ": " + e.message);
            }
        }

        let missingY = 150;
        for (let i = 0; i < results.length; i++) {
            const result = results[i];
            if (result[resultProperty] !== null && result[resultProperty] !== undefined) continue;
            const missingCard = addGeneratedCard(
                view,
                "[CBP] " + title + " INPUT REQUIRED - " + getName(result.capability),
                result.errors.join("\n"),
                60 + (5 * 235),
                missingY,
                360,
                90,
                String(result.capability.id)
            );
            const capabilityObject = addObject(
                view,
                result.capability,
                60 + (5 * 235),
                missingY + 92,
                210,
                55
            );
            try {
                addModelConnection(
                    view,
                    "association-relationship",
                    "Assessment inputs missing for capability",
                    missingCard.concept,
                    result.capability,
                    missingCard,
                    capabilityObject
                );
            } catch (e) {
                logWarn("Could not connect missing-input card for " + getName(result.capability) + ": " + e.message);
            }
            missingY += 110;
        }
        return view;
    }

    /**
     * Builds the Move 4 ML-SI matrix and the Move 5 improvement-goal presentation.
     * Matrix placement uses rounded cells; acceptance-zone comparisons use exact scores.
     * drawMatrixAndGoalsView(results, increments) creates the “CBP - ML-SI Matrix and Improvement Goals” view. It
     * combines two outputs: the Move 4 comparison of maturity and strategic importance, and the Move 5 display of valid
     * target Goals. <ul>
     * <li> Sets up the view: creates or reuses the named view, writes explanatory documentation, and clears its previous
     *   diagram objects.</li>
     * <li> Labels the axes: adds maturity levels 0–4 across the top (horizontal axis) and strategic-importance levels 0–4
     *   down the left (vertical axis).</li>
     * <li> Plots assessed capabilities: skips results without either score. For the rest, it rounds each score to the
     *   nearest integer cell and places the Capability there. The accompanying details card gives the exact maturity,
     *   importance, classification zone, and SI - ML gap. The Capability’s fill color shows its zone: red for Gap
     *   (importance exceeds maturity beyond tolerance), green for Comfort (maturity exceeds importance beyond
     *   tolerance), and yellow for Acceptance.</li>
     * <li> Shows improvement goals: gathers valid Goals created from the capability’s target properties, places them below
     *   the matrix, and draws an Influence relationship from each Capability to its Goal.</li>
     * <li> Reports incomplete inputs: displays a status card and the Capability for results that lack a complete
     *   assessment or valid goals, including the relevant input errors.</li><br/>
     * The increments argument helps determine whether a fully assessed capability with no Goals should be treated as
     * incomplete. The placement rounds scores for readability, but zone classification uses the exact scores.
     * @param {Object[]} results Capability assessment results.
     * @param {string[]} increments Configured planning years.
     * @returns {Object} Created or rebuilt matrix-and-goals view.
     */
    function drawMatrixAndGoalsView(results, increments) {
        const name = analysisViewNames.matrix;
        const view = createView(name);
        if (!view) throw new Error("Could not create view '" + name + "'.");
        view.documentation =
            "CBP Move 4: capabilities are positioned by maturity (horizontal, 0-4) and strategic importance " +
            "(vertical, 0-4). Gap means strategic importance exceeds maturity beyond CBP.AcceptanceTolerance; " +
            "Comfort means maturity exceeds importance beyond that tolerance; otherwise the point is in the " +
            "acceptance band. Move 5 target goals are listed below the matrix for each configured increment.";
        clearView(view);
        resetDiagramObjectIndex();

        for (let score = 0; score <= 4; score++) {
            addGeneratedCard(
                view,
                "[CBP] ML-SI maturity axis " + score,
                "Maturity level " + score,
                190 + (score * 220),
                55,
                190,
                45
            );
            addGeneratedCard(
                view,
                "[CBP] ML-SI importance axis " + score,
                "Strategic importance " + score,
                40,
                125 + ((4 - score) * 220),
                130,
                55
            );
        }

        const cellCounts = {};
        for (let i = 0; i < results.length; i++) {
            const result = results[i];
            if (result.maturity === null || result.importance === null) continue;
            const ml = scoreBucket(result.maturity);
            const si = scoreBucket(result.importance);
            const cell = ml + ":" + si;
            const offset = cellCounts[cell] || 0;
            cellCounts[cell] = offset + 1;
            const x = 190 + (ml * 220);
            const y = 125 + ((4 - si) * 220) + (offset * 110);
            const capabilityObject = addObject(
                view,
                result.capability,
                x,
                y,
                180,
                65
            );
            setDiagramColor(
                capabilityObject,
                result.zone === "Gap" ? "#F4CCCC" :
                    (result.zone === "Comfort" ? "#D9EAD3" : "#FFF2CC")
            );
            diagramObjectsByElementId[String(result.capability.id)] = capabilityObject;
            const detailsObject = addGeneratedCard(
                view,
                "[CBP] ML-SI details - " + getName(result.capability),
                "Maturity: " + result.maturity.toFixed(2) +
                    "\nStrategic importance: " + result.importance.toFixed(2) +
                    "\nZone: " + result.zone +
                    "\nGap (SI - ML): " + result.gap.toFixed(2),
                x,
                y + 67,
                180,
                45,
                String(result.capability.id)
            );
            try {
                addModelConnection(
                    view,
                    "association-relationship",
                    "ML-SI assessment for capability",
                    detailsObject.concept,
                    result.capability,
                    detailsObject,
                    capabilityObject
                );
            } catch (e) {
                logWarn("Could not connect ML-SI details for " + getName(result.capability) + ": " + e.message);
            }
        }

        const goalRows = [];
        for (let i = 0; i < results.length; i++) {
            const result = results[i];
            for (let g = 0; g < result.goals.length; g++) {
                goalRows.push({result: result, target: result.goals[g]});
            }
        }
        addGeneratedCard(
            view,
            "[CBP] Move 5 - Incremental improvement goals",
            "Each goal is derived from CBP.TargetML.<year> and the corresponding dimension targets on its capability.",
            60,
            1300,
            600,
            55
        );
        // A Goal is the desired state; Influence (Capability -> Goal) expresses that the capability
        // contributes to achieving it without misrepresenting the goal as a current-state fact.
        for (let i = 0; i < goalRows.length; i++) {
            const row = goalRows[i];
            const goal = row.target.goal;
            const goalObject = addObject(view, goal, 60, 1380 + (i * 95), 260, 70);
            const capabilityObject = diagramObjectsByElementId[String(row.result.capability.id)];
            if (capabilityObject && goalObject) {
                try {
                    addModelConnection(
                        view,
                        "influence-relationship",
                        "Capability maturity target " + row.target.year,
                        row.result.capability,
                        goal,
                        capabilityObject,
                        goalObject
                    );
                } catch (e) {
                    logWarn("Could not draw target goal for " + getName(row.result.capability) + ": " + e.message);
                }
            }
        }
        let statusY = 1380 + (goalRows.length * 95);
        for (let i = 0; i < results.length; i++) {
            const result = results[i];
            if (result.maturity !== null && result.importance !== null &&
                (result.goals.length > 0 || increments.length === 0)) continue;
            const statusCard = addGeneratedCard(
                view,
                "[CBP] Move 4-5 inputs incomplete - " + getName(result.capability),
                result.errors.join("\n") || "Add valid maturity, strategic-importance, and increment target inputs.",
                60,
                statusY,
                650,
                75,
                String(result.capability.id)
            );
            const capabilityObject = addObject(
                view,
                result.capability,
                730,
                statusY,
                250,
                65
            );
            try {
                addModelConnection(
                    view,
                    "association-relationship",
                    "Assessment status for capability",
                    statusCard.concept,
                    result.capability,
                    statusCard,
                    capabilityObject
                );
            } catch (e) {
                logWarn("Could not connect assessment status for " + getName(result.capability) + ": " + e.message);
            }
            statusY += 85;
        }
        return view;
    }

    /**
     * Implements Move 6 and prepares the prioritized Move 7 project portfolio.
     *
     * Materializes only validated dimension transitions as action Work Packages, retaining
     * the Capability, dimension, increment, start/target levels, and supplied description.
     * Actions are grouped by increment and supplied project name, so same-named projects in
     * different increments remain distinct. Conflicting priorities within one group are
     * reported and the conflicting action is excluded. Each accepted action realizes its
     * Capability, and its project contains it through composition; existing endpoint-
     * identical relationships are reused on reruns. Projects are ordered by increment,
     * declared numeric priority (lower first), then project name.
     * @param {Object[]} results Capability assessment results containing generated actions.
     * @returns {{
     *   projects: Array<{year: string, name: string, priority: number, element: Object,
     *     actions: Array<{input: Object, element: Object}>}>,
     *   actions: Array<{input: Object, element: Object, project: Object}>,
     *   errors: string[]
     * }} Ordered project packages, generated action records, and conflicting-priority diagnostics.
     */
    function buildPortfolio(results) {
        const projects = {};
        const actions = [];
        const errors = [];
        // Materialize only the validated Move 6 action records collected during target assessment.
        for (let i = 0; i < results.length; i++) {
            const result = results[i];
            for (let a = 0; a < result.actions.length; a++) {
                const action = result.actions[a];
                const key = action.year + "|" + action.projectName;
                if (!projects[key]) {
                    projects[key] = {
                        year: action.year,
                        name: action.projectName,
                        priority: action.priority,
                        actions: []
                    };
                } else if (projects[key].priority !== action.priority) {
                    // Conflicting priorities for one project make the portfolio order ambiguous;
                    // surface the conflict instead of selecting a convenient value.
                    errors.push(
                        "Project '" + action.projectName + "' in " + action.year +
                        " has conflicting priorities " + projects[key].priority + " and " + action.priority + "."
                    );
                    continue;
                }
                const actionName =
                    "CBP Action - " + action.year + " - " + getName(action.capability) + " - " + action.dimension;
                // The description states the planned change; properties preserve structured traceability
                // for filtering and later governance across Capability, dimension, and increment.
                const actionElement = findOrCreateGeneratedElement(
                    "work-package",
                    actionName,
                    action.description + "\nDimension transition: " + action.start + " to " + action.target + ".",
                    String(action.capability.id)
                );
                setProperty(actionElement, "CBP.Increment", action.year);
                setProperty(actionElement, "CBP.Dimension", action.dimension);
                setProperty(actionElement, "CBP.StartLevel", action.start);
                setProperty(actionElement, "CBP.TargetLevel", action.target);
                const project = projects[key];
                // Move 7 package concepts are created here because action-to-project assignment is a
                // planning input, not something inferred from the capability architecture.
                const projectElement = findOrCreateGeneratedElement(
                    "work-package",
                    "CBP Project - " + action.year + " - " + action.projectName,
                    "Portfolio project/package for increment " + action.year +
                        ". Priority: " + action.priority + "."
                );
                setProperty(projectElement, "CBP.Increment", action.year);
                setProperty(projectElement, "CBP.Priority", action.priority);
                project.element = projectElement;
                project.actions.push({input: action, element: actionElement});
                actions.push({input: action, element: actionElement, project: projectElement});
                // These are model relationships: the action realizes an intended capability change,
                // while composition records that the project package contains the action.
                ensureModelRelationship(
                    "realization-relationship",
                    "Implements capability improvement",
                    actionElement,
                    action.capability
                );
                ensureModelRelationship(
                    "composition-relationship",
                    "Portfolio project contains improvement action",
                    projectElement,
                    actionElement
                );
            }
        }
        const orderedProjects = [];
        for (const key in projects) {
            if (Object.prototype.hasOwnProperty.call(projects, key)) orderedProjects.push(projects[key]);
        }
        // Priority is a planning input, not a calculated business value; lower declared numbers sort first.
        orderedProjects.sort(function(a, b) {
            if (a.year !== b.year) return a.year < b.year ? -1 : 1;
            if (a.priority !== b.priority) return a.priority - b.priority;
            return a.name.localeCompare(b.name);
        });
        return {projects: orderedProjects, actions: actions, errors: errors};
    }

    /**
     * Presents the Move 6 Work Packages and their Move 7 prioritized project packages.
     *
     * Rebuilds the portfolio view with each project, its action Work Packages, and the
     * affected Capabilities. Composition shows project membership; realization traces each
     * action to its intended Capability. Portfolio conflicts, incomplete Move 6-7 inputs,
     * and capabilities needing no maturity uplift appear as distinct status cases. This
     * presents the supplied plan; it does not choose projects, estimate resources, or
     * schedule dependencies.
     * @param {Object} portfolio Bundled and ordered portfolio output.
     * @param {Object[]} results Capability assessment results for status reporting.
     * @returns {Object} Created or rebuilt portfolio view.
     */
    function drawPortfolioView(portfolio, results) {
        const name = analysisViewNames.portfolio;
        const view = createView(name);
        if (!view) throw new Error("Could not create view '" + name + "'.");
        view.documentation =
            "CBP Move 6 actions are modeled as work packages with capability, dimension, increment, and target-level " +
            "traceability. Move 7 packages these actions into prioritized work-package projects. Project names and " +
            "priorities come from explicit CBP.Project.<dimension>.<year> and CBP.ProjectPriority.<dimension>.<year> properties.";
        clearView(view);
        resetDiagramObjectIndex();

        let row = 0;
        // Each portfolio row begins with its project package; its associated action and Capability
        // objects make the proposed change and its architectural target visible together.
        for (let p = 0; p < portfolio.projects.length; p++) {
            const project = portfolio.projects[p];
            const projectObject = addObject(
                view,
                project.element,
                60,
                100 + (row * 135),
                300,
                90
            );
            for (let a = 0; a < project.actions.length; a++) {
                const action = project.actions[a];
                const actionObject = addObject(
                    view,
                    action.element,
                    430,
                    100 + (row * 135) + (a * 85),
                    330,
                    70
                );
                const capabilityObject = addObject(
                    view,
                    action.input.capability,
                    850,
                    100 + (row * 135) + (a * 85),
                    260,
                    70
                );
                try {
                    // ArchiMate Composition models a project package containing actions; Realization
                    // traces each action to the capability change it is intended to bring about.
                    addModelConnection(
                        view,
                        "composition-relationship",
                        "Portfolio project contains improvement action",
                        project.element,
                        action.element,
                        projectObject,
                        actionObject
                    );
                    addModelConnection(
                        view,
                        "realization-relationship",
                        "Implements capability improvement",
                        action.element,
                        action.input.capability,
                        actionObject,
                        capabilityObject
                    );
                } catch (e) {
                    logWarn("Could not draw a portfolio relationship: " + e.message);
                }
            }
            row += Math.max(1, project.actions.length);
        }

        let errorY = 100 + (row * 135);
        // Portfolio conflicts (for example, inconsistent priorities for one named project) remain
        // visible as errors instead of being silently resolved by the script.
        for (let i = 0; i < portfolio.errors.length; i++) {
            addGeneratedCard(
                view,
                "[CBP] Portfolio input error " + (i + 1),
                portfolio.errors[i],
                60,
                errorY,
                700,
                70
            );
            errorY += 80;
        }
        // Distinguish a valid assessment requiring no maturity uplift from missing or invalid planning data.
        for (let i = 0; i < results.length; i++) {
            if (results[i].errors.length === 0 && results[i].actions.length === 0) {
                const statusCard = addGeneratedCard(
                    view,
                    "[CBP] No improvement action required - " + getName(results[i].capability),
                    "No dimension target exceeds the current maturity assessment for the configured planning horizon.",
                    60,
                    errorY,
                    700,
                    75,
                    String(results[i].capability.id)
                );
                const capabilityObject = addObject(
                    view,
                    results[i].capability,
                    850,
                    errorY,
                    260,
                    70
                );
                try {
                    addModelConnection(
                        view,
                        "association-relationship",
                        "Portfolio assessment covers capability",
                        statusCard.concept,
                        results[i].capability,
                        statusCard,
                        capabilityObject
                    );
                } catch (e) {
                    logWarn("Could not connect portfolio status for " + getName(results[i].capability) + ": " + e.message);
                }
                errorY += 85;
                continue;
            }
            if (results[i].errors.length === 0) continue;
            const statusCard = addGeneratedCard(
                view,
                "[CBP] Move 6-7 inputs incomplete - " + getName(results[i].capability),
                results[i].errors.join("\n"),
                60,
                errorY,
                700,
                90,
                String(results[i].capability.id)
            );
            const capabilityObject = addObject(
                view,
                results[i].capability,
                850,
                errorY,
                260,
                70
            );
            try {
                addModelConnection(
                    view,
                    "association-relationship",
                    "Portfolio input status for capability",
                    statusCard.concept,
                    results[i].capability,
                    statusCard,
                    capabilityObject
                );
            } catch (e) {
                logWarn("Could not connect portfolio input status for " +
                    getName(results[i].capability) + ": " + e.message);
            }
            errorY += 100;
        }
        return view;
    }

    /**
     * Updates the seven workflow concepts with per-move completion counts and outstanding human tasks.
     *
     * Counts complete profiles, maturity and importance assessments, plotted ML-SI pairs,
     * valid Goals, actions, and projects, then records a concise status on each methodology
     * Business Process. The documentation also distinguishes automated results from human
     * responsibilities such as source research and stakeholder validation.
     * @param {Object[]} methodElements Workflow concepts representing the seven CBP moves.
     * @param {Object[]} results Capability assessment results.
     * @param {Object} portfolio Grouped project/action output.
     * @param {number} strategyCount Number of strategy concepts included in scoring.
     * @param {string[]} increments Configured planning years.
     */
    function updateMethodologyDocumentation(methodElements, results, portfolio, strategyCount, increments) {
        let maturityCount = 0;
        let importanceCount = 0;
        let matrixCount = 0;
        let goalCount = 0;
        let completeProfileCount = 0;
        const profileFields = [
            "CBP.Profile.Source",
            "CBP.Profile.Definition",
            "CBP.Profile.BusinessUnits",
            "CBP.Profile.Processes",
            "CBP.Profile.Applications",
            "CBP.Profile.StrategicElements",
            "CBP.Profile.Measures"
        ];
        for (let i = 0; i < results.length; i++) {
            if (results[i].maturity !== null) maturityCount++;
            if (results[i].importance !== null) importanceCount++;
            if (results[i].maturity !== null && results[i].importance !== null) matrixCount++;
            goalCount += results[i].goals.length;
            let profileComplete = true;
            for (let f = 0; f < profileFields.length; f++) {
                if (!getProperty(results[i].capability, profileFields[f])) profileComplete = false;
            }
            if (profileComplete) completeProfileCount++;
        }
        const descriptions = [
            "Move 1: uses the explicitly modeled Capability elements and existing accepted structural relationships. " +
                "Complete profiles: " + completeProfileCount + " of " + results.length +
                "; source-document discovery and stakeholder validation remain human tasks.",
            "Move 2: calculated weighted mean from CBP.Maturity.People, Process, and Technology (0-4). " +
                "Complete maturity assessments: " + maturityCount + " of " + results.length + ".",
            "Move 3: calculated normalized weighted strategic-importance score from marked strategy elements " +
                "and their 0-2 impact scores. Strategies found: " + strategyCount +
                "; complete capability scores: " + importanceCount + " of " + results.length + ".",
            "Move 4: plotted fully assessed capabilities in the ML-SI matrix and classified Gap, Comfort, " +
                "or Acceptance using CBP.AcceptanceTolerance. Plotted: " + matrixCount + ".",
            "Move 5: generated capability maturity goals from explicit overall and dimension targets. " +
                "Configured increments: " + (increments.join(", ") || "none") + "; goals: " + goalCount + ".",
            "Move 6: generated improvement work packages from explicit dimension transitions and action descriptions. " +
                "Actions: " + portfolio.actions.length + ".",
            "Move 7: grouped improvement actions into projects and sorted packages by declared priority. " +
                "Projects: " + portfolio.projects.length + "."
        ];
        for (let i = 0; i < methodElements.length; i++) {
            methodElements[i].documentation = descriptions[i];
        }
    }

    // Load selection/model/logging helpers when present; local fallbacks keep the script usable without them.
    // Orchestration: resolve scope, run evidence-based analyses, produce linked views, then report
    // completion and data gaps. This ordering prevents presentation from becoming analysis logic.
    try {
        safeLoad(__DIR__ + "lib/resolveSelection.js");
        safeLoad(__DIR__ + "lib/requireModel.js");
        safeLoad(__DIR__ + "lib/log.js");
    } catch (e) { }

    // Stop before creating or changing a view if no active Archi model is available.
    activeModel = getCurrentModel();
    if (!activeModel) {
        logError("No Archi model is active. Open or select an Archi model before running this script.");
        return;
    }

    logHeader(scriptName);
    try {
        const planningElements = discoverPlanningElements();
        const capabilityElements = [];
        const capabilityIds = {};
        for (let i = 0; i < planningElements.length; i++) {
            if (getTypeName(planningElements[i]) !== "capability") continue;
            const id = String(planningElements[i].id);
            if (capabilityIds[id]) continue;
            capabilityIds[id] = true;
            capabilityElements.push(planningElements[i]);
        }
        // A map without explicit Capability concepts can only be seeded from eligible business
        // behaviors; candidates are scored provisionally and retain a visible review status.
        if (capabilityElements.length === 0) {
            const generatedCandidates = createCapabilityCandidates(planningElements);
            for (let i = 0; i < generatedCandidates.length; i++) {
                const candidate = generatedCandidates[i];
                const id = String(candidate.id);
                if (capabilityIds[id]) continue;
                capabilityIds[id] = true;
                capabilityElements.push(candidate);
                planningElements.push(candidate);
            }
            if (capabilityElements.length === 0) {
                logError(
                    "No ArchiMate Capability elements or eligible business functions, processes, or services " +
                    "were found. Select relevant model elements or add them to the active model, then rerun."
                );
                return;
            }
            logWarn(
                "No validated ArchiMate Capability elements were found. Created " + capabilityElements.length +
                " review-required candidates from business functions/processes/services. They will be assessed " +
                "provisionally in this run; review the candidates and results before relying on them."
            );
        }
        const planningIds = {};
        for (let i = 0; i < planningElements.length; i++) {
            planningIds[String(planningElements[i].id)] = true;
        }
        for (let i = 0; i < capabilityElements.length; i++) {
            const id = String(capabilityElements[i].id);
            if (!planningIds[id]) {
                planningElements.push(capabilityElements[i]);
                planningIds[id] = true;
            }
        }

        const increments = getIncrements();
        let tolerance = 0;
        const rawTolerance = getProperty(activeModel, "CBP.AcceptanceTolerance");
        if (rawTolerance !== "") {
            tolerance = Number(rawTolerance);
            if (isNaN(tolerance) || tolerance < 0 || tolerance > 4) {
                logError("Model property CBP.AcceptanceTolerance must be between 0 and 4.");
                return;
            }
        }
        // Candidate status remains a review marker; candidates use the same provisional
        // validation and calculation path as other Capability concepts.
        const strategies = discoverStrategies();
        const candidatesAwaitingReview = [];
        for (let i = 0; i < capabilityElements.length; i++) {
            if (isCapabilityCandidate(capabilityElements[i]) &&
                getProperty(capabilityElements[i], "CBP.CandidateStatus").toLowerCase() !== "approved") {
                candidatesAwaitingReview.push(capabilityElements[i]);
            }
        }
        const results = [];
        for (let i = 0; i < capabilityElements.length; i++) {
            results.push(calculateCapability(capabilityElements[i], strategies, increments, tolerance));
        }
        const portfolio = buildPortfolio(results);
        const methodStepElements = [];
        for (let i = 0; i < methodologySteps.length; i++) {
            methodStepElements.push(findOrCreateMethodStep(methodologySteps[i]));
        }
        updateMethodologyDocumentation(
            methodStepElements,
            results,
            portfolio,
            strategies.length,
            increments
        );

        // Each view implements an analytical deliverable from the paper; the overview is only an index and must not
        // substitute for the linked evidence views.
        const profileView = drawCapabilityProfilesView(capabilityElements);
        // Move 2: calculate dimension-weighted maturity and show its five-band heatmap.
        const maturityView = drawScoreView(
            analysisViewNames.maturity + " - Maturity Heatmap",
            "CBP Move 2 - Maturity Heatmap",
            "maturity",
            function() {
                return "Weighted overall maturity score from People, Process, and Technology.";
            },
            results,
            false
        );
        // Move 3: calculate weighted strategy impact and show its importance heatmap.
        const importanceView = drawScoreView(
            analysisViewNames.maturity + " - Strategic Importance Heatmap",
            "CBP Move 3 - Strategic Importance Heatmap",
            "importance",
            function() {
                return "Weighted strategy impact normalized to 0-4. Strategies: " + strategies.length + ".";
            },
            results,
            true
        );
        // Moves 4-5: plot assessed capability pairs, identify zones, and show validated increment goals.
        const matrixView = drawMatrixAndGoalsView(results, increments);
        // Moves 6-7: visualize the derived action Work Packages and prioritized project bundles.
        const portfolioView = drawPortfolioView(portfolio, results);

        const targetView = createView(viewName);
        if (!targetView) {
            logError("Could not create the capability-planning overview view.");
            return;
        }
        // Embed the input contract in the model view so results remain interpretable when shared
        // without this script's README.
        targetView.documentation =
            "Capability-Based Planning output. The supporting CBP views contain the maturity heatmap, strategic-" +
            "importance heatmap, ML-SI matrix, improvement goals, and prioritized action portfolio. All analytical " +
            "results use the explicit model properties described below; missing evidence is left unscored.\n\n" +
            "Model property contract:\n" +
            "Model: CBP.Increments=YYYY,YYYY; optional CBP.AcceptanceTolerance=0..4.\n" +
            "Strategy concepts (Driver, Goal, Requirement, or Course of Action): CBP.Role=Strategy; optional " +
            "CBP.StrategyWeight>0; CBP.Impact.<CapabilityID>=0|1|2 for each capability.\n" +
            "Capability: CBP.Maturity.People|Process|Technology=integer 0..4; candidate assessments are provisional " +
            "until reviewed and approved; optional " +
            "CBP.Weight.People|Process|Technology>0 (default weight 1); CBP.Profile.Source, Definition, " +
            "BusinessUnits, Processes, Applications, StrategicElements, Measures.\n" +
            "For each increment YYYY: CBP.TargetML.YYYY and CBP.Target.People|Process|Technology.YYYY; " +
            "when a dimension improves, supply CBP.Action.<Dimension>.YYYY, CBP.Project.<Dimension>.YYYY, " +
            "and integer CBP.ProjectPriority.<Dimension>.YYYY (lower number means higher priority). " +
            "Overall target must equal the weighted mean of dimension targets. Generated CBP.Result.* properties " +
            "are calculated outputs and must not be edited as inputs.";
        clearView(targetView);
        resetDiagramObjectIndex();

        const hierarchy = collectHierarchyRelationships(planningElements);
        const positions = layoutHierarchy(
            planningElements,
            hierarchy.childrenByParent,
            hierarchy.parentByChild
        );
        for (let i = 0; i < planningElements.length; i++) {
            const element = planningElements[i];
            const pos = positions[String(element.id)];
            if (pos) addObject(targetView, element, pos.x, pos.y, 170, 80);
        }

        const methodStepObjects = [];
        for (let i = 0; i < methodStepElements.length; i++) {
            methodStepObjects.push(addObject(
                targetView,
                methodStepElements[i],
                60,
                60 + (i * 105),
                330,
                70
            ));
        }
        // Display the seven move results in sequence; these triggering links describe method order, not EA dependencies.
        for (let i = 0; i < methodStepElements.length - 1; i++) {
            if (!methodStepObjects[i] || !methodStepObjects[i + 1]) continue;
            try {
                addModelConnection(
                    targetView,
                    "triggering-relationship",
                    "CBP methodology sequence " + (i + 1) + " to " + (i + 2),
                    methodStepElements[i],
                    methodStepElements[i + 1],
                    methodStepObjects[i],
                    methodStepObjects[i + 1]
                );
                methodologyRelationshipCount++;
            } catch (e) {
                logWarn("Could not draw CBP step sequence " + (i + 1) + " to " + (i + 2) + ": " + e.message);
            }
        }

        // Draw existing source-model hierarchy links only when both endpoint concepts are visible.
        for (let i = 0; i < hierarchy.relationships.length; i++) {
            const relationship = hierarchy.relationships[i];
            const sourceObject = diagramObjectsByElementId[String(relationship.getSource().getId())];
            const targetObject = diagramObjectsByElementId[String(relationship.getTarget().getId())];
            if (!sourceObject || !targetObject) continue;
            try {
                addModelConnection(
                    targetView,
                    getTypeName(relationship),
                    getName(relationship),
                    relationship.getSource(),
                    relationship.getTarget(),
                    sourceObject,
                    targetObject
                );
                displayedRelationshipCount++;
            } catch (e) {
                logWarn("Could not draw a source-model hierarchy relationship: " + e.message);
            }
        }

        logSuccess(
            "CBP views generated for " + capabilityElements.length +
            " capability concepts (" + candidatesAwaitingReview.length + " generated candidates marked for review)."
        );
        if (candidatesAwaitingReview.length > 0) {
            logWarn(
                candidatesAwaitingReview.length +
                " generated Capability candidates were assessed provisionally. Review their identity, profile, and " +
                "assessment results in '" + profileView.name +
                "' before relying on them, then set CBP.CandidateStatus=Approved."
            );
        }
        logInfo("Moves 1-7 are documented on the seven workflow elements and detailed in the supporting views.");
        logInfo(
            "Maturity assessed: " + results.filter(function(result) { return result.maturity !== null; }).length +
            "/" + results.length + "; strategic importance assessed: " +
            results.filter(function(result) { return result.importance !== null; }).length + "/" + results.length +
            "; matrix plotted: " + results.filter(function(result) {
                return result.maturity !== null && result.importance !== null;
            }).length + "/" + results.length + "."
        );
        logInfo(
            "Improvement goals: " + results.reduce(function(total, result) {
                return total + result.goals.length;
            }, 0) + "; dimension actions: " + portfolio.actions.length +
            "; prioritized projects: " + portfolio.projects.length + "."
        );
        let incompleteCount = 0;
        for (let i = 0; i < results.length; i++) {
            if (results[i].errors.length > 0) {
                incompleteCount++;
                logWarn(getName(results[i].capability) + ": " + results[i].errors.join(" "));
            }
        }
        for (let i = 0; i < portfolio.errors.length; i++) logWarn(portfolio.errors[i]);
        if (incompleteCount > 0 || portfolio.errors.length > 0) {
            logWarn(
                "Some moves have incomplete inputs. The generated views mark missing data; do not treat " +
                "those capabilities or portfolio entries as completed assessments."
            );
        }
        logInfo("Capability map elements: " + planningElements.length +
            "; source hierarchy relationships displayed: " + hierarchy.relationships.length + ".");
        logInfo("Supporting views: " + profileView.name + "; " + maturityView.name + "; " + importanceView.name + "; " +
            matrixView.name + "; " + portfolioView.name + ".");
        const outputViews = [profileView, maturityView, importanceView, matrixView, portfolioView, targetView];
        for (let i = 0; i < outputViews.length; i++) {
            const connectionCount = diagramConnectionCounts[getName(outputViews[i])] || 0;
            logInfo(
                "Diagram connections in '" + getName(outputViews[i]) + "': " +
                connectionCount + "."
            );
            if (connectionCount === 0) {
                logWarn(
                    "No diagram connections were drawn in '" + getName(outputViews[i]) +
                    "'. Review relationship creation/drawing warnings above."
                );
            }
        }
        if (omittedRelationshipCount > 0) {
            logInfo("Omitted " + omittedRelationshipCount +
                " structural links that would introduce a duplicate parent or cycle.");
        }
        if (skippedLegacyRelationshipCount > 0) {
            logWarn("Skipped " + skippedLegacyRelationshipCount +
                " generic relationships from earlier script versions.");
        }

        try {
            targetView.open();
        } catch (e) {
            logWarn("The overview was created but could not be opened automatically: " + e.message);
        }
    } catch (e) {
        logError("CBP generation stopped: " + e.message);
        if (e.stack) logError(e.stack);
    }
})();