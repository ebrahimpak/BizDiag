      analyzable: true,
    },

"OB.74": {
      aspect: "Cross-Layer",
      severity: "CRITICAL",
      desc: "فرآیند کسب‌وکار فاقد اتصال عملکردی به لایۀ برنامۀ کاربردی است (تخلف از هماهنگی و انسجام میان‌لایه‌ای)",
      analyzable: true,
    },

"OB.75": {
      aspect: "Cross-Layer",
      severity: "CRITICAL",
      desc: "شیء داده فاقد نگاشت بین لایۀ کسب‌وکار و لایۀ فناوری اطلاعات است",
      analyzable: true,
    },

"OB.76": {
      aspect: "Application",
      severity: "MEDIUM",
      desc: "نرم‌افزار به دلایل صرفاً فنی و بدون توجیه کسب‌وکاری توسعه یافته است (یکپارچگی صرفاً فنی)",
      analyzable: true,
    },

"OB.77": {
      aspect: "Business",
      severity: "HIGH",
      desc: "قابلیت کسب‌وکار در انزوا فعالیت می‌کند و بدون یکپارچگی بین‌عملکردی است (سیلو)",
      analyzable: true,
    },

"OB.78": {
      aspect: "Application",
      severity: "MEDIUM",
      desc: "یک نرم‌افزار شمار زیادی قابلیت کسب‌وکار را پیاده‌سازی کرده است (معماری یکپارچه)",
      analyzable: true,
    },

"OB.79": {
      aspect: "Cross-Layer",
      severity: "HIGH",
      desc: "تابع کسب‌وکار دارای چندین پیاده‌سازی برنامۀ کاربردی متعارض است (پیاده‌سازی‌های تکراری)",
      analyzable: true,
    }
};

  const FileWriter = Java.type("java.io.FileWriter");
  const File = Java.type("java.io.File");
  // Common Java I/O streaming helpers used for large outputs
  const FileOutputStream = Java.type("java.io.FileOutputStream");
  const OutputStreamWriter = Java.type("java.io.OutputStreamWriter");
  const BufferedWriter = Java.type("java.io.BufferedWriter");
  const StandardCharsets = Java.type("java.nio.charset.StandardCharsets");
  // SWT classes used across the UI, hoisted for readability and reuse
  const SWTShell = Java.type("org.eclipse.swt.widgets.Shell");
  const SWTDisplay = Java.type("org.eclipse.swt.widgets.Display");
  const SWTComposite = Java.type("org.eclipse.swt.widgets.Composite");
  const SWTTable = Java.type("org.eclipse.swt.widgets.Table");
  const SWTTableItem = Java.type("org.eclipse.swt.widgets.TableItem");
  const SWTTableColumn = Java.type("org.eclipse.swt.widgets.TableColumn");
  const SWTLabel = Java.type("org.eclipse.swt.widgets.Label");
  const SWTGridLayout = Java.type("org.eclipse.swt.layout.GridLayout");
  const SWTGridData = Java.type("org.eclipse.swt.layout.GridData");
  const SWTColor = Java.type("org.eclipse.swt.graphics.Color");
  const SWTFont = Java.type("org.eclipse.swt.graphics.Font");
  const SWTImage = Java.type("org.eclipse.swt.graphics.Image");
  const SWTImageData = Java.type("org.eclipse.swt.graphics.ImageData");
  const SWTScale = Java.type("org.eclipse.swt.widgets.Scale");

  // Use script directory as output location (sibling to script)
  const scriptDir = __DIR__;
  const csvPath = scriptDir + File.separator + "alignment_report.csv";
  const xlsPath = scriptDir + File.separator + "alignment_report.xls";

  // jArchi model root (wrap but do NOT shadow global `model` variable)
  const root = $(model);

  // FILTERING CONFIG: Focus on enterprise-level issues, exclude non-analyzable symptoms
  const REPORT_MODE = {
    // In FA we prefer to include non-analyzable findings (metadata completeness and low-severity warnings)
    // to ensure LOW severity (yellow) rows remain visible by default.
    includeNonAnalyzable: true, // Set true to see all symptoms including metadata completeness
    // Default to LOW in FA to preserve visibility of low-severity (yellow) findings.
    // Change to MEDIUM via config if you only want MEDIUM+ reports.
    minSeverity: "LOW",
    severityOrder: ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
  };

  // Debugging flag: force a LOW sample finding to validate UI display and CSV export (removed for production)

  // Helper: check if symptom should be included based on filtering config
  /**
   * Determines if a finding should be reported based on configured severity and analyzability filters.
   *
   * @param {string} code - The symptom code (e.g., "S.01", "B.11") to check
   * @returns {boolean} - true if the finding passes severity and analyzability filters, false otherwise
   *
   * Filters out:
   * - Non-analyzable symptoms (if REPORT_MODE.includeNonAnalyzable is false)
   * - Symptoms with severity below REPORT_MODE.minSeverity threshold
   */
  function isReportableSeverity(code) {
    let symptom = SYMPTOM_CATALOGUE[code];
    if (!symptom) return true;

    if (!REPORT_MODE.includeNonAnalyzable && !symptom.analyzable) {
      return false; // exclude non-analyzable (metadata-only issues)
    }

    let minLevel = SEVERITY[REPORT_MODE.minSeverity].level;
    let symLevel = SEVERITY[symptom.severity].level;
    const reportable = symLevel >= minLevel;
    return reportable;
  }

  // ===== ArchiMate canonical type groups (Space-separated format from jArchi/Archi)
  const TYPES = {
    GOAL: ["Goal"],
    OUTCOME: ["Outcome", "Assessment", "Indicator", "Measurement"],
    CAPABILITY: ["Business Capability"],
    PROCESS: [
      "Business Process",
      "Business Function",
      "Interaction",
      "Business Interaction",
    ],
    VALUE: ["Value Stream", "Value Stage"],
    DATA: ["Data Object", "Business Object", "Artifact"],
    APPLICATION: [
      "Application Component",
      "Application Service",
      "Application Interface",
      "Application Collaboration",
    ],
    TECHNOLOGY: [
      "Node",
      "Device",
      "System Software",
      "Technology Service",
      "Infrastructure",
    ],
    SERVICE: [
      "Service",
      "Business Service",
      "Application Service",
      "Technology Service",
    ],
    REQUIREMENT: ["Requirement"],
    CONSTRAINT: ["Constraint"],
    RISK: ["Risk"],
    VENDOR: ["Contract", "Location", "Resource", "Business Object"],
    STAKEHOLDER: ["Stakeholder"],
    WORK: ["Work Package", "Deliverable", "Implementation Event", "Plateau"],
    DRIVER: ["Driver", "External Factor", "Assessment"],
    RESOURCE: ["Resource", "Business Object", "Equipment", "Material"],
  };

  // findings
  const findings = []; // {id,name,type,code,desc,documentation}
  // Cached copy of findings used after the initial table rendering to allow
  // re-rendering the UI without keeping large JS arrays live in memory.
  const findingsCache = [];

  // helpers
  /**
   * Logs an info message to the jArchi console.
   * @param {string} s - The message string to log
   */
  function info(s) {
    console.log(s);
  }
  /**
   * Logs a section heading to the console with visual formatting.
   * @param {string} s - The heading text to display
   */
  function heading(s) {
    console.log("\n▃▃▃ " + s + " ▃▃▃");
  }

  // Helper: build heading string using SYMPTOM_CATALOGUE desc if available
  function getHeadingString(code, fallback) {
    // Force the leading code and hyphen to render left-to-right inside RTL text by
    // wrapping it in an LRE (left-to-right embedding) and closing with PDF
    // (pop directional formatting). This preserves the visual order for Persian text.
    try {
      const LRE = "\u202A";
      const PDF = "\u202C";
      if (code && SYMPTOM_CATALOGUE[code] && SYMPTOM_CATALOGUE[code].desc) {
        return LRE + code + " - " + PDF + " " + SYMPTOM_CATALOGUE[code].desc;
      }
      // If a fallback exists and starts with `code + ' - '`, treat the remainder as desc
      if (code && fallback && fallback.indexOf(code + " - ") === 0) {
        const desc = fallback.substring((code + " - ").length);
        return LRE + code + " - " + PDF + " " + desc;
      }
    } catch (e) {}
    return fallback || code || "";
  }
  /**
   * Safely retrieves an element's name from either getName() or name() methods.
   * Handles both jArchi proxy objects and fallback implementations gracefully.
   *
   * @param {Object} e - The ArchiMate element to extract the name from
   * @returns {string} - The element's name, or empty string if unavailable or error occurs
   *
   * Tries in order:
   * 1. getName() - Direct method call on proxy
   * 2. name() - Fallback method call
   * Returns empty string on any exception
   */
  function safeName(e) {
    try {
      if (e.getName && typeof e.getName === "function") {
        let n = e.getName();
        if (n) return n;
      }
      if (e.name && typeof e.name === "function") {
        let n = e.name();
        if (n) return n;
      }
    } catch (x) {}
    return "";
  }
  /**
   * Safely retrieves an element's unique identifier from either getId() or id() methods.
   * Handles both jArchi proxy objects and fallback implementations gracefully.
   *
   * @param {Object} e - The ArchiMate element to extract the ID from
   * @returns {string} - The element's unique ID, or empty string if unavailable or error occurs
   *
   * Tries in order:
   * 1. getId() - Direct method call on proxy
   * 2. id() - Fallback method call
   * Returns empty string on any exception
   */
  function safeId(e) {
    try {
      if (e.getId && typeof e.getId === "function") {
        let i = e.getId();
        if (i) return i;
      }
      if (e.id && typeof e.id === "function") {
        let i = e.id();
        if (i) return i;
      }
    } catch (x) {}
    return "";
  }
  /**
   * Safely retrieves an element's ArchiMate type using multiple fallback strategies.
   * Converts kebab-case type names (from getType()) to PascalCase for consistency.
   *
   * @param {Object} e - The ArchiMate element to determine the type of
   * @returns {string} - The element type in PascalCase (e.g., "BusinessService"), or empty string
   *
   * Detection priority:
   * 1. getType() - Returns kebab-case ("business-service") → converts to PascalCase
   * 2. type() - Direct type method
   * 3. eClass.name - EMF metaclass name
   * 4. concept() - Conceptual type reference
   * 5. eObject.eClass.name - Underlying EMF object type
   *
   * Returns empty string if all methods fail or return invalid values
   */
  function safeType(e) {
    try {
      // Method 1: getType() - returns kebab-case class name (MOST RELIABLE)
      if (e.getType && typeof e.getType === "function") {
        let typeRes = e.getType();
        if (typeRes && typeRes !== "" && typeRes !== "Object") {
          // Convert kebab-case to PascalCase for consistency
          // "business-service" -> "BusinessService"
          return kebabToPascal(typeRes);
        }
      }

      // Method 2: type() call
      if (e.type && typeof e.type === "function") {
        let typeRes = e.type();
        if (typeRes && typeRes !== "" && typeRes !== "Object") return typeRes;
      }

      // Method 3: Direct eClass on element
      // .eClass: ECMAScript Metamodel (ECORE) metaclass descriptor
      //   - Provides direct access to EMF (Eclipse Modeling Framework) type information
      //   - eClass.name returns the ArchiMate element type (e.g., "BusinessService", "ApplicationComponent")
      //   - ECORE is the underlying Java framework that jArchi uses to model ArchiMate concepts
      //   - More reliable than getType() for semantic type checking, but returns raw EMF names
      if (e.eClass && e.eClass.name) {
        let t = e.eClass.name;
        if (t && t !== "" && t !== "Object") return t;
      }

      // Method 4: concept() call
      if (e.concept && typeof e.concept === "function") {
        let conceptRes = e.concept();
        if (conceptRes && conceptRes !== "" && conceptRes !== "Object")
          return conceptRes;
      }

      // Method 5: Direct eObject (EMF underlying model)
      // .eObject: Root reference to the underlying ECORE model object
      //   - eObject is the actual Java EMF instance that jArchi proxies wrap
      //   - eObject.eClass accesses the metaclass descriptor directly (bypassing proxy layer)
      //   - eObject.eClass.name returns the definitive ArchiMate type from the EMF model
      //   - This is the MOST AUTHORITATIVE type source, used when direct .eClass is unavailable
      //   - Drilling down: jArchi Element → eObject (actual ECORE object) → eClass (type metadata) → name ("BusinessService", etc.)
      if (e.eObject && e.eObject.eClass && e.eObject.eClass.name) {
        let typeName = e.eObject.eClass.name;
        if (typeName && typeName !== "" && typeName !== "Object")
          return typeName;
      }

      return "";
    } catch (x) {
      return "";
    }
  }

  // Helper: Convert kebab-case to PascalCase
  /**
   * Converts kebab-case strings to PascalCase format.
   * Used to normalize type names returned by getType() (kebab-case) to match TYPES configuration.
   *
   * Example: "business-service" → "BusinessService"
   * Example: "application-component" → "ApplicationComponent"
   *
   * @param {string} kebabStr - The kebab-case string to convert
   * @returns {string} - The converted PascalCase string, or empty string if input is falsy
   */
  function kebabToPascal(kebabStr) {
    if (!kebabStr) return "";
    return kebabStr
      .split("-")
      .map(function (word) {
        return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
      })
      .join("");
  }

  // mark element: add property, note, color, and record finding (with severity filtering)
  /**
   * Marks an ArchiMate element as having a detected misalignment and records the finding.
   *
   * This is the core function that:
   * 1. Filters the finding based on severity and analyzability settings
   * 2. Adds/appends the symptom code to the element's misalignment property
   * 3. Records severity and detailed notes in element properties
   * 4. Applies color-coding to the element for visual indication
   * 5. Stores the finding in the findings array for reporting
   *
   * @param {Object} el - The ArchiMate element to mark
   * @param {string} code - The symptom code (e.g., "S.01", "SEM.01")
   * @param {string} desc - The symptom description/title
   * @param {string} documentation - The documentation about this specific instance (optional)
   *
   * Side effects:
   * - Modifies element properties: misalignment, misalignment_notes, misalignment_severity
   * - Sets element fill color based on severity
   * - Appends to findings array
   */
  function markElement(el, code, desc, documentation) {
    // Filter out non-reportable findings
    if (!isReportableSeverity(code)) {
      return; // skip this finding
    }

    try {
      let symptom = SYMPTOM_CATALOGUE[code];
      // If the symptom is missing from the catalogue, default to LOW and emit a warning.
      // Historically 'UNKNOWN' was used as a fallback; this avoids unrecognized severity in UI.
      let severity = symptom && symptom.severity ? symptom.severity : "LOW";
      if (!symptom) {
        console.log(
          "هشدار: کد نشانه '" +
            code +
            "' در کاتالوگ نشانه‌های ناهمراستایی تعریف نشده است. شدت پیش‌فرض: کم."
        );
      }

      let existing = "";
      try {
        existing = (el.prop && el.prop(tagProperty)) || "";
      } catch (e) {}
      let codes = existing
        .split(",")
        .map(function (x) {
          return (x || "").trim();
        })
        .filter(Boolean);
      if (codes.indexOf(code) === -1) codes.push(code);
      try {
        el.prop(tagProperty, codes.join(", "));
      } catch (e) {}

      // Store severity level
      try {
        el.prop(severityProperty, severity);
      } catch (e) {}

      let existingNotes = "";
      try {
        existingNotes = (el.prop && el.prop(notesProperty)) || "";
      } catch (e) {}
      // Prefer catalogue-provided description (translated) when available
      // If a catalogue description exists, use it as finalDesc and move any
      // passed desc argument into the documentation field if documentation
      // wasn't already provided. This ensures translations from the catalogue
      // take precedence while still preserving instance-specific details.
      // Prefer catalogue-provided description; if missing, use passed desc; if both
      // are missing (commonly for LOW severity codes that weren't defined in the
      // catalogue), fall back to the code string so UI and exports are never blank.
      let finalDesc = (symptom && symptom.desc) ? symptom.desc : (desc || code || "");
      // If we used the catalogue description but a specific instance provided a
      // custom desc, move that to documentation to preserve instance-specific notes.
      if (symptom && symptom.desc && desc && !documentation) documentation = desc;
      let note =
        "[" +
        severity +
        "] " +
        code +
        ": " +
        finalDesc +
        (documentation ? " (" + documentation + ")" : "");
      let newNotes = existingNotes ? existingNotes + " | " + note : note;
      try {
        el.prop(notesProperty, newNotes);
      } catch (e) {}

      // Color-code by severity
      if (tagColor && typeof el.setFillColor === "function") {
        try {
          let sevColor = SEVERITY[severity]
            ? SEVERITY[severity].color
            : colorForIssue;
          el.setFillColor(sevColor);
        } catch (e) {}
      }

      // Derive aspect if missing from catalogue: use code prefix mapping (S, B, D, A, T, X, STR, SEM, OB)
      const derivedAspect = (function () {
        try {
          if (symptom && symptom.aspect) return symptom.aspect;
          const prefix = String(code || "").split(".")[0];
          switch (String(prefix).toUpperCase()) {
            case "S":
            case "STR":
              return "Strategy";
            case "B":
              return "Business";
            case "D":
              return "Data";
            case "A":
              return "Application";
            case "T":
              return "Technology";
            case "X":
              return "Cross-Layer";
            case "SEM":
              return "Semantic";
            case "OB":
              return "Operational";
            default:
              return "Unclassified";
          }
        } catch (e) {
          return "Unclassified";
        }
      })();

      if (!symptom || !symptom.aspect) {
        console.log(
          "هشدار: کد نشانه '" +
            code +
            "' بدون «بُعد» در کاتالوگ نشانه‌های ناهمراستایی است؛ بُعد استخراج‌شده: " +
            derivedAspect
        );
      }

      findings.push({
        elementId: safeId(el),
        elementName: safeName(el),
        elementType: safeType(el),
        code: code,
        severity: severity,
        desc: finalDesc,
        documentation:
          el.getDocumentation && typeof el.getDocumentation === "function"
            ? el.getDocumentation()
            : el.documentation && typeof el.documentation === "function"
            ? el.documentation()
            : "",
        analyzable: symptom ? symptom.analyzable : true,
        aspect: derivedAspect,
      });
      // No debug logging here; keep production clean
    } catch (e) {
      // ignore marking errors
    }
  }

  // check if element type exactly matches any of the canonical types (type-first)
  /**
   * Checks if an element's type matches any in a given array of type names.
   *
   * @param {Object} el - The ArchiMate element to check
   * @param {string[]} arr - Array of type names to match against (e.g., ["BusinessService", "Goal"])
   * @returns {boolean} - true if element type matches any type in the array, false otherwise
   *
   * Uses exact string matching after type normalization via safeType()
   */
  function isAnyType(el, arr) {
    let t = safeType(el);
    if (!t) return false;
    for (let i = 0; i < arr.length; i++) {
      if (t === arr[i]) return true;
    }
    return false;
  }

  // check relations: look for any relation to an element whose type equals one of patterns
  /**
   * Checks if an element has any relationship (incoming or outgoing) to elements of specified types.
   *
   * @param {Object} el - The ArchiMate element to check relations from
   * @param {string[]} typeArray - Array of target element types to search for
   * @returns {boolean} - true if at least one relationship to the target types exists, false otherwise
   *
   * Iterates through all relationships (both source and target directions)
   * and returns true on first match, making it efficient for existence checks
   */
  function hasRelationToTypes(el, typeArray) {
    let found = false;
    try {
      let rels = el.rels ? el.rels() : $(el).rels();
      rels.each(function (r) {
        try {
          let other = r.source === el ? r.target : r.source;
          if (isAnyType(other, typeArray)) {
            found = true;
            return;
          }
        } catch (e) {}
      });
    } catch (e) {}
    return found;
  }

  // check if element's actual eClass matches a type (direct introspection, not relying on safeType)
  /**
   * Performs direct EMF eClass matching to verify element type without relying on getType().
   * Used for precise semantic checking in misalignment detection logic.
   *
   * @param {Object} el - The ArchiMate element to check
   * @param {string} typeNamePattern - The expected type name (e.g., "ApplicationService")
   * @returns {boolean} - true if element's eClass matches the pattern, false otherwise
   *
   * Comparison strategy:
   * 1. Retrieves actual eClass name from eObject, eClass, or archimateElement
   * 2. Normalizes both pattern and actual by removing spaces for case-insensitive matching
   * 3. Performs both normalized and case-insensitive direct comparisons
   *
   * This is more reliable than getType() for semantic checks but doesn't handle naming variations
   */
  function matchesEClass(el, typeNamePattern) {
    try {
      let actualType = "";

      // Get the actual eClass name - prioritize eObject (EMF underlying model)
      // Priority order for type extraction (most to least authoritative):
      // 1. el.eObject.eClass.name - Underlying EMF object's metaclass (most direct, RECOMMENDED)
      //    eObject provides access to the actual ECORE model instance, bypassing jArchi proxy layer
      // 2. el.eClass.name - Direct metaclass on proxy element
      //    eClass on the proxy element also accesses ECORE type metadata
      // 3. el.archimateElement.eClass.name - Wrapped ArchiMate element type
      //    archimateElement is the wrapped ECORE object in jArchi, alternative reference to same model
      //    Used as fallback when eObject/eClass not directly accessible
      if (el.eObject && el.eObject.eClass && el.eObject.eClass.name) {
        actualType = el.eObject.eClass.name;
      } else if (el.eClass && el.eClass.name) {
        actualType = el.eClass.name;
      } else if (
        el.archimateElement &&
        el.archimateElement.eClass &&
        el.archimateElement.eClass.name
      ) {
        actualType = el.archimateElement.eClass.name;
      }

      if (!actualType) return false;

      // Normalize both for comparison (handle both CamelCase and space-separated)
      let pattern = String(typeNamePattern).toLowerCase().replace(/\s+/g, "");
      let actual = String(actualType).toLowerCase().replace(/\s+/g, "");

      // Exact match after normalization
      if (actual === pattern) return true;

      // Also try direct comparison (in case one uses spaces and other doesn't)
      if (String(actualType) === String(typeNamePattern)) return true;
      if (
        String(actualType).toLowerCase() ===
        String(typeNamePattern).toLowerCase()
      )
        return true;

      return false;
    } catch (e) {
      return false;
    }
  }

  // check if element has any of a set of properties populated
  /**
   * Checks if an element has any non-empty custom properties from a given list.
   * Useful for detecting if an element has documentation, owner, SLA, or other metadata.
   *
   * @param {Object} el - The ArchiMate element to check
   * @param {string[]} props - Array of property names to check for
   * @returns {boolean} - true if element has at least one non-empty property, false otherwise
   *
   * Returns false if:
   * - Any property is null, undefined, or whitespace-only
   * - Element doesn't support the prop() method
   * - All properties are missing or empty
   */
  function hasAnyProp(el, props) {
    try {
      for (let i = 0; i < props.length; i++) {
        const v = el.prop && el.prop(props[i]);
        if (v !== null && v !== undefined && String(v).trim() !== "")
          return true;
      }
    } catch (e) {}
    return false;
  }

  // Parse boolean-like property values safely including localized tokens
  // Returns: { found: Boolean, key: String|null, val: String|null, truthy: Boolean }
  function getPropBooleanValue(el, keys) {
    const trueTokens = ['true', '1', 'yes', 'y', 'on', 'enabled', 'enable', 'بله', 'بلی', 'فعال', 'فعال‌شده','درست', 'صحیح'];
    const falseTokens = ['false', '0', 'no', 'n', 'off', 'disabled', 'disable', 'خیر', 'نه', 'غیرفعال', 'فعال‌نشده','نادرست', 'غلط'];
    try {
      if (!el || typeof el.prop !== 'function') return { found: false, key: null, val: null, truthy: false };
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i];
        try {
          let raw = el.prop(key);
          if (typeof raw === 'undefined' || raw === null) continue;
          let val = String(raw).trim();
          if (val.length === 0) continue;
          const lower = val.toLowerCase();
          if (trueTokens.indexOf(lower) >= 0) return { found: true, key: key, val: val, truthy: true };
          if (falseTokens.indexOf(lower) >= 0) return { found: true, key: key, val: val, truthy: false };
          // Heuristic: treat numbers >0 as true, 0 as false
          if (!isNaN(Number(lower))) {
            const n = Number(lower);
            return { found: true, key: key, val: val, truthy: n !== 0 };
          }
          // Non-empty string that's not an explicit false/true token: treat as truthy,
          // but prefer explicitness. We'll treat explicit 'false' tokens as false earlier.
          return { found: true, key: key, val: val, truthy: true };
        } catch (inner) {
          continue;
        }
      }
    } catch (e) {}
    return { found: false, key: null, val: null, truthy: false };
  }

  // get all elements collection - filter to only valid archimate elements
  const allRaw = root.find(); // Get all elements/nodes

  // List of ArchiMate element types (kebab-case as returned by getType())
  const VALID_ELEMENT_TYPES = [
    "business-actor",
    "business-collaboration",
    "business-event",
    "business-function",
    "business-interaction",
    "business-interface",
    "business-object",
    "business-process",
    "business-role",
    "business-service",
    "application-collaboration",
    "application-component",
    "application-event",
    "application-function",
    "application-interaction",
    "application-interface",
    "application-service",
    "artifact",
    "data-object",
    "device",
    "distribution-network",
    "equipment",
    "facility",
    "infrastructure-function",
    "infrastructure-interface",
    "infrastructure-service",
    "network",
    "node",
    "system-software",
    "technology-interaction",
    "technology-event",
    "technology-collaboration",
    "technology-process",
    "technology-service",
    "technology-function",
    "technology-object",
    "capability",
    "course-of-action",
    "outcome",
    "principle",
    "resource",
    "value-stream",
    "landscape-map",
    "stakeholder",
    "driver",
    "assessment",
    "goal",
    "constraint",
    "requirement",
    "location",
    "meaning",
    "representation",
    "product",
    "contract",
    "service-contract",
  ];

  // Filter to only ArchiMate elements (exclude Folders and other container types)
  const all = [];
  allRaw.each(function (el) {
    try {
      let elementType = el.getType ? el.getType() : "";
      // Only include if it's a valid ArchiMate element type
      if (
        elementType &&
        elementType !== "" &&
        elementType !== "folder" &&
        elementType !== "object" &&
        VALID_ELEMENT_TYPES.indexOf(elementType.toLowerCase()) >= 0
      ) {
        all.push(el);
      }
    } catch (e) {}
  });

  // Convert array to collection-like object with .each() and .size()
  const allCollection = {
    items: all,
    size: function () {
      return this.items.length;
    },
    each: function (fn) {
      for (let i = 0; i < this.items.length; i++) {
        fn(this.items[i]);
      }
    },
  };

  // Utility: iterate canonical groups quickly
  /**
   * Iterates through all elements that match any type in a canonical type group.
   * Provides a convenient way to perform operations on elements belonging to a category.
   *
   * @param {string[]} groupArray - Array of type names defining the group (e.g., TYPES.GOAL, TYPES.PROCESS)
   * @param {Function} fn - Callback function to execute for each matching element
   *                        Receives the element as parameter: fn(element)
   *
   * Example usage:
   *   eachOfGroup(TYPES.GOAL, function(goal) {
   *     // Check goal for misalignments
   *   });
   *
   * The callback is invoked in allCollection iteration order
   */
  function eachOfGroup(groupArray, fn) {
    for (let i = 0; i < groupArray.length; i++) {
      const typeName = groupArray[i];
      try {
        root
          .find(
            typeName
              .toLowerCase()
              .replace(/([A-Z])/g, "-$1")
              .replace(/^\-/, "")
          )
          .each(function (el) {
            // NOTE: jArchi .find(...) accepts names like "business-process" etc.
            // But we still enforce type-check inside to be safe
            if (isAnyType(el, [typeName])) fn(el);
          });
      } catch (e) {
        // fallback: iterate all and filter by el.type()
        all.each(function (el) {
          if (isAnyType(el, [typeName])) fn(el);
        });
        break;
      }
    }
  }

  // Debug: inspect raw element types and counts
  heading("اشکال‌زدایی ▂▂ بازرسی عناصر خام");
  info("همۀ عناصر در مدل (همگی، از جمله داخلی): " + allRaw.size());
  info("عناصر معتبر آرکیمیت (فیلتر شده): " + allCollection.size());
  let rawTypes = {};
  let sampleElement = null;
  allCollection.each(function (el) {
    if (sampleElement === null) sampleElement = el;
    let t = safeType(el);
    if (!rawTypes[t]) rawTypes[t] = 0;
    rawTypes[t]++;
  });
  info("انواع عناصر معتبر یافت شد:");
  Object.keys(rawTypes).forEach(function (t) {
    info("  " + (t || "[خالی]") + ": " + rawTypes[t]);
  });

  // Deep introspection of first element
  if (sampleElement) {
    info("\nاشکال‌زدایی ▂▂ بررسی عنصر اول:");
    info("  نام: " + safeName(sampleElement));
    info("  شناسه: " + safeId(sampleElement));

    // Try different type detection methods
    try {
      if (sampleElement.eObject) {
        info("  eObject: موجود است");
        if (sampleElement.eObject.eClass && sampleElement.eObject.eClass.name) {
          info("  eObject.eClass.name: " + sampleElement.eObject.eClass.name);
        }
      } else {
        info("  eObject: موجود نیست");
      }
    } catch (e) {
      info("  eObject: خطا - " + e);
    }

    try {
      if (sampleElement.eClass && sampleElement.eClass.name) {
        info("  eClass.name: " + sampleElement.eClass.name);
      }
    } catch (e) {}

    try {
      if (
        sampleElement.concept &&
        typeof sampleElement.concept === "function"
      ) {
        info("  concept(): " + sampleElement.concept());
      }
    } catch (e) {}

    try {
      if (sampleElement.type && typeof sampleElement.type === "function") {
        info("  type(): " + sampleElement.type());
      }
    } catch (e) {}

    try {
      if (
        sampleElement.archimateElement &&
        sampleElement.archimateElement.eClass
      ) {
        info(
          "  archimateElement.eClass.name: " +
            sampleElement.archimateElement.eClass.name
        );
      }
    } catch (e) {}
  }

  // Debug: count elements by canonical type group
  heading("اشکال‌زدایی ▂▂ شمارش عناصر براساس نوع متعارف");
  let debugCounts = {};
  Object.keys(TYPES).forEach(function (groupName) {
    let typeList = TYPES[groupName];
    let count = 0;
    typeList.forEach(function (tn) {
      allCollection.each(function (el) {
        if (safeType(el) === tn) count++;
      });
    });
    debugCounts[groupName] = count;
    info("  " + groupName + ": " + count + " elements");
  });

  // ANALYTICAL FRAMEWORK: Assessment methodology
  // Phase 1: Preliminary review - catalog of influential areas
  // Phase 2: Malfunctioning area analysis - identify misalignment symptoms
  // Phase 3: Symptom categorization - assess against framework
  // Phase 4: Non-analyzable filtering - exclude context-dependent issues
  // Phase 5: Severity-based assessment - focus on enterprise-level issues

  // Start scanning
  heading("همراستایی کسب‌و‌کار و فناوری اطلاعات: اجرای پیمایش پژوهش‌محور");
  info("مدل: " + (root.name ? root.name() : "مدل بدون نام"));
  info(
    "روش‌شناسی: تشخیص نشانه‌های ناهمراستایی مبتنی بر معماری سازمانی (چارچوب ۷۹ نشانه)"
  );
  info("تمرکز ارزیابی: ناهمراستایی‌های راهبردی در سطح سازمان");
  info("");

  // ---------------- STRATEGY (S.01-S.10) ----------------

  heading(getHeadingString("S.01", "هدف بدون نتیجه/شاخص کلیدی عملکرد"));
  // STRATEGIC ALIGNMENT: Goals must have measurable outcomes (KPIs/Outcomes) to enable:
  // - Performance tracking and accountability
  // - Verification that strategy execution delivers intended business value
  // - Linkage from strategic intent (goal) → measurable results (outcomes)
  // Misalignment Impact: Goals without outcomes cannot be measured, making it impossible to verify
  // if strategic initiatives are actually delivering their intended business value. This breaks
  // the chain from strategy to results.
  eachOfGroup(TYPES.GOAL, function (g) {
    // goal must have linked outcome/assessment/kpi
    if (!hasRelationToTypes(g, TYPES.OUTCOME)) markElement(g, "S.01");
  });

  heading(getHeadingString("S.02", "نتیجه بدون وضعیت قابل اندازه‌گیری"));
  // PERFORMANCE MEASUREMENT: Outcomes (KPIs/Measures) must have quantifiable properties to ensure:
  // - Objective evaluation of goal achievement
  // - Data-driven governance and decision-making
  // - Traceability of business performance metrics
  // Misalignment Impact: An outcome without measurable status/target/actual values is qualitative
  // and subjective, defeating the purpose of KPI management. Business cannot demonstrate ROI
  // or performance against strategic objectives.
  eachOfGroup(TYPES.OUTCOME, function (o) {
    if (
      !hasAnyProp(o, [
        "status",
        "value",
        "target",
        "actual",
        "result",
        "measurement",
      ])
    )
      markElement(o, "S.02");
  });

  heading(getHeadingString("S.03", "هدف بدون پشتیبانی قابلیت"));
  // BUSINESS-TO-CAPABILITY ALIGNMENT: Goals must map to organizational capabilities that execute them:
  // - Ensures goals are operationally feasible within current/planned capability scope
  // - Validates that organizational capabilities exist to achieve strategic goals
  // - Enables capability planning and development roadmap prioritization
  // Misalignment Impact: Goals without capability mapping represent either:
  //   a) Unrealistic/aspirational goals with no execution path
  //   b) Missing capability investments needed to achieve strategy
  // This creates orphaned goals that cannot be realized through organizational operations.
  eachOfGroup(TYPES.GOAL, function (g) {
    if (!hasRelationToTypes(g, TYPES.CAPABILITY)) markElement(g, "S.03");
  });

  heading(getHeadingString("S.04", "هدف مقیاس را ذکر می‌کند ولی ظرفیت یا منبع را نه"));
  // CAPACITY PLANNING & RESOURCE ALIGNMENT: Goals with explicit scalability/performance demands
  // must map to supporting infrastructure capabilities and technologies to ensure:
  // - Infrastructure investment aligns with business scale ambitions
  // - Capacity planning roadmap reflects strategic non-functional requirements
  // - Technology selection and dimensioning address performance/scale constraints
  // Misalignment Impact: Goals stating "real-time", "high volume", "24x7", "scalable" etc.
  // without linked capabilities/technologies indicate:
  //   a) Unrealistic business promises without technical foundation
  //   b) Missing infrastructure investments not captured in planning
  //   c) Risk of service failures due to unplanned capacity constraints
  // This creates a gap between business ambitions and IT delivery readiness.
  eachOfGroup(TYPES.GOAL, function (g) {
    let desc = String(
      (g.prop && g.prop("description")) || (g.prop && g.prop("notes")) || ""
    );
    let text = (safeName(g) + " " + desc).toLowerCase();
    let scaleTokens = [
      "real-time",
      "24x7",
      "high volume",
      "scalab",
      "low-latency",
      "throughput",
      "peak",
      "massive",
      "large",
      "بزرگ‌مقیاس",
      "مقیاس‌پذیر",
      "درزمانی",
      "زمان واقعی",
      "حجم بالا",
      "حجم زیاد",
      "پهنای‌باند",
      "پهنای باند",
      "تأخیر کم",
      "بی‌درنگ",
      "بی درنگ",
      "بلادرنگ",
      "بی‌وقفه",
      "بی وقفه",
      "کم تأخیر‌",
      "توان‌رسانی",
      "توان رسانی",
      "پیک",
      "بزرگ",
      "درخواست‌های",
      "درخواست های",
      "رفت‌وآمد",
      "رفت و آمد",
      "عملکرد بالا",
      "بازده زیاد",
      "بار زیاد",
      "بار‌زیاد",
      "رشد لوگاریتمی",
      "رشد سریع",
      "مقیاس‌پذیری",
      "مقیاس پذیری",
      "توانش زمانی",
      "ظرفیت پذیرش",
      "خروجی",
      "ظرفیت",
      "توان عملیاتی",
      "پیک",
      "اوج",
      "شبانه‌روز"
    ];
    let mentionsScale = scaleTokens.some(function (t) {
      return text.indexOf(t) >= 0;
    });
      if (
      mentionsScale &&
      !hasRelationToTypes(g, TYPES.CAPABILITY) &&
      !hasRelationToTypes(g, TYPES.TECHNOLOGY)
    ) {
      markElement(g, "S.04");
    }
  });

  heading(
    getHeadingString("S.05", "راهبرد به جریان‌های ارزش نگاشت نشده است")
  );
  // VALUE STREAM ALIGNMENT: Strategic goals must map to business value streams to establish:
  // - Clear business process ownership and accountability for goal delivery
  // - Traceability from strategic intent through operational value creation
  // - Business case justification and return-on-investment (ROI) linkage
  // Misalignment Impact: Goals without value stream mapping represent strategic decisions
  // disconnected from how the business actually creates value. This indicates:
  //   a) Strategy not operationalized through business processes
  //   b) Missing business case validation and value realization tracking
  //   c) Inability to trace goal impact to actual business outcomes
  // This creates a strategy-execution gap where goals exist in isolation.
  eachOfGroup(["Goal", "ValueStream", "ValueStage"], function (dummy) {
    // iterate goals and check for value stream linkage
    eachOfGroup(TYPES.GOAL, function (g) {
      if (!hasRelationToTypes(g, ["ValueStream", "ValueStage"]))
        markElement(g, "S.05");
    });
  });

  heading(
    getHeadingString("S.06", "برنامۀ کاربردی به راهبرد یا نتیجه متصل نشده است")
  );
  eachOfGroup(TYPES.APPLICATION, function (a) {
    // direct link to goal/outcome/capability OR via capability
    const direct = hasRelationToTypes(
      a,
      TYPES.GOAL.concat(TYPES.OUTCOME).concat(TYPES.CAPABILITY)
    );
    if (!direct) {
      // two-hop: app -> capability -> goal/outcome
      let twoHop = false;
      try {
        const rels = a.rels ? a.rels() : $(a).rels();
        rels.each(function (r) {
          const other = r.source === a ? r.target : r.source;
          if (isAnyType(other, TYPES.CAPABILITY)) {
            if (hasRelationToTypes(other, TYPES.GOAL.concat(TYPES.OUTCOME)))
              twoHop = true;
          }
        });
      } catch (e) {}
      if (!twoHop) markElement(a, "S.06");
    }
  });

  heading(getHeadingString("S.07", "فاقد نگاشت‌های ریسک"));
  // RISK MANAGEMENT & COMPLIANCE: Strategic goals and capabilities must map to risk/constraint/requirement
  // elements to establish:
  // - Risk-aware planning and mitigation accountability
  // - Compliance and constraint validation for strategic initiatives
  // - Risk-driven investment prioritization and contingency planning
  // Misalignment Impact: Goals and capabilities without risk linkage represent:
  //   a) Blind spots in strategic planning—risks unknown or unmanaged
  //   b) Unvalidated constraint/regulatory exposure in capability design
  //   c) No risk mitigation accountability or contingency planning
  // This exposes the organization to strategic risks without active management or visibility.
  eachOfGroup(TYPES.GOAL.concat(TYPES.CAPABILITY), function (x) {
    if (
      !hasRelationToTypes(x, TYPES.RISK) &&
      !hasRelationToTypes(x, ["Constraint", "Requirement"])
    )
      markElement(x, "S.07");
  });

  heading(
    getHeadingString("S.08", "موارد راهبردی تکراری یا متعارض :نامهای متعارض")
  );
  // STRATEGIC CLARITY & GOVERNANCE: Goals must have unique, distinct identity to enable:
  // - Clear ownership and accountability assignment
  // - Unambiguous communication of strategic intent across the organization
  // - Portfolio rationalization and elimination of redundant initiatives
  // Misalignment Impact: Duplicate goals (same name/type) indicate:
  //   a) Uncoordinated strategy—multiple departments pursuing same goal independently
  //   b) Wasted resources and conflicting execution paths
  //   c) Confusion about strategic priority and portfolio coherence
  // This reflects poor governance and fragmented strategic direction.
  let goalNames = {};
  eachOfGroup(TYPES.GOAL, function (g) {
    let k = (safeType(g) + "::" + safeName(g)).toLowerCase();
    if (!goalNames[k]) goalNames[k] = [];
    goalNames[k].push(g);
  });
  Object.keys(goalNames).forEach(function (k) {
    if (goalNames[k].length > 1)
      goalNames[k].forEach(function (e) {
        markElement(e, "S.08");
      });
  });

  heading(getHeadingString("S.09", "راهبرد فاقد بازۀ زمانی یا اولویت است"));
  // STRATEGIC ROADMAP & EXECUTION PLANNING: Goals must specify timeframe and priority to enable:
  // - Sequenced execution and portfolio management
  // - Resource allocation aligned with strategic timing and importance
  // - Progress tracking and schedule compliance monitoring
  // Misalignment Impact: Goals without timeframe/priority metadata represent:
  //   a) Undefined execution sequencing—unclear what comes first or when
  //   b) Resource allocation confusion—no basis for prioritizing investments
  //   c) Indefinite commitment—no delivery accountability or milestone tracking
  // This prevents the enterprise from translating strategy into disciplined execution plans.
  eachOfGroup(TYPES.GOAL, function (g) {
    if (
      !hasAnyProp(g, [
        "timeframe",
        "priority",
        "due",
        "deadline",
        "target-date",
        "بازه زمانی",
        "اولویت",
        "مهلت",
        "مهلت زمانی",
        "تاریخ هدف",
      ])
    )
      markElement(g, "S.09");
  });

  heading(getHeadingString("S.10", "عناصر راهبرد فاقد مالک یا ذی‌نفع هستند"));
  // ACCOUNTABILITY & GOVERNANCE: Goals must have identified owner/sponsor to establish:
  // - Clear executive accountability for goal achievement
  // - Defined decision authority and escalation path
  // - Stakeholder engagement and cross-functional commitment
  // Misalignment Impact: Goals without owner/sponsor/accountable metadata indicate:
  //   a) No assigned accountability—no one responsible for goal delivery
  //   b) Decision paralysis—unclear who has authority to decide or adjust scope
  //   c) Weak stakeholder commitment—no named sponsor to champion goal
  // This creates orphaned goals with unclear governance and no one driving achievement.
  eachOfGroup(TYPES.GOAL, function (g) {
    if (!hasAnyProp(g, ["owner", "sponsor", "responsible", "accountable"]))
      markElement(g, "S.10");
  });

  // ============= NEW STRATEGIC PLANNING ALIGNMENT CHECKS (STR.61-STR.67) =============
  // From Research Paper 2
  // These checks validate strategic planning process completeness and driver-response alignment

  heading(getHeadingString("STR.61", "چشم‌انداز وجود دارد اما فاقد نگاشت مأموریت پشتیبان است"));
  // STRATEGIC PLANNING HIERARCHY: Vision elements must relate to mission to establish:
  // - Coherent strategic narrative from vision (aspirational) → mission (purpose) → goals (targets)
  // - Alignment between long-term aspiration and organizational purpose
  // - Strategic coherence in statement of strategic direction
  // Misalignment Impact: Vision without mission linkage indicates:
  //   a) Disconnected strategy—aspirational vision not grounded in organizational purpose
  //   b) Unclear strategic justification—why vision matters to organizational mission
  //   c) Weak strategic narrative—broken connection between aspiration and purpose
  // This represents a foundational break in strategic alignment.
  eachOfGroup(TYPES.GOAL, function (goal) {
    const goalName = safeName(goal);
    // Heuristic: if element name/doc contains "vision" and doesn't relate to mission
    if (
      goalName &&
      (goalName.toLowerCase().includes("vision") ||
        (goal.getDocumentation &&
          goal.getDocumentation().toLowerCase().includes("vision"))) &&
      !hasRelationToTypes(goal, ["Mission"])
    ) {
      markElement(goal, "STR.61");
    }
  });

  heading(
    getHeadingString("STR.62", "هدف راهبردی فاقد محرک یا انگیزۀ مرتبط است")
  );
  // STRATEGIC CAUSALITY & JUSTIFICATION: Goals must link to drivers/assessments to establish:
  // - Clear cause-and-effect reasoning for why goal exists
  // - Business justification tracing from external drivers to strategic response
  // - Impact analysis showing goal addresses specific business drivers
  // Misalignment Impact: Goals without driver linkage represent:
  //   a) Unjustified goals—unclear why organization is pursuing them
  //   b) Disconnected strategy—goals not grounded in business drivers or market analysis
  //   c) Weak strategic narrative—no evident causal link from drivers to strategic direction
  // This creates disconnect between external business environment and strategic response.
  eachOfGroup(TYPES.GOAL, function (goal) {
    // Strategic goals should have Driver relationships explaining motivation
    if (
      isAnyType(goal, ["Goal", "Strategic Goal"]) &&
      !hasRelationToTypes(goal, ["Driver", "Assessment"])
    ) {
      markElement(goal, "STR.62");
    }
  });

  heading(
    getHeadingString("STR.63", "هدف فاقد ارزیابی یا تحلیل نتیجۀ محرک است")
  );
  // STRATEGIC ANALYSIS RIGOR: Goals with drivers must have assessments to establish:
  // - Formal analysis of driver impact and strategic implications
  // - Documented business case and decision rationale
  // - Traceability from driver analysis to strategic goal selection
  // Misalignment Impact: Goals with drivers but without assessments indicate:
  //   a) Incomplete strategic analysis—drivers identified but not analyzed
  //   b) No documented business case—decision rationale unclear or missing
  //   c) Weak governance—no evidence that driver actually justified the goal
  // This reflects insufficient strategic rigor in linking drivers to goals.
  eachOfGroup(TYPES.GOAL, function (goal) {
    // If goal has Driver, it should also have Assessment documenting the analysis
    if (hasRelationToTypes(goal, ["Driver"])) {
      if (!hasRelationToTypes(goal, ["Assessment"])) {
        markElement(goal, "STR.63");
      }
    }
  });

  heading("قابلیت سازمانی از هیچیک از اهداف راهبردی پشتیبانی نمی‌کند");
  // CAPABILITY PORTFOLIO EFFICIENCY: All capabilities must support at least one goal/objective/initiative to ensure:
  // - Capability portfolio alignment with strategic priorities
  // - Elimination of non-strategic or obsolete capabilities
  // - Clear line-of-sight from capability investment to strategic value
  // Misalignment Impact: Orphaned capabilities (unsupported by any goal) indicate:
  //   a) Stranded investment—capabilities funded but not strategically justified
  //   b) Portfolio drift—legacy capabilities persisting without strategic rationale
  //   c) Wasted resources—capabilities maintained without clear business case
  // This represents inefficient capital allocation and portfolio waste.
  eachOfGroup(TYPES.CAPABILITY, function (cap) {
    // Capabilities should support goals; orphaned capabilities indicate waste
    if (
      !hasRelationToTypes(cap, TYPES.GOAL.concat(["Objective", "Initiative"]))
    ) {
      markElement(cap, "STR.64");
    }
  });

  heading(getHeadingString("STR.65", "عامل یا محرک خارجی توسط هیچ راهبردی مورد توجه قرار نگرفته است"));
  // DRIVER-TO-STRATEGY RESPONSIVENESS: All identified drivers/assessments must map to goals/strategies to ensure:
  // - Organizational response to external market/regulatory/competitive drivers
  // - No blind spots—identified drivers are actively addressed strategically
  // - Business agility—organization responds to changing business environment
  // Misalignment Impact: Drivers without strategic goals indicate:
  //   a) Unaddressed business drivers—organization aware of driver but not responding
  //   b) Strategic gaps—identified opportunities or threats not incorporated in strategy
  //   c) Organizational inertia—external forces recognized but internal strategy stagnant
  // This reflects poor strategic responsiveness to business environment signals.
  eachOfGroup(["Driver", "Assessment"], function (driver) {
    // External drivers should trigger strategies or goals
    if (
      isAnyType(driver, ["Driver", "Assessment"]) &&
      !hasRelationToTypes(
        driver,
        TYPES.GOAL.concat(["Strategy", "Course of Action"])
      )
    ) {
      markElement(driver, "STR.65");
    }
  });

  heading("منبع یا قابلیت توسط هیچ هدف یا ابتکار راهبردی‌ای استفاده نشده است");
  // RESOURCE ALLOCATION EFFICIENCY: Resources must be allocated to strategic elements to ensure:
  // - All resource investments tied to strategic goals and initiatives
  // - No orphaned resources—everything justified by strategic need
  // - Visibility into total cost-of-strategy and resource consumption
  // Misalignment Impact: Unused resources indicate:
  //   a) Unallocated assets—resources available but not strategically applied
  //   b) Potential inefficiency—resources not flowing to strategic priorities
  //   c) Hidden capacity—potential for better resource utilization or redeployment
  // This represents undermanaged resource governance and potential waste.
  eachOfGroup(TYPES.RESOURCE, function (res) {
    // Resources should be allocated to goals/initiatives; unused resources are inefficient
    if (
      !hasRelationToTypes(
        res,
        TYPES.GOAL.concat(["Objective", "Initiative", "Capability", "Strategy"])
      )
    ) {
      markElement(res, "STR.66");
    }
  });

  // STR.67 is non-analyzable (requires domain knowledge of competitive claims)
  // Typically detected through manual review or metadata analysis
  // Skeleton included for completeness but not auto-detected

  // ==================================================================================

  // ---------------- BUSINESS / PROCESS (B.11-B.20) ----------------

  heading(getHeadingString("B.11", "فرآیند بدون مالک"));
  // PROCESS ACCOUNTABILITY & GOVERNANCE: Processes must have assigned owners to establish:
  // - Clear ownership and accountability for process performance and compliance
  // - Defined escalation path for process issues or improvements
  // - Single point of authority for process governance and change decisions
  // Misalignment Impact: Processes without owner/responsible assignment indicate:
  //   a) Orphaned processes—no one accountable for performance or compliance
  //   b) Ownership ambiguity—unclear who has authority to decide on process changes
  //   c) Compliance gaps—no identified steward for regulatory/control requirements
  // This creates governance blind spots and unclear process accountability.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (
      !hasAnyProp(p, ["owner", "responsible", "RACI", "steward", "custodian"])
    )
      markElement(p, "B.11");
  });

  heading(
    getHeadingString("B.12", "فرآیند از هیچ موجودیت داده‌ای بهره نمی‌گیرد")
  );
  // PROCESS-DATA COUPLING: Processes must interact with data entities to establish:
  // - Clear data dependencies and information flow in business processes
  // - Data governance ownership (data is consumed/produced by processes)
  // - Complete process specification including data consumption/generation
  // Misalignment Impact: Processes without data relationships indicate:
  //   a) Incomplete process specification—data flows not modeled
  //   b) Data governance blind spot—unclear who owns/manages data the process uses
  //   c) Integration gaps—process data dependencies not documented for system design
  // This reflects incomplete business process modeling and data governance.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (!hasRelationToTypes(p, TYPES.DATA)) markElement(p, "B.12");
  });

  heading(getHeadingString("B.13", "فرآیند بدون پشتیبانی نرم‌افزاری"));
  // PROCESS-TO-APPLICATION ALIGNMENT: Business processes must map to supporting applications/services to ensure:
  // - Business processes are operationally supported by IT systems
  // - Clear accountability for process execution and monitoring
  // - Process automation roadmap and application portfolio justification
  // Misalignment Impact: Processes without application/service support indicate:
  //   a) Manual processes at risk—no IT support for business execution
  //   b) Application portfolio justification gap—unclear which apps support which processes
  //   c) Digitalization opportunity—process could be automated but isn't designed for it
  // This reflects incomplete business-IT alignment and potential process inefficiency.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (
      !hasRelationToTypes(p, TYPES.APPLICATION) &&
      !hasRelationToTypes(p, TYPES.SERVICE)
    )
      markElement(p, "B.13");
  });

  heading(getHeadingString("B.14", "تشخیص افزونگی به‌روش اکتشافی فرآیند یا همان تکرارهای دقیق نام"));
  // PROCESS PORTFOLIO RATIONALIZATION: Duplicate processes (same name/type) must be consolidated to enable:
  // - Process efficiency through elimination of redundancy
  // - Consistent process execution and quality across organization
  // - Simplified process governance and change management
  // Misalignment Impact: Duplicate processes indicate:
  //   a) Uncoordinated process design—same process implemented multiple times independently
  //   b) Operational inefficiency—duplicated work, training, support across units
  //   c) Quality/compliance risk—divergent implementations of same process
  // This reflects poor process governance and portfolio management.
  let procMap = {};
  eachOfGroup(TYPES.PROCESS, function (p) {
    let k = safeType(p) + "::" + (safeName(p) || "").toLowerCase();
    if (!procMap[k]) procMap[k] = [];
    procMap[k].push(p);
  });
  Object.keys(procMap).forEach(function (k) {
    if (procMap[k].length > 1)
      procMap[k].forEach(function (e) {
        markElement(e, "B.14");
      });
  });

  heading(getHeadingString("B.15", "فرآیند بدون ورودی یا خروجی"));
  // PROCESS SPECIFICATION COMPLETENESS: Processes must define inputs/outputs (flows, data, interfaces) to establish:
  // - Complete process specification and clear boundaries
  // - Process interface contracts (what process consumes/produces)
  // - Integration points and system dependencies
  // Misalignment Impact: Processes without inputs/outputs indicate:
  //   a) Incomplete specification—process boundaries and interfaces undefined
  //   b) Integration ambiguity—unclear what data/systems process depends on
  //   c) Design gap—process not ready for application mapping or implementation
  // This reflects incomplete business process architecture and design.
  eachOfGroup(TYPES.PROCESS, function (p) {
    // check for flows to/from or data or application interfaces
    if (
      !hasRelationToTypes(p, [
        "Flow",
        "DataObject",
        "BusinessObject",
        "ApplicationInterface",
        "ApplicationComponent",
        "Service",
      ])
    )
      markElement(p, "B.15");
  });

  heading(getHeadingString("B.16", "فرآیند فاقد موافقت‌نامۀ سطح خدمات یا شاخص کلیدی عملکرد است"));
  // PROCESS PERFORMANCE MANAGEMENT: Processes must have SLAs or KPIs to establish:
  // - Clear performance expectations and accountability for process outcomes
  // - Operational metrics for continuous improvement and monitoring
  // - Service level commitments and quality standards
  // Misalignment Impact: Processes without SLA/KPI metrics indicate:
  //   a) No performance accountability—unclear what constitutes process success
  //   b) Measurement gap—process quality and efficiency not tracked or managed
  //   c) Improvement blindness—no baseline metrics to identify improvement opportunities
  // This reflects poor operational governance and process management discipline.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (
      !hasRelationToTypes(p, TYPES.OUTCOME) &&
      !hasRelationToTypes(p, ["Requirement"])
    )
      markElement(p, "B.16");
  });

  heading(getHeadingString("B.17", "فرآیند به فناوری منسوخ، از طریق برنامۀ کاربردی، وابسته است"));
  // TECHNOLOGY LIFECYCLE & OBSOLESCENCE MANAGEMENT: Processes must not depend on deprecated/obsolete technology to ensure:
  // - Process resilience and continuity through supported technology
  // - Proactive technology refresh planning and lifecycle management
  // - Risk mitigation against technology end-of-life and unsupported states
  // Misalignment Impact: Processes dependent on deprecated technology indicate:
  //   a) Continuity risk—process dependent on unsupported/end-of-life technology
  //   b) Technical debt accumulation—legacy technology carrying process business logic
  //   c) Modernization blind spot—process-technology coupling preventing tech refresh
  // This represents critical technology debt and business continuity risk.
  eachOfGroup(TYPES.PROCESS, function (p) {
    try {
      const rels = p.rels ? p.rels() : $(p).rels();
      rels.each(function (r) {
        const other = r.source === p ? r.target : r.source;
        if (isAnyType(other, TYPES.APPLICATION)) {
          // check app's hosting tech
          (other.rels ? other.rels() : $(other).rels()).each(function (r2) {
            const host = r2.source === other ? r2.target : r2.source;
            if (isAnyType(host, TYPES.TECHNOLOGY)) {
              const st =
                host.prop &&
                (host.prop("status") ||
                  host.prop("lifecycle") ||
                  host.prop("deprecated"));
                if (st && String(st).toLowerCase().indexOf("deprecated") >= 0)
                markElement(p, "B.17", null, safeName(host));
            }
          });
        }
      });
    } catch (e) {}
  });

  heading(getHeadingString("B.18", "فرآیند فاقد کنترل‌ها یا محدودیت‌ها است"));
  // PROCESS GOVERNANCE & COMPLIANCE: Processes must map to constraints/controls/policies to establish:
  // - Regulatory compliance and risk management integration in processes
  // - Clear constraints that bound process execution and decision-making
  // - Policy/control enforcement through process design
  // Misalignment Impact: Processes without constraints/controls indicate:
  //   a) Compliance blindness—process not explicitly governed by policy/control framework
  //   b) Risk exposure—process execution unbounded by regulatory/organizational constraints
  //   c) Design incompleteness—process controls not explicitly designed or traceable
  // This reflects weak governance integration and compliance risk.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (
      !hasRelationToTypes(p, ["Constraint", "Requirement", "Control", "Policy"])
    )
      markElement(p, "B.18");
  });

  heading(getHeadingString("B.19", "فرآیند به قابلیت نگاشت نشده است"));
  // PROCESS-CAPABILITY ALIGNMENT: Processes must map to capabilities to establish:
  // - Clear organizational capability structure that executes processes
  // - Capability investment justification through process portfolio
  // - Process-capability traceability for organizational design
  // Misalignment Impact: Processes without capability mapping indicate:
  //   a) Organizational structure misalignment—unclear which capability owns/executes process
  //   b) Capability investment justification gap—processes not linked to capability portfolio
  //   c) Design incomplete—process-organization structure coupling not defined
  // This reflects incomplete organizational architecture and capability design.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (!hasRelationToTypes(p, TYPES.CAPABILITY)) markElement(p, "B.19");
  });

  heading(
    getHeadingString("B.20", "فرآیند فاقد متادیتاهای بسامد یا آهنگ اجرا است")
  );
  // PROCESS EXECUTION SCHEDULING & FREQUENCY: Processes must define execution frequency/cadence to enable:
  // - Process scheduling and resource capacity planning
  // - Performance modeling and operational forecasting
  // - Workload distribution and SLA commitment definition
  // Misalignment Impact: Processes without frequency/cadence metadata indicate:
  //   a) Operational planning blindness—unclear how often process executes or timing
  //   b) Capacity planning gap—no basis for resource allocation or workload forecasting
  //   c) Incomplete specification—process operational parameters not defined
  // This reflects incomplete operational process design and capacity planning.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (!hasAnyProp(p, ["frequency", "cadence", "interval", "schedule"]))
      markElement(p, "B.20");
  });

  // ---------------- DATA (D.21-D.30) ----------------

  heading(
    getHeadingString("D.21", "موجودیت داده توسط هیچ فرآیندی استفاده نمی‌شود")
  );
  eachOfGroup(TYPES.DATA, function (d) {
    if (
      !hasRelationToTypes(d, TYPES.PROCESS) &&
      !hasRelationToTypes(d, TYPES.APPLICATION)
    )
      markElement(d, "D.21");
  });

  heading(
    getHeadingString("D.22", "موجودیت‌های دادۀ تکراری یا همپوشان، دارای نام یا نوع یکسان")
  );
  let dataMap = {};
  eachOfGroup(TYPES.DATA, function (d) {
    let k = safeType(d) + "::" + (safeName(d) || "").toLowerCase();
    if (!dataMap[k]) dataMap[k] = [];
    dataMap[k].push(d);
  });
  Object.keys(dataMap).forEach(function (k) {
      if (dataMap[k].length > 1)
      dataMap[k].forEach(function (e) {
        markElement(e, "D.22");
      });
  });

  heading(getHeadingString("D.23", "داده فاقد نگاشتِ چهار تابع بنیادینِ ذخیرۀ ماندگار (ایجاد، خواندن، روزآمدی و حذف) است"));
  // DATA LIFECYCLE OPERATIONS (CRUD): Data entities must define lifecycle operations (Create, Read, Update, Delete) to enable:
  // - Complete data lifecycle specification and stewardship
  // - Data management process design and responsibilities
  // - System design requirements and data access patterns
  // Misalignment Impact: Data without CRUD operation mapping indicate:
  //   a) Incomplete data specification—how data is created/updated/deleted not defined
  //   b) Stewardship gap—unclear who manages data throughout its lifecycle
  //   c) Design incomplete—data lifecycle and management processes not specified
  // This reflects incomplete data architecture and management specification.
  eachOfGroup(TYPES.DATA, function (d) {
    if (!hasAnyProp(d, ["create", "read", "update", "delete", "crud"]))
      markElement(d, "D.23");
  });

  heading(getHeadingString("D.24", "دادۀ حساس فاقد کنترل‌های امنیتی"));
  // DATA SECURITY & COMPLIANCE: Sensitive/confidential data must map to security controls to establish:
  // - Privacy and security governance for sensitive data
  // - Regulatory compliance (GDPR, HIPAA, etc.) alignment
  // - Encryption, access control, and audit requirements
  // Misalignment Impact: Sensitive data without security controls indicate:
  //   a) Compliance risk—sensitive data lacks defined security governance
  //   b) Privacy exposure—confidential data not protected by designed controls
  //   c) Regulatory violation risk—data protection obligations not addressed
  // This represents critical compliance and security risk exposure.
  eachOfGroup(TYPES.DATA, function (d) {
    const cls =
      d.prop &&
      (d.prop("classification") ||
        d.prop("sensitivity") ||
        d.prop("confidentiality"));
    if (cls && String(cls).toLowerCase().indexOf("sensi") >= 0) {
      if (
        !hasRelationToTypes(d, [
          "Constraint",
          "Control",
          "Requirement",
          "Policy",
        ])
      )
        markElement(d, "D.24");
    }
  });

  // SEC.85: Sensitive data without explicit security mapping to controls, access control or security components
  eachOfGroup(TYPES.DATA, function (d) {
    try {
      const cls = d.prop && (d.prop("classification") || d.prop("sensitivity") || d.prop("confidentiality") || d.prop("is_sensitive"));
      const isSens = cls && String(cls).toLowerCase().indexOf("sensi") >= 0;
      // Also check simple boolean-like tokens for is_sensitive
      const sensFlag = getPropBooleanValue(d, ["is_sensitive", "sensitive", "sensitivity"]);
      if (isSens || (sensFlag && sensFlag.truthy)) {
        const hasSecMap = hasRelationToTypes(d, ["Constraint", "Control", "Security", "AccessControl", "Authorization", "Policy"]);
        if (!hasSecMap) {
          markElement(d, "SEC.85", null, "داده حساس یافت شد اما نگاشت کنترل‌های امنیتی یا دسترسی وجود ندارد");
        }
      }
    } catch (e) {}
  });

  heading(
    getHeadingString("D.25", "داده توسط هیچیک از برنامه‌های کاربردی ذخیره نمی‌شود")
  );
  // DATA SYSTEM INFRASTRUCTURE: Data must be stored/managed by applications/repositories to establish:
  // - Clear system infrastructure for data persistence and access
  // - Data stewardship through system ownership assignment
  // - Data lifecycle and archival planning
  // Misalignment Impact: Data without application/repository support indicate:
  //   a) Infrastructure gap—data entity defined but no system manages/stores it
  //   b) Stewardship orphan—no application owner responsible for data
  //   c) Implementation incomplete—data architecture defined but infrastructure not aligned
  // This reflects incomplete data infrastructure and stewardship design.
  eachOfGroup(TYPES.DATA, function (d) {
    if (
      !hasRelationToTypes(d, TYPES.APPLICATION) &&
      !hasRelationToTypes(d, ["Repository", "Database", "Storage"])
    )
      markElement(d, "D.25");
  });

  heading(getHeadingString("D.26", "برنامۀ کاربردی از داده استفاده می‌کند، اما داده فاقد مالکِ کسب‌وکار است"));
  // DATA OWNERSHIP & STEWARDSHIP: All data, especially when used by applications, must have identified owner/custodian to establish:
  // - Clear business accountability for data quality and governance
  // - Defined data steward responsible for data lifecycle and compliance
  // - Business perspective on data value and management requirements
  // Misalignment Impact: Data used by applications without owner assignment indicate:
  //   a) Stewardship gap—data is consumed but no one owns/manages quality
  //   b) Compliance risk—no business owner accountable for data governance
  //   c) Quality blindness—data quality issues unowned and unresolved
  // This reflects critical data governance gap in active data assets.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    try {
      (a.rels ? a.rels() : $(a).rels()).each(function (r) {
        const other = r.source === a ? r.target : r.source;
        if (isAnyType(other, TYPES.DATA)) {
            if (!hasAnyProp(other, ["owner", "custodian", "steward"]))
            markElement(
              other,
              "D.26",
              null,
              "استفاده‌شده توسط: " + safeName(a)
            );
        }
      });
    } catch (e) {}
  });

  heading(getHeadingString("D.27", "تبار داده ناقص است"));
  // DATA LINEAGE & TRACEABILITY: Data entities must map to sources (origin data/processes) and consumers to establish:
  // - Complete data lineage and traceability for compliance and impact analysis
  // - Data quality root-cause analysis through source visibility
  // - Change impact assessment and data dependency management
  // Misalignment Impact: Data without lineage relationships indicate:
  //   a) Traceability gap—unclear where data originates or who consumes it
  //   b) Quality analysis blind spot—cannot trace quality issues to source
  //   c) Change management risk—data dependencies unknown, change impacts hidden
  // This reflects incomplete data architecture and governance visibility.
  eachOfGroup(TYPES.DATA, function (d) {
    let found = false;
    (d.rels ? d.rels() : $(d).rels()).each(function (r) {
      const other = r.source === d ? r.target : r.source;
      if (
        isAnyType(
          other,
          TYPES.DATA.concat(TYPES.PROCESS).concat(TYPES.APPLICATION)
        )
      )
        found = true;
    });
    if (!found)
      markElement(d, "D.27");
  });

  heading(getHeadingString("D.28", "نگهداشت داده‌ها تعریف نشده است"));
  // DATA LIFECYCLE & RETENTION MANAGEMENT: Data must have defined retention periods to establish:
  // - Compliance with data retention regulations and policies
  // - Storage cost optimization through archival/disposal policies
  // - Data lifecycle planning and records management
  // Misalignment Impact: Data without retention/TTL metadata indicate:
  //   a) Compliance risk—no defined retention period may violate regulations
  //   b) Storage waste—data accumulated indefinitely without retention policy
  //   c) Governance gap—data lifecycle and disposal not planned
  // This reflects incomplete data governance and lifecycle management.
  eachOfGroup(TYPES.DATA, function (d) {
    if (
      !hasAnyProp(d, ["retention", "retention_period", "ttl", "data_retention"])
    )
      markElement(d, "D.28");
  });

  heading(getHeadingString("D.29", "هیچ طبقه‌بندی داده‌ای وجود ندارد"));
  // DATA CLASSIFICATION & SENSITIVITY GOVERNANCE: Data must have classification/sensitivity levels to establish:
  // - Risk-based security and access control requirements
  // - Privacy and regulatory compliance framework (GDPR, HIPAA, etc.)
  // - Data handling and protection policy differentiation
  // Misalignment Impact: Absence of data classification indicate:
  //   a) Governance blindness—no framework for differentiating data sensitivity
  //   b) Compliance risk—cannot enforce regulatory protection requirements
  //   c) Security gap—identical protection for all data regardless of sensitivity
  // This reflects absence of foundational data governance framework.
  let anyClass = false;
  eachOfGroup(TYPES.DATA, function (d) {
    if (hasAnyProp(d, ["classification", "sensitivity", "confidentiality"]))
      anyClass = true;
  });
  if (!anyClass) {
    eachOfGroup(TYPES.DATA, function (d) {
      markElement(d, "D.29");
    });
  }

  heading(getHeadingString("D.30", "مالکیت داده تکراری یا متعارض است"));
  // DATA OWNERSHIP CLARITY & ACCOUNTABILITY: Data must have single, clear ownership to establish:
  // - Unambiguous accountability for data quality and lifecycle
  // - Clear escalation path for data governance decisions
  // - Conflict resolution mechanism for competing stewardship claims
  // Misalignment Impact: Data with multiple/conflicting owners indicate:
  //   a) Accountability ambiguity—unclear who is responsible for data quality
  //   b) Governance conflict—competing stewards may enforce conflicting policies
  //   c) Decision paralysis—unclear who can authorize data lifecycle changes
  // This reflects governance conflict and unclear data ownership structure.
  eachOfGroup(TYPES.DATA, function (d) {
    const owner =
      d.prop && (d.prop("owner") || d.prop("custodian") || d.prop("steward"));
    if (owner && String(owner).indexOf(",") >= 0)
      markElement(d, "D.30");
  });

  // ---------------- APPLICATION (A.31-A.40) ----------------

  heading(getHeadingString("A.31", "برنامۀ کاربردی هیچ نیاز کسب‌وکاری را پشتیبانی نمی‌کند"));
  // APPLICATION BUSINESS JUSTIFICATION: Applications must support business processes/capabilities/value to establish:
  // - Clear business case for application investment
  // - Application portfolio alignment with strategic priorities
  // - Justification for application maintenance and lifecycle decisions
  // Misalignment Impact: Applications without business support mapping indicate:
  //   a) Orphaned application—no clear business justification for existence
  //   b) Portfolio waste—application funded but not supporting business value
  //   c) Modernization decision gap—unclear whether to keep, replace, or retire application
  // This reflects weak application portfolio governance and value delivery tracking.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    if (
      !hasRelationToTypes(
        a,
        TYPES.PROCESS.concat(TYPES.CAPABILITY).concat(TYPES.VALUE)
      )
    )
      markElement(a, "A.31");
  });

  heading(getHeadingString("A.32", "تکرار برنامۀ کاربردی (نوع و نام یکسان)"));
  // APPLICATION PORTFOLIO RATIONALIZATION: Duplicate applications (same name/type) must be consolidated to enable:
  // - Application efficiency through elimination of redundancy
  // - Consistent business process support across organization
  // - Simplified application management and licensing costs
  // Misalignment Impact: Duplicate applications indicate:
  //   a) Uncoordinated procurement—same application deployed multiple times independently
  //   b) Operational waste—redundant licensing, support, training costs
  //   c) Data/process inconsistency—divergent application implementations cause business process variance
  // This reflects poor application portfolio governance and cost control.
  let appMap = {};
  eachOfGroup(TYPES.APPLICATION, function (a) {
    let k = safeType(a) + "::" + (safeName(a) || "").toLowerCase();
    if (!appMap[k]) appMap[k] = [];
    appMap[k].push(a);
  });
  Object.keys(appMap).forEach(function (k) {
    if (appMap[k].length > 1)
      appMap[k].forEach(function (e) {
        markElement(e, "A.32");
      });
  });

  heading(getHeadingString("A.33", "برنامۀ کاربردی حیاتی کسب‌وکار فاقد فناوری میزبانی است"));
  // CRITICAL APPLICATION INFRASTRUCTURE: Business-critical applications must have mapped hosting/infrastructure to ensure:
  // - Infrastructure resilience and business continuity for critical systems
  // - Capacity planning and performance SLA definition
  // - Disaster recovery and failover capability specification
  // Misalignment Impact: Critical applications without infrastructure mapping indicate:
  //   a) Continuity risk—critical business app lacks defined hosting infrastructure
  //   b) DR blindness—disaster recovery and failover not specified for critical systems
  //   c) Capacity blindness—infrastructure capacity/performance not planned for criticality
  // This represents critical business continuity and resilience risk.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    // if app marked critical or business-critical property but no node mapping
    const critical =
      a.prop &&
      (a.prop("critical") ||
        a.prop("business_criticality") ||
        a.prop("priority"));
    if (critical && !hasRelationToTypes(a, TYPES.TECHNOLOGY))
      markElement(a, "A.33");
  });

  heading(
    getHeadingString("A.34", "برنامۀ کاربردی فاقد متادیتاهای چرخۀ حیات است")
  );
  // APPLICATION LIFECYCLE MANAGEMENT: Applications must define lifecycle/status/roadmap to enable:
  // - Lifecycle stage visibility and modernization planning
  // - End-of-life planning and application renewal roadmap
  // - Version management and upgrade/patch scheduling
  // Misalignment Impact: Applications without lifecycle metadata indicate:
  //   a) EOL blindness—unclear when applications reach end-of-support
  //   b) Renewal gap—no modernization or retirement planning
  //   c) Risk exposure—outdated applications continue running without planned replacement
  // This reflects incomplete application portfolio lifecycle management.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    if (!hasAnyProp(a, ["lifecycle", "status", "roadmap", "eol", "version"]))
      markElement(a, "A.34");
  });

  heading(getHeadingString("A.35", "الگوریتم اکتشافی فناوری اطلاعات سایه‌ای (عدم حضور در پورتفولیو)"));
  // SHADOW IT VISIBILITY: All applications must be formally catalogued in portfolio to establish:
  // - Complete visibility into IT application landscape
  // - Shadow IT risks and governance accountability
  // - Compliance and security control over unauthorized systems
  // Misalignment Impact: Informal/uncatalogued applications indicate:
  //   a) Shadow IT risk—unauthorized systems running outside governance framework
  //   b) Compliance blindness—uncatalogued applications not subject to controls
  //   c) Portfolio incompleteness—true IT landscape unknown, governance decisions based on incomplete data
  // This represents material governance and security risk from uncontrolled systems.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    const official =
      a.prop &&
      (a.prop("official") || a.prop("in_portfolio") || a.prop("catalogue"));
    if (official && String(official).toLowerCase().indexOf("false") >= 0)
      markElement(
        a,
        "A.35",
        "برنامۀ کاربردی به‌شکل غیررسمی یا خارج از پورتفولیو علامت‌گذاری شده است (الگوریتم اکتشافی فناوری اطلاعات سایه‌ای)"
      );
  });

  heading(getHeadingString("A.36", "برنامۀ کاربردی فاقد نگاشت رابط، در محل یکپوشانی یکپارچه‌سازی، است"));
  // APPLICATION INTEGRATION COMPLETENESS: Applications with integration dependencies must have defined interfaces to establish:
  // - Complete integration specification and interaction contracts
  // - Integration risk assessment and API governance
  // - Data exchange and system coupling clarity
  // Misalignment Impact: Integrated applications without interface mapping indicate:
  //   a) Integration specification gap—how apps exchange data not explicitly designed
  //   b) Coupling blindness—application interdependencies not documented
  //   c) Integration risk—change impact on dependent systems unknown
  // This reflects incomplete integration architecture and interface governance.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    const hasIntegr = hasRelationToTypes(
      a,
      TYPES.APPLICATION.concat(TYPES.PROCESS).concat(TYPES.SERVICE)
    );
    const hasIface = hasRelationToTypes(a, [
      "ApplicationInterface",
      "Interface",
      "Flow",
    ]);
    if (hasIntegr && !hasIface) markElement(a, "A.36");
  });

  heading(
    getHeadingString("A.37", "برنامۀ کاربردی به فناوری منسوخ وابسته است")
  );
  // [DIMENSION]: Technical Debt & Platform Modernization Governance
  // Ensures/Enables:
  // - Risk-driven technology refresh planning based on EOL/deprecation awareness
  // - Modernization roadmap prioritization preventing critical dependency on obsolete platforms
  // - Vendor/platform support continuity and security patch availability assessment
  // Misalignment Impact: Applications dependent on deprecated technologies indicate:
  //   a) Unmanaged technical debt creating security vulnerabilities and support gaps
  //   b) Modernization blindness—lack of planned migration/replacement strategies
  //   c) Operational risk exposure through unsupported infrastructure and platform obsolescence
  // This reflects governance gaps in technology lifecycle management and application portfolio modernization planning.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    (a.rels ? a.rels() : $(a).rels()).each(function (r) {
      const other = r.source === a ? r.target : r.source;
      if (isAnyType(other, TYPES.TECHNOLOGY)) {
        const st =
          other.prop &&
          (other.prop("status") ||
            other.prop("lifecycle") ||
            other.prop("deprecated"));
        if (st && String(st).toLowerCase().indexOf("deprecated") >= 0)
          markElement(a, "A.37", null, safeName(other));
      }
    });
  });

  heading(getHeadingString("A.38", "برنامۀ کاربردی فاقد مالک یا متولّی است"));
  // [DIMENSION]: Application Governance & Accountability Assignment
  // Ensures/Enables:
  // - Clear ownership accountability enabling change management and operational decision rights
  // - Stewardship continuity and escalation clarity for operational issues and enhancements
  // - Business-IT alignment through designated application custodians accountable to business units
  // Misalignment Impact: Applications without assigned owners/custodians indicate:
  //   a) Accountability gaps leading to orphaned applications with unclear maintenance responsibility
  //   b) Operational chaos—unclear approval paths for changes, upgrades, or decommissioning
  //   c) Governance failure enabling uncontrolled shadow IT expansion and duplicate capability development
  // This reflects structural breakdown in portfolio governance and stewardship accountability.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    if (!hasAnyProp(a, ["owner", "custodian", "steward", "responsible"]))
      markElement(a, "A.38");
  });

  heading(getHeadingString("A.39", "برنامۀ کاربردی فاقد اطلاعات مجوز یا هزینۀ اجرا است"));
  // [DIMENSION]: Financial & Licensing Governance
  // Ensures/Enables:
  // - Total cost of ownership (TCO) transparency for investment decisions and portfolio rationalization
  // - Licensing compliance governance preventing audit risk and contractual violations
  // - Cost attribution accuracy enabling chargeback/showback and business case validation
  // Misalignment Impact: Applications lacking license/cost metadata indicate:
  //   a) Financial blindness—inability to assess true application costs and ROI justification
  //   b) Compliance risk through unlicensed/untracked software potentially violating vendor agreements
  //   c) Portfolio irrationality—cost-benefit analysis impossible for retention vs. replacement decisions
  // This reflects financial governance breakdown preventing data-driven application investment decisions.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    if (!hasAnyProp(a, ["license", "cost", "run_cost", "tco", "subscription"]))
      markElement(a, "A.39");
  });

  heading(getHeadingString("A.40", "نام‌گذاری برنامۀ کاربردی ناسازگار است"));
  // [DIMENSION]: Portfolio Clarity & Application Naming Standards
  // Ensures/Enables:
  // - Portfolio visibility and searchability through consistent application naming conventions
  // - Status classification clarity preventing confusion between production and temporary systems
  // - Governance enforcement through naming standards making provisional/prototype status explicit
  // Misalignment Impact: Applications with inconsistent/ambiguous names (temp, prototype, sandbox) indicate:
  //   a) Portfolio blindness—unclear distinction between production systems and temporary/test systems
  //   b) Governance leakage—"temporary" systems often becoming permanent, orphaned shadows in production
  //   c) Architecture clarity gaps preventing clear status visibility for deployment, support, and retirement planning
  // This reflects breakdown in application naming discipline undermining portfolio governance transparency.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    const n = (safeName(a) || "").toLowerCase();
    if (
      n.indexOf("temp") >= 0 ||
      n.indexOf("prototype") >= 0 ||
      n.indexOf("sandbox") >= 0
    )
      markElement(a, "A.40");
  });

  // ---------------- TECHNOLOGY / INFRASTRUCTURE (T.41-T.48) ----------------

  heading(
    getHeadingString("T.41", "فناوری منسوخ هنوز مورد استفاده واقع می‌شود")
  );
  // [DIMENSION]: Technology Lifecycle & End-of-Life Management Governance
  // Ensures/Enables:
  // - Proactive technology refresh planning based on vendor support/EOL timelines
  // - Risk reduction through managed deprecation preventing critical infrastructure becoming unsupported
  // - Compliance continuity and security update availability for active hosting/processes
  // Misalignment Impact: Deprecated technologies hosting applications/processes indicate:
  //   a) Support gap risk—obsolete technologies with no vendor patches, updates, or security fixes
  //   b) Operational blindness—unclear migration paths or renewal timelines creating legacy lock-in
  //   c) Architecture decay—technology landscape calcifying around obsolete, unmaintainable platforms
  // This reflects governance failure in technology lifecycle management and planned infrastructure obsolescence.
  eachOfGroup(TYPES.TECHNOLOGY, function (t) {
    const st =
      t.prop &&
      (t.prop("status") || t.prop("lifecycle") || t.prop("deprecated"));
    if (st && String(st).toLowerCase().indexOf("deprecated") >= 0) {
      // if hosting or mapped to app/process
      if (
        hasRelationToTypes(t, TYPES.APPLICATION) ||
        hasRelationToTypes(t, TYPES.PROCESS)
      )
        markElement(t, "T.41");
    }
  });

  heading(getHeadingString("T.42", "نقطۀ تکی شکست (گره از برنامه‌های حیاتی بدون افزونگی پشتیبانی می‌کند)"));
  // [DIMENSION]: Business Continuity & Infrastructure Resilience Governance
  // Ensures/Enables:
  // - Disaster recovery capability through identified redundancy/failover for critical infrastructure
  // - Continuity of mission-critical services preventing total outage from single infrastructure failure
  // - Risk-based investment in high-availability architecture for critical dependencies
  // Misalignment Impact: Critical applications dependent on single, non-redundant infrastructure indicate:
  //   a) Business continuity risk—complete service outage from single component failure with no failover
  //   b) Resilience blindness—lack of redundancy planning for systems requiring high availability
  //   c) Operational exposure—critical business functions dependent on unmitigated single points of failure
  // This reflects governance gap in infrastructure resilience and critical service continuity planning.
  eachOfGroup(TYPES.TECHNOLOGY, function (n) {
    let appCount = 0;
    let criticalFound = false;
    (n.rels ? n.rels() : $(n).rels()).each(function (r) {
      const other = r.source === n ? r.target : r.source;
      if (isAnyType(other, TYPES.APPLICATION)) {
        appCount++;
        const crit =
          other.prop &&
          (other.prop("critical") ||
            other.prop("business_criticality") ||
            other.prop("priority"));
        if (
          crit &&
          (String(crit).toLowerCase().indexOf("high") >= 0 ||
            String(crit).toLowerCase().indexOf("critical") >= 0)
        )
          criticalFound = true;
      }
    });
    if (criticalFound && appCount <= 1)
      markElement(
        n,
        "T.42",
        "نقطۀ تکی شکست: میزبان برنامه‌های حیاتی بدون افزونگی است"
      );
  });

  heading(
    getHeadingString("T.43", "فناوری فاقد نگاشت اضافی یا پشتیبان است")
  );
  // [DIMENSION]: Infrastructure Redundancy & Resilience Architecture Documentation
  // Ensures/Enables:
  // - Explicit documentation of backup/failover strategies enabling recovery planning
  // - Identification of infrastructure configuration for disaster recovery and business continuity
  // - Clarity on high-availability architecture supporting critical service requirements
  // Misalignment Impact: Technology assets lacking redundancy/backup relationship mapping indicate:
  //   a) Resilience invisibility—unclear which infrastructure is deployed for backup, replication, or clustering
  //   b) Recovery blindness—absence of explicit failover/failback topology in enterprise architecture
  //   c) Architecture confusion—redundancy may exist operationally but remains undocumented in EA models
  // This reflects governance gaps in infrastructure resilience documentation and backup architecture visibility.
  eachOfGroup(TYPES.TECHNOLOGY, function (t) {
    if (
      !hasRelationToTypes(t, [
        "Redundancy",
        "Backup",
        "Cluster",
        "Replica",
        "Failover",
        "Replication",
      ])
    )
      markElement(t, "T.43");
  });

  heading(
    getHeadingString("T.44", "برنامۀ کاربردی از سکوی پشتیبانی‌نشده استفاده می‌کند")
  );
  // [DIMENSION]: Platform Support & Vendor Lifecycle Governance
  // Ensures/Enables:
  // - Application hosting on supported, maintained platforms with active vendor security/support
  // - Risk reduction through end-of-life platform identification and migration planning
  // - Compliance capability through platforms receiving vendor patches and regulatory updates
  // Misalignment Impact: Applications hosted on unsupported platforms indicate:
  //   a) Security risk exposure—platforms without vendor support unable to receive security patches/updates
  //   b) Compliance blindness—regulations requiring current platform support potentially unmet
  //   c) Operational liability—unsupported platforms creating vendor lock-in with no path forward
  // This reflects governance failure in platform lifecycle management and supported infrastructure policy.
  eachOfGroup(TYPES.APPLICATION, function (a) {
    (a.rels ? a.rels() : $(a).rels()).each(function (r) {
      const host = r.source === a ? r.target : r.source;
      if (isAnyType(host, TYPES.TECHNOLOGY)) {
        const sup =
          host.prop &&
          (host.prop("supported") ||
            host.prop("support_status") ||
            host.prop("eol"));
        if (
          sup &&
          (String(sup).toLowerCase().indexOf("no") >= 0 ||
            String(sup).toLowerCase().indexOf("unsupported") >= 0)
        )
          markElement(
            a,
            "T.44",
            "برنامۀ کاربردی بر روی سکوی پشتیبانی‌نشده میزبانی می‌شود",
            safeName(host)
          );
      }
    });
  });

  heading(getHeadingString("T.45", "فناوری فاقد استانداردها یا محدودیت‌های حاکمیتی است"));
  // [DIMENSION]: Technology Governance & Standards Compliance
  // Ensures/Enables:
  // - Policy/standard enforcement ensuring technology choices align with enterprise governance
  // - Constraint/requirement visibility clarifying regulatory, architectural, or operational requirements
  // - Governance accountability through explicit standard relationships and compliance status
  // Misalignment Impact: Technologies lacking standard/policy/constraint mappings indicate:
  //   a) Governance invisibility—unclear whether technology is approved, compliant, or constrained
  //   b) Standards drift—technologies operating without documented policy/requirement alignment
  //   c) Compliance exposure—technologies potentially violating enterprise architecture governance without detection
  // This reflects breakdown in technology governance enforcement and standards compliance visibility.
  eachOfGroup(TYPES.TECHNOLOGY, function (t) {
    if (
      !hasRelationToTypes(t, [
        "Standard",
        "Policy",
        "Constraint",
        "Requirement",
        "Guideline",
      ])
    )
      markElement(t, "T.45");
  });

  heading(
    getHeadingString("T.46", "دارایی فناوری فاقد متادیتاهای چرخۀ حیات است")
  );
  // [DIMENSION]: Technology Asset Lifecycle & Deprecation Governance
  // Ensures/Enables:
  // - End-of-life visibility enabling proactive refresh and renewal planning
  // - Retirement date clarity supporting lifecycle roadmaps and investment decisions
  // - Status transparency identifying growth, maintenance, or deprecation phases for each asset
  // Misalignment Impact: Technology assets without lifecycle/status/EOL metadata indicate:
  //   a) Planning blindness—no visibility into asset age, maturity phase, or planned retirement
  //   b) Renewal risk—obsolescence approaching without planned replacement or upgrade strategies
  //   c) Portfolio decay—technology landscape unclear on which assets require investment vs. retirement
  // This reflects governance gaps in technology asset lifecycle documentation and roadmap clarity.
  eachOfGroup(TYPES.TECHNOLOGY, function (t) {
    if (!hasAnyProp(t, ["lifecycle", "status", "eol", "retirement_date"]))
      markElement(
        t,
        "T.46",
        "Technology asset missing lifecycle/status metadata"
      );
  });

  heading(getHeadingString("T.47", "دارایی فناوری فاقد متادیتاهای چرخۀ حیات یا وضعیت است"));
  // [DIMENSION]: Security & Sensitive Infrastructure Control Governance
  // Ensures/Enables:
  // - Risk mitigation through identified control/constraint relationships for sensitive infrastructure
  // - Security posture clarity showing encryption, firewall, or policy protection for critical assets
  // - Compliance governance through documented security constraints aligned to sensitive data handling
  // Misalignment Impact: Sensitive/highly-classified infrastructure lacking control mappings indicate:
  //   a) Security blindness—critical assets operating without documented protective controls/constraints
  //   b) Exposure risk—sensitive infrastructure protected operationally but not documented in architecture
  //   c) Compliance gap—regulatory requirements for control implementation unverified in EA models
  // This reflects governance failure in sensitive infrastructure control governance and security architecture visibility.
  eachOfGroup(TYPES.TECHNOLOGY, function (t) {
    const sens = t.prop && (t.prop("sensitivity") || t.prop("classification"));
    if (sens && String(sens).toLowerCase().indexOf("high") >= 0) {
      if (
        !hasRelationToTypes(t, [
          "Control",
          "Constraint",
          "Policy",
          "Firewall",
          "Encryption",
        ])
      )
        markElement(t, "T.47");
    }
  });

  heading(getHeadingString("T.48", "زیرساخت فاقد نگاشت سرویس است"));
  // [DIMENSION]: Service-to-Infrastructure Traceability & Architecture Alignment
  // Ensures/Enables:
  // - Impact analysis clarity—understanding which services/applications depend on infrastructure assets
  // - Change management transparency showing blast radius for infrastructure changes/failures
  // - End-to-end architecture traceability from business services through applications to infrastructure
  // Misalignment Impact: Infrastructure elements lacking application/service/process mappings indicate:
  //   a) Dependency blindness—unclear which critical services depend on this infrastructure asset
  //   b) Change impact risk—infrastructure changes made without understanding affected services/applications
  //   c) Architecture disconnection—infrastructure orphaned from business/application layer alignment models
  // This reflects governance failure in infrastructure service mapping and end-to-end architecture traceability.
  eachOfGroup(TYPES.TECHNOLOGY, function (i) {
    if (
      !hasRelationToTypes(
        i,
        TYPES.APPLICATION.concat(TYPES.SERVICE).concat(TYPES.PROCESS)
      )
    )
      markElement(
        i,
        "T.48",
        "عنصر زیرساخت به برنامه‌ها، سرویس‌ها یا فرآیندها متصل نشده است"
      );
  });

  // ---------------- CROSS-LAYER (X.49-X.60) ----------------

  heading(getHeadingString("X.49", "ردیابی سرتاسری مختل شده است (هدف ↞  قابلیت ↞  فرآیند ↞ برنامۀ کاربردی)"));
  // [DIMENSION]: End-to-End Business-to-IT Traceability Architecture
  // Ensures/Enables:
  // - Complete traceability chain from strategic goals → capabilities → processes → applications
  // - Impact analysis clarity showing how business changes flow through IT implementation layers
  // - Strategic alignment validation across all organizational layers (strategy/capability/operations/IT)
  // Misalignment Impact: Broken or missing traceability chains indicate:
  //   a) Strategy-execution disconnect—goals defined but unlinked to operational capabilities/processes
  //   b) Impact analysis blindness—unable to trace business changes through IT implementation
  //   c) Architecture fragmentation—organizational layers operating independently without connection
  // This reflects governance failure in end-to-end enterprise architecture alignment and traceability.
  eachOfGroup(TYPES.GOAL, function (g) {
    if (!hasRelationToTypes(g, TYPES.CAPABILITY))
      markElement(g, "X.49");
    else {
      // ensure capabilities connected to processes and apps
      try {
        (g.rels ? g.rels() : $(g).rels()).each(function (r) {
          const cap = r.source === g ? r.target : r.source;
          if (isAnyType(cap, TYPES.CAPABILITY)) {
            if (
              !hasRelationToTypes(cap, TYPES.PROCESS) ||
              !hasRelationToTypes(cap, TYPES.APPLICATION)
            )
              markElement(
                cap,
                "X.49",
                "قابلیت به هدف متصل شده است اما فاقد اتصال به فرآیند یا برنامۀ کاربردی است"
              );
          }
        });
      } catch (e) {}
    }
  });

  heading(getHeadingString("X.50", "جریان‌های ارزش توسط فرآیندها یا فناوری اطلاعات پشتیبانی نشده‌اند"));
  // [DIMENSION]: Value Stream Operational & IT Support Realization
  // Ensures/Enables:
  // - Complete operational realization of value streams through process and application capability
  // - Value creation path visibility from strategic intent through business execution to IT delivery
  // - Investment justification linking IT systems to measurable value stream outcomes
  // Misalignment Impact: Value streams without process/IT support indicate:
  //   a) Value realization gap—value streams defined strategically but operationally unsupported
  //   b) Investment justification blind spot—IT systems unlinked to explicit value creation
  //   c) Execution blind spot—unclear how value streams actually execute through business/IT systems
  // This reflects governance failure in value stream operationalization and IT value alignment.
  eachOfGroup(["ValueStream", "ValueStage"], function (dummy) {
    // iterate value streams
    try {
      $(model)
        .find("value-stream")
        .each(function (v) {
          if (
            !hasRelationToTypes(v, TYPES.PROCESS) &&
            !hasRelationToTypes(v, TYPES.SERVICE) &&
            !hasRelationToTypes(v, TYPES.APPLICATION)
          )
            markElement(v, "X.50");
        });
      $(model)
        .find("value-stage")
        .each(function (v) {
          if (
            !hasRelationToTypes(v, TYPES.PROCESS) &&
            !hasRelationToTypes(v, TYPES.SERVICE) &&
            !hasRelationToTypes(v, TYPES.APPLICATION)
          )
            markElement(v, "X.50");
        });
    } catch (e) {}
  });

  heading(getHeadingString("X.51", "الزامات قانونی و نظارتی انطباق سرگردان هستند"));
  // [DIMENSION]: Regulatory & Compliance Requirements Alignment & Implementation
  // Ensures/Enables:
  // - Explicit traceability from regulatory requirements → control implementation → operational processes
  // - Compliance governance visibility showing which systems/processes enforce requirements
  // - Audit trail clarity demonstrating requirement satisfaction through architecture
  // Misalignment Impact: Requirements without implementation mappings indicate:
  //   a) Compliance gap—regulatory requirements defined but implementation unmapped
  //   b) Control blindness—unclear which processes/systems enforce compliance requirements
  //   c) Audit exposure—compliance claims not traceable through documented architecture
  // This reflects governance failure in compliance requirement operationalization.
  eachOfGroup(TYPES.REQUIREMENT.concat(TYPES.CONSTRAINT), function (r) {
    if (
      !hasRelationToTypes(r, ["Control", "Process", "Service", "Application"])
    )
      markElement(r, "X.51");
  });

  heading(getHeadingString("X.52", "قابلیت از اهداف پشتیبانی می‌کند اما توسط فناوری اطلاعات پشتیبانی نمی‌شود"));
  // [DIMENSION]: Capability-to-IT Implementation Gap & Portfolio Alignment
  // Ensures/Enables:
  // - Complete capability realization through identified IT systems/applications/services
  // - Strategic capability ownership clarity—which IT systems deliver which capabilities
  // - IT portfolio justification through explicit capability delivery mapping
  // Misalignment Impact: Strategic capabilities without IT support indicate:
  //   a) Implementation gap—capability defined strategically but IT delivery unplanned
  //   b) Portfolio orphan—capability required to deliver goals but IT solution unmapped
  //   c) Investment blindness—unclear which IT investments deliver which capabilities
  // This reflects governance failure in capability-to-IT implementation planning.
  eachOfGroup(TYPES.CAPABILITY, function (c) {
    if (
      hasRelationToTypes(c, TYPES.GOAL) &&
      !hasRelationToTypes(c, TYPES.APPLICATION) &&
      !hasRelationToTypes(c, TYPES.SERVICE)
    )
      markElement(c, "X.52");
  });

  heading(getHeadingString("X.53", "عملکردهای کسب‌وکار از داده‌هایی استفاده می‌کنند که هیچ برنامه‌ای ارائه نمی‌دهد"));
  // [DIMENSION]: Data Provisioning Gap & Business-Data-IT Coupling
  // Ensures/Enables:
  // - Data availability certainty—business processes guaranteed data from IT infrastructure
  // - Data supply chain clarity showing which applications/repositories provide process data
  // - Process continuity assurance through mapped data infrastructure support
  // Misalignment Impact: Business processes depending on unmapped data indicate:
  //   a) Data supply gap—process requires data not provided by any IT system
  //   b) Infrastructure blindness—data dependencies not grounded in actual IT capabilities
  //   c) Operational risk—process may fail due to missing data provisioning
  // This reflects governance failure in data supply chain and process infrastructure support planning.
  eachOfGroup(TYPES.PROCESS, function (f) {
    (f.rels ? f.rels() : $(f).rels()).each(function (r) {
      const other = r.source === f ? r.target : r.source;
      if (isAnyType(other, TYPES.DATA)) {
        if (
          !hasRelationToTypes(other, TYPES.APPLICATION) &&
          !hasRelationToTypes(other, ["Repository", "Database", "Storage"])
        )
          markElement(f, "X.53", null, safeName(other));
      }
    });
  });

  heading(
    getHeadingString("X.54", "فعالیت‌های عملیاتی فاقد شاخص‌های کلیدی عملکرد هستند")
  );
  // [DIMENSION]: Process Performance Management & Operational Governance
  // Ensures/Enables:
  // - Process performance accountability through defined KPIs and SLAs
  // - Continuous improvement visibility and monitoring baseline establishment
  // - Operational governance clarity showing process success metrics and targets
  // Misalignment Impact: Processes without KPI/SLA definitions indicate:
  //   a) Accountability gap—no defined performance expectations for process execution
  //   b) Quality blindness—no metrics to detect process failures or quality degradation
  //   c) Improvement invisibility—no baseline to measure process improvements against
  // This reflects operational governance failure and unmeasured process performance.
  eachOfGroup(TYPES.PROCESS, function (p) {
    if (
      !hasRelationToTypes(p, TYPES.OUTCOME) &&
      !hasRelationToTypes(p, ["KPI", "SLA", "Metric"])
    )
      markElement(p, "X.54");
  });

  heading(getHeadingString("X.55", "سرویس‌ها فاقد توافقنامۀ سطح خدمات یا ملک هستند"));
  // [DIMENSION]: Service Level Governance & Service Ownership Accountability
  // Ensures/Enables:
  // - Service performance expectations clarity through SLAs/KPIs
  // - Service ownership accountability through identified service stewards/custodians
  // - Service quality governance and service delivery management framework
  // Misalignment Impact: Services without SLAs or ownership indicate:
  //   a) Performance blindness—no service level expectations or quality standards defined
  //   b) Accountability gap—unclear who owns/manages service delivery and quality
  //   c) Governance void—services operating without defined performance or management structure
  // This reflects governance failure in service level management and ownership clarity.
  eachOfGroup(TYPES.SERVICE, function (s) {
    const hasSLA = hasRelationToTypes(s, ["SLA", "KPI", "Metric", "Requirement"]);
    if (!hasSLA || !hasAnyProp(s, ["owner", "custodian", "responsible"]))
      markElement(s, "X.55");
  });

  heading(getHeadingString("EV.90", "خدمات ناهمگام اعلام‌شده اما ساختار کارگزار پیام وجود ندارد"));
  eachOfGroup(TYPES.SERVICE, function (s) {
    try {
      const asyncProp = getPropBooleanValue(s, ["async", "asynchronous", "is_async", "evented", "event_driven"]);
      if (asyncProp && asyncProp.truthy) {
        // If service is async but no message broker/event bus/queue present, flag EV.90
        const hasBroker = hasRelationToTypes(s, ["MessageBroker", "EventBus", "MessageQueue", "Queue", "Broker"]);
        if (!hasBroker) {
          const doc = "async=true but no relation to MessageBroker/EventBus/Queue found" + (asyncProp.key ? ' (' + asyncProp.key + '=' + asyncProp.val + ')' : '');
          markElement(s, "EV.90", null, doc);
        }
      }
    } catch (e) {}
  });

  heading(getHeadingString("X.56", "نگاشت از تأثیر تغییرات مفقود است (ابتکار ↞ عناصر تأثیرپذیر)"));
  // [DIMENSION]: Change Impact Analysis & Governance
  // Ensures/Enables:
  // - Impact traceability showing which business/IT elements are affected by change initiatives
  // - Risk mitigation through blast radius visibility and downstream dependency analysis
  // - Change governance clarity demonstrating change justification through affected architecture
  // Misalignment Impact: Change initiatives without impact mapping indicate:
  //   a) Impact blindness—unclear which business/IT elements will be affected by change
  //   b) Governance gap—change initiatives proceeding without understanding architecture impact
  //   c) Risk exposure—unplanned dependencies affected by change may fail
  // This reflects governance failure in change impact management and risk assessment.
  // heuristic: find WorkPackage/Deliverable/ImplementationEvent/Plateau named as initiative/change
  eachOfGroup(TYPES.WORK, function (w) {
    const nm = (safeName(w) || "").toLowerCase();
    if (
      nm.indexOf("change") >= 0 ||
      nm.indexOf("initiative") >= 0 ||
      nm.indexOf("epic") >= 0
    ) {
      if (
        !hasRelationToTypes(
          w,
          TYPES.APPLICATION.concat(TYPES.PROCESS).concat(TYPES.CAPABILITY)
        )
      )
        markElement(
          w,
          "X.56",
          "تغییر/اقدام فاقد نگاشت تأثیر بر برنامه‌ها، فرآیندها یا قابلیت‌ها است"
        );
    }
  });

  heading(getHeadingString("X.57", "ریسک‌های تأمین‌کننده یا فروشنده به کاربرد مرتبط نشده‌اند"));
  // [DIMENSION]: Vendor/Supplier Risk Governance & Business Continuity
  // Ensures/Enables:
  // - Vendor risk visibility through mapped contracts/supplier relationships
  // - Business continuity planning incorporating vendor criticality and dependency assessment
  // - Supplier governance clarity enabling vendor performance and risk management
  // Misalignment Impact: Vendor contracts/supplier risks without business/IT mapping indicate:
  //   a) Supplier blindness—critical vendors/contracts not linked to dependent business/IT systems
  //   b) Continuity risk—vendor criticality and business impact not understood
  //   c) Governance gap—vendor performance and risk not actively managed against business needs
  // This reflects governance failure in vendor risk management and supplier business continuity.
  // best-effort: look for Contract elements or elements explicitly marked as vendor
  eachOfGroup(
    ["Contract", "Location", "Resource", "BusinessObject"],
    function (dummy) {
      // iterate contracts, resources and check linkages
      try {
        $(model)
          .find("contract")
          .each(function (c) {
            if (
              !hasRelationToTypes(
                c,
                TYPES.APPLICATION.concat(TYPES.SERVICE).concat(TYPES.PROCESS)
              )
            )
                  markElement(
                    c,
                    "X.57"
                  );
          });
      } catch (e) {}
    }
  );

  heading(getHeadingString("X.58", "وابستگی‌های سرویس در لایه‌های مختلف مستندسازی نشده است"));
  // [DIMENSION]: Cross-Layer Service Dependency & Integration Architecture
  // Ensures/Enables:
  // - Complete service architecture visibility from business services → applications → infrastructure
  // - Dependency management clarity showing service coupling across architectural layers
  // - Impact analysis traceability for service changes across implementation layers
  // Misalignment Impact: Services lacking cross-layer dependency mappings indicate:
  //   a) Architecture blindness—service dependencies across business/IT layers undocumented
  //   b) Integration gaps—services decoupled from implementation systems in architecture models
  //   c) Change risk—service changes may have unknown impact on dependent systems
  // This reflects governance failure in service architecture documentation and dependency management.
  eachOfGroup(TYPES.SERVICE, function (s) {
    if (
      !hasRelationToTypes(
        s,
        TYPES.APPLICATION.concat(TYPES.TECHNOLOGY).concat(TYPES.PROCESS)
      )
    )
      markElement(s, "X.58");
  });

  heading(
    getHeadingString("X.59", "نگاشت تداوم کسب‌وکار وجود ندارد")
  );
  // [DIMENSION]: Business Continuity Planning & Disaster Recovery Architecture
  // Ensures/Enables:
  // - Complete continuity mapping showing which systems/infrastructure support critical processes
  // - Disaster recovery planning clarity through documented backup/recovery infrastructure
  // - Business criticality alignment showing which processes have continuity provisions
  // Misalignment Impact: Business processes without continuity/recovery/backup mappings indicate:
  //   a) Continuity blindness—critical processes lack defined disaster recovery or backup strategies
  //   b) Recovery risk—undefined recovery time objectives (RTO) and recovery point objectives (RPO)
  //   c) Governance gap—business continuity not integrated with architecture and IT planning
  // This reflects governance failure in business continuity planning and resilience architecture.
  eachOfGroup(TYPES.PROCESS, function (p) {
            if (
      !hasRelationToTypes(p, [
        "Continuity",
        "BCP",
        "Recovery",
        "Backup",
        "SLA",
        "Disaster",
      ])
    )
      markElement(p, "X.59");
  });

  heading(getHeadingString("X.60", "قابلیت حیاتی فاقد نتیجه یا هدف قابل اندازه‌گیری است"));
  // [DIMENSION]: Critical Capability Outcome & Measurable Value Definition
  // Ensures/Enables:
  // - Outcome clarity showing measurable business results from critical capabilities
  // - Value definition and success metrics for high-priority organizational capabilities
  // - Capability ROI justification through defined targets and measurable outcomes
  // Misalignment Impact: Critical capabilities without outcome/KPI/target definitions indicate:
  //   a) Success blindness—unclear what critical capability must achieve or how to measure it
  //   b) Value gap—critical investment made without defined success metrics or targets
  //   c) Governance failure—capability importance claimed but outcomes not measurable
  // This reflects governance failure in critical capability value definition and outcome measurement.
  eachOfGroup(TYPES.CAPABILITY, function (c) {
    const crit =
      c.prop &&
      (c.prop("critical") ||
        c.prop("priority") ||
        c.prop("business_criticality"));
    if (
      crit &&
      (String(crit).toLowerCase().indexOf("high") >= 0 ||
        String(crit).toLowerCase().indexOf("critical") >= 0)
    ) {
        if (
        !hasRelationToTypes(c, TYPES.OUTCOME) &&
        !hasAnyProp(c, ["target", "kpi", "metric"])
      )
        markElement(c, "X.60");
    }
  });

  // X.61: Pattern declared but not realized/implemented in model
  // Accumulate pattern variants for later P.82 detection
  const patternVariantMap = {};
  heading(getHeadingString("X.61", "الگوی معماری اعلام‌شده بدون پیاده‌سازی یا نگاشت قابل مشاهده است"));
  try {
    allCollection.each(function (el) {
      try {
        const p = el.prop && (el.prop("pattern") || el.prop("pattern_type") || el.prop("patterned"));
        const n = safeName(el) || "";
        const t = safeType(el) || "";
        if (
          (p && String(p).length > 0) ||
          n.toLowerCase().indexOf("pattern") >= 0 ||
          t.toLowerCase().indexOf("pattern") >= 0
        ) {
          // If declared pattern exists, but no related pattern implementation/linkage
          if (!hasRelationToTypes(el, ["Pattern", "Patterned", "PatternedComponent", "PatternedArchStructure"])) {
            markElement(el, "X.61", null, "الگو اعلام شده اما نگاشت/پیاده‌سازی الگو یافت نشد");
          }
          // P.81: Pattern declared but missing configuration/params
          if (p && String(p).length > 0) {
            const hasCfgProp = hasAnyProp(el, ["pattern_config","patternCfg","pattern_params","pattern_configured"]);
            // Some patterns represent config as a related element type 'PatternConfig'
            const hasCfgRelation = hasRelationToTypes(el, ["PatternConfig","PatternConfiguration"]);
            if (!hasCfgProp && !hasCfgRelation) {
              markElement(el, "P.81", null, "الگوی اعلام‌شده فاقد پیکربندی یا پارامترهای لازم است");
            }
            // Collect pattern variant map
            try {
              const variant = el.prop && (el.prop("pattern_variant") || el.prop("variant") || el.prop("product_variant"));
              if (variant && String(variant).length) {
                const key = String(p).trim();
                if (!patternVariantMap[key]) patternVariantMap[key] = [];
                patternVariantMap[key].push({ el: el, variant: String(variant).trim() });
              }
            } catch (errpv) {}
          }
          // P.83: Declared pattern element without expected child types
          if (matchesEClass(el, "Pattern") || matchesEClass(el, "PatternedArchStructure") || matchesEClass(el, "PatternedComponent")) {
            // If a Pattern element has no relation to PatternedComponent/PatternedArchStructure, it is probably uninstantiated
            if (!hasRelationToTypes(el, ["PatternedComponent", "PatternedArchStructure", "PatternedElement"])) {
              markElement(el, "P.83", null, "الگوی مفروض درست اعمال یا نگاشت نشده است");
            }
          }
        }
      } catch (e) {}
    });
  } catch (e) {}

  // P.82: Pattern variant mismatch detection (multiple variants declared for the same pattern without explicit product/variant mapping)
  try {
    Object.keys(patternVariantMap).forEach(function (patternKey) {
      try {
        const entries = patternVariantMap[patternKey] || [];
        const uniqueVariants = {};
        for (let ei = 0; ei < entries.length; ei++) {
          uniqueVariants[entries[ei].variant] = true;
        }
        const variantCount = Object.keys(uniqueVariants).length;
        if (variantCount > 1) {
          // Multiple variants for same pattern found; mark elements that are not in an explicit product-line mapping
          for (let ei2 = 0; ei2 < entries.length; ei2++) {
            const ent = entries[ei2];
            const el = ent.el;
            try {
              // If element is not mapped to any Product/Variant or has no property indicating variant mapping, flag it
              if (!hasRelationToTypes(el, ["Product", "ProductLine", "Variant", "Feature", "Configuration"]) && !hasAnyProp(el, ["product", "product_line", "variant", "variant_of"])) {
                markElement(el, "P.82", null, "پیکربندی/واریانت‌های الگو ناسازگار یا بدون نگاشت محصول/ویژگی مشخص هستند");
              }
            } catch (inner) {}
          }
        }
      } catch (pe) {}
    });
  } catch (e) {}

  // X.62: Shared service declared but single consumer
  heading(getHeadingString("X.62", "سرویس مشترک اعلام شده اما مصرف‌کنندگان تنها از یک برنامۀ کاربردی برخوردارند"));
  eachOfGroup(TYPES.SERVICE, function (s) {
    try {
      // Robust shared declaration detection:
      // - Look for boolean-like properties (english + localized keys)
      // - Heuristic name-based detection for 'shared' (English & Persian tokens)
      const sharedKeys = ['shared', 'isShared', 'shared_service', 'sharedService', 'is_shared', 'مشترک', 'اشتراکی', 'مشاع', 'خدمات اشتراکی', 'سرویس اشتراکی'];
      const propResult = getPropBooleanValue(s, sharedKeys);
      const nameTokens = ['shared', 'shared service', 'shared-service', 'shared_service', 'مشترک', 'اشتراکی', 'مشاع', 'خدمات مشترک', 'خدمات اشتراکی', 'سرویس اشتراکی'];
      const sn = (safeName(s) || '').toLowerCase();
      const nameIndicatesShared = nameTokens.some(function (t) { return t && sn.indexOf(t) >= 0; });
      const declaredShared = propResult.truthy || nameIndicatesShared;
      if (declaredShared) {
        let appCount = 0;
        try {
          const rels = s.rels ? s.rels() : $(s).rels();
          rels.each(function (r) {
            const other = r.source === s ? r.target : r.source;
            if (isAnyType(other, TYPES.APPLICATION)) appCount++;
          });
        } catch (e) {}
        if (appCount < 2) {
          let evidence = "Declared shared ";
          if (propResult.found) evidence += "via property '" + propResult.key + "'=" + propResult.val;
          else if (nameIndicatesShared) evidence += "via name token match ('" + sn + "')";
          else evidence += "(declared by heuristic)";
          markElement(s, "X.62", null, evidence + "; consumerCount=" + appCount);
        }
      }
    } catch (e) {}
  });

  // ============= OPERATIONAL BUSINESS-IT ALIGNMENT CHECKS (OB.68-OB.79) =============
  // From Research Paper 4
  // These checks validate operational alignment between business processes and application implementations

  heading(getHeadingString("OB.68", "تابع کسب‌وکار فاقد پیاده‌سازی برنامۀ کاربردی (شکاف پوشش)"));
  // [DIMENSION]: Business Process IT Coverage & Operational Alignment
  // Ensures/Enables:
  // - Complete operational realization of business processes through IT application support
  // - Process execution certainty through mapped application infrastructure
  // - IT portfolio justification through explicit business process implementation
  // Misalignment Impact: Business processes lacking application/service support indicate:
  //   a) Coverage gap—business process executing without IT system support or automation
  //   b) Manual work risk—process may be inefficient or error-prone due to lack of IT support
  //   c) Portfolio blindness—IT systems not aligned to business process landscape
  // This reflects governance failure in business process IT coverage and operational digitalization.
  eachOfGroup(TYPES.PROCESS, function (proc) {
    // Business process must have at least one application link
    if (!hasRelationToTypes(proc, TYPES.APPLICATION)) {
      markElement(
        proc,
        "OB.68",
        null,
        "شکاف پوشش: فرآیند کسب‌وکار بدون پیاده‌سازی"
      );
    }
  });

  heading(getHeadingString("OB.69", "عملکرد/جزء نرم‌افزاری بدون پیوند به هیچ فرآیند کسب‌وکار است (کارکرد فناوری اطلاعاتِ جدااُفتاده و تنها)"));
  // [DIMENSION]: Application Business Value Justification & Portfolio Optimization
  // Ensures/Enables:
  // - Business value clarity—each application justified by supporting business processes
  // - Portfolio optimization enabling retirement/consolidation of non-value-adding systems
  // - IT-business alignment through explicit application-process dependencies
  // Misalignment Impact: Applications lacking business process support indicate:
  //   a) Value gap—application funded but not supporting any business process
  //   b) Portfolio waste—IT system maintained without clear business justification
  //   c) Optimization blindness—orphaned applications not identified for consolidation/retirement
  // This reflects governance failure in application portfolio rationalization and business value alignment.
  eachOfGroup(TYPES.APPLICATION, function (app) {
    // Application must be linked to at least one business process
    if (!hasRelationToTypes(app, TYPES.PROCESS)) {
      markElement(
        app,
        "OB.69",
        null,
        "عملکرد/جزء نرم‌افزاری جُدااُفتاده و بی‌استفاده"
      );
    }
  });

  heading(getHeadingString("OB.70", "پیاده‌سازی بیش از حدِ تابع کسب‌وکار (پیاده‌سازی‌های متعدد فناوری اطلاعات)"));
  // [DIMENSION]: Process Implementation Efficiency & Application Portfolio Consolidation
  // Ensures/Enables:
  // - Process implementation efficiency through single, coordinated application per process
  // - Application consolidation opportunity identification reducing support complexity
  // - Process standardization enabling consistent execution across organization
  // Misalignment Impact: Business processes implemented by multiple applications indicate:
  //   a) Process inconsistency—same business function executed differently by competing applications
  //   b) Portfolio inefficiency—redundant systems implementing same business logic
  //   c) Consolidation opportunity—multiple applications could be unified/replaced
  // This reflects governance failure in application consolidation and process standardization.
  eachOfGroup(TYPES.PROCESS, function (proc) {
    // Count application links; flag if excessive
    let appLinkCount = 0;
    try {
      const rels = proc.rels ? proc.rels() : $(proc).rels();
      rels.each(function (r) {
        const other = r.source === proc ? r.target : r.source;
        if (isAnyType(other, TYPES.APPLICATION)) appLinkCount++;
      });
    } catch (e) {}
    // Flag if more than 2 applications implement the same business function
    if (appLinkCount > 2) {
      markElement(
        proc,
        "OB.70",
        null,
        "عملکرد پیاده‌سازی بیش‌ازحد کسب‌وکار توسط " +
          appLinkCount +
          " برنامۀ کاربردی پیاده‌سازی بیش‌ازحد شده‌اند "
      );
    }
  });

  heading(getHeadingString("OB.71", "عملکرد برنامۀ کاربردی بیش‌ازحد استفاده شده (بازاستفادۀ طراحی معماری تک‌لایه)"));
  // [DIMENSION]: Application Architecture Modularity & Separation of Concerns
  // Ensures/Enables:
  // - Application architecture modularity through single-concern application design
  // - Business agility through loosely-coupled application portfolio
  // - Change isolation preventing ripple effects across business processes
  // Misalignment Impact: Single application supporting many business processes indicate:
  //   a) Architecture risk—monolithic application creates single point of failure for multiple processes
  //   b) Agility loss—change to one process requires coordinated change across dependent processes
  //   c) Modularity failure—application not decomposed into focused, single-purpose components
  // This reflects architecture failure in modularity and loose coupling principles.
  eachOfGroup(TYPES.APPLICATION, function (app) {
    // Count business process links; flag if excessive
    let procLinkCount = 0;
    try {
      const rels = app.rels ? app.rels() : $(app).rels();
      rels.each(function (r) {
        const other = r.source === app ? r.target : r.source;
        if (isAnyType(other, TYPES.PROCESS)) procLinkCount++;
      });
    } catch (e) {}
    // Flag if application supports more than 3 business processes (monolithic reuse)
    if (procLinkCount > 3) {
      markElement(
        app,
        "OB.71",
        null,
        "استفادۀ بیش‌ازحد از مؤلفۀ نرم‌افزاری"
      );
    }
  });

  heading(
    getHeadingString("OB.72", "مفهوم داده فاقد نگاشت کسب‌وکار است")
  );
  // [DIMENSION]: Business-IT Data Semantics Alignment & Information Architecture
  // Ensures/Enables:
  // - Semantic alignment between business data concepts and IT data models
  // - Data governance clarity showing business-IT data mapping and ownership
  // - Cross-layer traceability from business information needs to IT data storage
  // Misalignment Impact: IT data objects lacking business data mappings indicate:
  //   a) Semantic gap—IT data model disconnected from business information concepts
  //   b) Governance blind spot—data ownership and management unclear at business level
  //   c) Architecture fragmentation—business and IT data views operating independently
  // This reflects governance failure in business-IT data semantics and information architecture alignment.
  eachOfGroup(TYPES.DATA, function (data) {
    // IT data object should link to business data concept
    if (isAnyType(data, ["Data Object", "Artifact"])) {
      // Check if it's IT-layer data (Application data, not Business data)
      let isITData = false;
      try {
        const t = safeType(data);
        if (t && t.indexOf("Data") >= 0) {
          isITData = true;
        }
      } catch (e) {}

      if (isITData && !hasRelationToTypes(data, ["Business Object"])) {
        markElement(
          data,
          "OB.72",
          null,
          "شکاف پوشش داده"
        );
      }
    }
  });

  heading(getHeadingString("OB.73", "موجودیت دادۀ کسب‌وکار فاقد تداوم فناوری اطلاعات است"));
  // [DIMENSION]: Data Persistence Architecture & Business Data Infrastructure Support
  // Ensures/Enables:
  // - Data availability assurance through mapped IT storage/repository infrastructure
  // - Data persistence governance showing which systems maintain/archive business data
  // - Data lifecycle clarity from creation through archival/disposal
  // Misalignment Impact: Business data concepts lacking IT persistence/storage mappings indicate:
  //   a) Infrastructure gap—business data defined but no IT system stores/manages it
  //   b) Data at-risk—business-critical data lacking defined persistence strategy
  //   c) Governance void—data lifecycle and archival not planned or supported
  // This reflects governance failure in data infrastructure and persistence planning.
  eachOfGroup(TYPES.DATA, function (data) {
    // Business data object should link to IT data storage
    if (isAnyType(data, ["Business Object"])) {
      if (!hasRelationToTypes(data, ["Data Object", "Artifact"])) {
        markElement(
          data,
          "OB.73",
          null,
          "شکاف پایداری داده"
        );
      }
    }
  });

  heading(
    "OB.74 - پیوند عملکردی بین لایه‌ها مفقود است (تخلف از هماهنگی و انسجام)"
  );
  // [DIMENSION]: Cross-Layer Functional Linkage & Business-IT Integration
  // Ensures/Enables:
  // - Functional alignment ensuring business processes explicitly linked to application implementations
  // - Integration visibility showing process-to-application mapping paths
  // - Operational coherence through connected business and IT layers
  // Misalignment Impact: Business processes without application/service linkage indicate:
  //   a) Integration gap—business operation disconnected from supporting IT systems
  //   b) Alignment failure—process-to-IT mapping missing undermining business-IT coherence
  //   c) Architecture fragmentation—business and IT layers operating independently
  // This reflects governance failure in cross-layer functional integration and business-IT alignment.
  eachOfGroup(TYPES.PROCESS, function (proc) {
    // Verify functional link exists to application layer
    let hasLink = false;
    try {
      const rels = proc.rels ? proc.rels() : $(proc).rels();
      rels.each(function (r) {
        const other = r.source === proc ? r.target : r.source;
        if (isAnyType(other, TYPES.APPLICATION)) {
          hasLink = true;
        }
      });
    } catch (e) {}
    if (!hasLink) {
      markElement(
        proc,
        "OB.74",
        null,
        "فرآیند کسب‌وکار فاقد پیوند عملکردی به لایۀ برنامۀ کاربردی است (تخلف از هماهنگی و انسجام میان‌لایه‌ای)"
      );
    }
  });

  heading(
    "OB.75 - پیوند داده‌ای بین لایه‌ها مفقود است (تخلف از پیوستگی داده)"
  );
  // [DIMENSION]: Cross-Layer Data Linkage & Semantic Data Consistency
  // Ensures/Enables:
  // - Data consistency across business and IT layers through explicit mappings
  // - Semantic alignment ensuring business data concepts implemented in IT data models
  // - Data traceability from business requirements to IT implementation
  // Misalignment Impact: Business and IT data lacking cross-layer mappings indicate:
  //   a) Data fragmentation—business and IT data views operating independently
  //   b) Semantic disconnect—business data meaning not preserved in IT implementation
  //   c) Governance gap—data ownership and lifecycle unclear between layers
  // This reflects governance failure in cross-layer data alignment and semantic consistency.
  eachOfGroup(TYPES.DATA, function (data) {
    // Check if business and IT data are properly linked
    const isBusinessData = isAnyType(data, ["Business Object"]);
    const isITData = isAnyType(data, ["Data Object", "Artifact"]);

    if (isBusinessData || isITData) {
      let hasDataLink = false;
      try {
        const rels = data.rels ? data.rels() : $(data).rels();
        rels.each(function (r) {
          const other = r.source === data ? r.target : r.source;
          // Check for cross-layer data mapping
          if (isBusinessData && isAnyType(other, ["Data Object", "Artifact"])) {
            hasDataLink = true;
          } else if (isITData && isAnyType(other, ["Business Object"])) {
            hasDataLink = true;
          }
        });
      } catch (e) {}
      if (!hasDataLink) {
        markElement(
          data,
          "OB.75",
          null,
          "شیء داده فاقد اتصال نگاشت میان‌لایه‌ای است (شکاف همراستایی لایۀ داده)"
        );
      }
    }
  });

  heading(getHeadingString("OB.76", "یکپارچه‌سازی صرفاً فنی (فاقد توجیه کسب‌وکاری)"));
  // [DIMENSION]: Application Business Justification & Technical-Driven Architecture Avoidance
  // Ensures/Enables:
  // - Business-driven IT development prioritizing business value over technical capability
  // - Application portfolio clarity showing business case for each system
  // - Technology decisions justified by business requirements, not technical interests
  // Misalignment Impact: Applications lacking business process/value mappings indicate:
  //   a) Business misalignment—application built for technical reasons without business justification
  //   b) Value void—IT investment made without clear business benefit or process support
  //   c) Portfolio waste—technical systems developed disconnected from business needs
  // This reflects governance failure in business-driven IT development discipline.
  eachOfGroup(TYPES.APPLICATION, function (app) {
    // Application with no business process linkage suggests pure technical implementation
    if (
      !hasRelationToTypes(app, TYPES.PROCESS) &&
      !hasRelationToTypes(app, TYPES.VALUE)
    ) {
      markElement(app, "OB.76", null, "برنامۀ کاربردی به دلایل فنی و بدون توجیه مستقیم کسب‌وکاری توسعه یافته است (یکپارچه‌سازی صرفاً فنی)");
    }
  });

  heading(getHeadingString("OB.77", "الگوی سیلوهای عملکردی (حوزه‌های عملکردی مجزا)"));
  // [DIMENSION]: Business Process Integration & Organizational Silo Elimination
  // Ensures/Enables:
  // - Cross-functional process integration breaking down organizational silos
  // - Business process coherence through explicit interconnection and data flows
  // - Organizational agility through integrated capabilities vs. isolated functions
  // Misalignment Impact: Processes operating in isolation without integration mappings indicate:
  //   a) Silo reinforcement—organizational functions operate independently, creating process gaps
  //   b) Integration gaps—business processes not connected creating inefficiency and rework
  //   c) Organizational misalignment—functional silos preventing end-to-end business process flow
  // This reflects governance failure in breaking down organizational silos and process integration.
  eachOfGroup(TYPES.PROCESS, function (proc) {
    // Process should have relationships to other processes or capabilities for integration
    let isIsolated = true;
    try {
      const rels = proc.rels ? proc.rels() : $(proc).rels();
      rels.each(function (r) {
        const other = r.source === proc ? r.target : r.source;
        // Check for integration with other business constructs
        if (
          isAnyType(
            other,
            TYPES.PROCESS.concat(TYPES.CAPABILITY).concat(TYPES.CAPABILITY)
          )
        ) {
          isIsolated = false;
        }
      });
    } catch (e) {}
    if (isIsolated && hasRelationToTypes(proc, TYPES.APPLICATION)) {
      markElement(
        proc,
        "OB.77",
        null,
        "تابع کسب‌وکار در انزوا عمل می‌کند و فاقد پیوستگی بین‌وظیفه‌ای است (سیلوی عملکردی)"
      );
    }
  });

  heading(getHeadingString("OB.78", "معماری برنامۀ کاربردی یکپارچه و تک‌لایه (پیچیدگی غیرتفکیک‌شده)"));
  // [DIMENSION]: Application Architecture Modularity & Technical Debt Management
  // Ensures/Enables:
  // - Application decomposition enabling independent deployment and scaling
  // - Reduced technical complexity through modular architecture and separation of concerns
  // - Development agility through loosely-coupled, independently-deployable components
  // Misalignment Impact: Single application supporting many business functions indicate:
  //   a) Technical complexity—monolithic application accumulating undifferentiated complexity
  //   b) Deployment rigidity—changes to one function require full application redeployment
  //   c) Technical debt—architecture lacking modularity creates long-term maintenance burden
  // This reflects architecture failure in modularity and accumulating technical debt.
  eachOfGroup(TYPES.APPLICATION, function (app) {
    // Count number of business processes this app implements
    let procCount = 0;
    try {
      const rels = app.rels ? app.rels() : $(app).rels();
      rels.each(function (r) {
        const other = r.source === app ? r.target : r.source;
        if (isAnyType(other, TYPES.PROCESS)) procCount++;
      });
    } catch (e) {}
    // Flag if single application implements too many business functions (monolith)
    if (procCount > 5) {
      markElement(
        app,
        "OB.78",
        null,
        "معماری برنامۀ کاربردی یکپارچه و تک‌لایه (پیچیدگی غیرتفکیک‌شده)"
      );
    }
  });

  heading(getHeadingString("OB.79", "پیاده‌سازی‌های متعدد متعارض (عملکرد تکراری)"));
  // [DIMENSION]: Process Implementation Standardization & Portfolio Rationalization
  // Ensures/Enables:
  // - Process standardization through unified implementation preventing divergence
  // - Portfolio consolidation opportunity identification reducing support complexity
  // - Consistent business execution through single, standardized implementation per process
  // Misalignment Impact: Business processes with multiple competing implementations indicate:
  //   a) Process divergence—same business function implemented differently across organization
  //   b) Portfolio inefficiency—redundant implementations increasing support complexity and cost
  //   c) Standardization failure—organization unable to establish single process implementation
  // This reflects governance failure in process standardization and application consolidation.
  // Track which business processes have multiple application implementations
  const procImplementationMap = {};
  eachOfGroup(TYPES.PROCESS, function (proc) {
    const procKey = safeId(proc);
    let appCount = 0;
    const apps = [];
    try {
      const rels = proc.rels ? proc.rels() : $(proc).rels();
      rels.each(function (r) {
        const other = r.source === proc ? r.target : r.source;
        if (isAnyType(other, TYPES.APPLICATION)) {
          appCount++;
          apps.push(other);
        }
      });
    } catch (e) {}
    // Mark if multiple applications implement the same business function
    if (appCount > 1) {
      markElement(
        proc,
        "OB.79",
        null,
        "تابع کسب‌وکار دارای چندین پیاده‌سازی برنامۀ کاربردی متعارض است (پیاده‌سازی‌های تکراری)"
      );
    }
  });

  // OB.80 - Product Line architecture lacks feature/guard mapping
  heading(getHeadingString("OB.80", "معماری محصول-خط فاقد نگاشت ویژگی‌ها یا حالت‌ها است"));
  // Heuristic: look for elements with 'product' in the name/type or a product_line property
  eachOfGroup(["Architecture", "ArchStructure", "System", "Component"], function (el) {
    try {
      const name = (safeName(el) || "").toLowerCase();
      const hasProductProp = el.prop && (el.prop("product_line") || el.prop("product") || el.prop("productName"));
      if (name.indexOf("product") >= 0 || hasProductProp) {
        if (
          !hasRelationToTypes(el, ["Variant", "Feature", "Guard", "Requirement", "Constraint"]) &&
          !hasAnyProp(el, ["variant", "feature", "guard", "product_variant"])
        ) {
          markElement(el, "OB.80");
        }
      }
    } catch (e) {}
  });

  // ============= SEMANTIC MISALIGNMENT DETECTION =============
  // Phase 1: Business Service not realized by Application Service (core IT support gap)
  heading(getHeadingString("SEM.01", "سرویس کسب‌وکار توسط سرویس برنامۀ کاربردی محقق نشده است"));
  // [DIMENSION]: Service Realization & Business-IT Semantic Alignment
  // Ensures/Enables:
  // - Business service-to-IT service traceability showing explicit IT support chain
  // - Semantic closure validating complete realization path from business goals to application capability
  // - Business-IT alignment clarity through documented service-level relationships linking strategy to implementation
  // Misalignment Impact: Business services without application service realization indicate:
  //   a) IT coverage gap—business services executing without mapped IT support or application capability
  //   b) Accountability blindness—unclear which applications/teams deliver specific business service capability
  //   c) Semantic disconnection—business-driven service definitions not grounded in IT implementation reality
  // This reflects governance failure in service-level alignment and business-IT semantic connection.
  try {
    allCollection.each(function (el) {
      let t = safeType(el);
      // Check if this is a BusinessService (or service-like element)
      if (
        t === "BusinessService" ||
        (t &&
          String(t).toLowerCase().indexOf("business") >= 0 &&
          String(t).toLowerCase().indexOf("service") >= 0)
      ) {
        let hasAppServiceRealization = false;
        try {
          let rels = el.rels ? el.rels() : $(el).rels();
          rels.each(function (r) {
            try {
              let other = r.source === el ? r.target : r.source;
              let otherType = safeType(other);
              // Check if related element is an ApplicationService
              if (
                otherType === "ApplicationService" ||
                (otherType &&
                  String(otherType).toLowerCase().indexOf("application") >= 0 &&
                  String(otherType).toLowerCase().indexOf("service") >= 0)
              ) {
                // Verify it's a realization, assignment, or realizes relationship
                let relType = r.type ? r.type() : "";
                if (
                  relType === "Realization" ||
                  relType === "Assignment" ||
                  relType === "Serving" ||
                  relType === "Realizes" ||
                  (relType &&
                    String(relType).toLowerCase().indexOf("realiz") >= 0) ||
                  (relType &&
                    String(relType).toLowerCase().indexOf("serv") >= 0)
                ) {
                  hasAppServiceRealization = true;
                }
              }
            } catch (e) {}
          });
        } catch (e) {}

        if (!hasAppServiceRealization) markElement(el, "SEM.01");
      }
    });
  } catch (e) {}

  // Phase 2: Application Service not providing any Business Service (orphaned IT capability)
  heading(getHeadingString("SEM.02", "سرویس برنامه‌ای هیچ سرویس کسب‌وکاری ارائه نمی‌دهد"));
  // [DIMENSION]: Application Service Business Value & IT-Business Alignment
  // Ensures/Enables:
  // - IT justification clarity confirming each application service delivers measurable business value
  // - Business alignment validation ensuring application capabilities align to explicit business needs
  // - Portfolio rationalization enabling identification of orphaned/non-value-adding IT capabilities
  // Misalignment Impact: Application services without business service delivery indicate:
  //   a) Value blindness—application capability operating without clear business service justification
  //   b) Shadow IT expansion—capabilities developed and maintained without documented business requirement
  //   c) Portfolio inefficiency—unaligned IT investments creating maintenance burden disconnected from business value
  // This reflects governance gap in application service business justification and value alignment.
  try {
    allCollection.each(function (el) {
      const t = safeType(el);
      if (
        t === "ApplicationService" ||
        (t &&
          String(t).toLowerCase().indexOf("application") >= 0 &&
          String(t).toLowerCase().indexOf("service") >= 0)
      ) {
        let servesBusinessService = false;
        try {
          const rels = el.rels ? el.rels() : $(el).rels();
          rels.each(function (r) {
            try {
              const other = r.source === el ? r.target : r.source;
              const otherType = safeType(other);
              if (
                otherType === "BusinessService" ||
                (otherType &&
                  String(otherType).toLowerCase().indexOf("business") >= 0 &&
                  String(otherType).toLowerCase().indexOf("service") >= 0)
              ) {
                const relType = r.type ? r.type() : "";
                if (
                  relType === "Realization" ||
                  relType === "Assignment" ||
                  relType === "Serving" ||
                  relType === "Realizes" ||
                  (relType &&
                    String(relType).toLowerCase().indexOf("realiz") >= 0) ||
                  (relType &&
                    String(relType).toLowerCase().indexOf("serv") >= 0)
                ) {
                  servesBusinessService = true;
                }
              }
            } catch (e) {}
          });
        } catch (e) {}

        if (!servesBusinessService) markElement(el, "SEM.02");
      }
    });
  } catch (e) {}

  // Phase 3: Business Service marked as Critical but no IT support chain
  heading(getHeadingString("SEM.03", "سرویس حیاتی کسب‌وکار فاقد زنجیرۀ کامل پشتیبانی فناوری اطلاعات است"));
  // [DIMENSION]: Critical Service End-to-End IT Support Chain & Business Continuity Alignment
  // Ensures/Enables:
  // - Mission-critical service support verification through complete service-to-infrastructure traceability
  // - Disaster recovery readiness ensuring critical business services have mapped IT support chain
  // - Continuity governance clarity showing which applications/infrastructure support critical services
  // Misalignment Impact: Critical business services lacking complete IT support chain indicate:
  //   a) Continuity risk—critical service continuity unverified against application/infrastructure support reality
  //   b) Recovery blindness—disaster recovery planning uncertain about which systems protect critical services
  //   c) Business-IT disconnection—critical service importance not reflected in documented IT support architecture
  // This reflects governance failure in critical service continuity architecture and end-to-end alignment.
  try {
    allCollection.each(function (el) {
      let t = safeType(el);
      if (
        t === "BusinessService" ||
        (t &&
          String(t).toLowerCase().indexOf("business") >= 0 &&
          String(t).toLowerCase().indexOf("service") >= 0)
      ) {
        // Check if service is marked as critical
        let isCritical = false;
        let name = safeName(el).toLowerCase();
        if (name.indexOf("critical") >= 0 || name.indexOf("core") >= 0) {
          isCritical = true;
        }
        try {
          const crit = el.prop && (el.prop("critical") || el.prop("priority"));
          if (
            crit &&
            (String(crit).toLowerCase().indexOf("critical") >= 0 ||
              String(crit).toLowerCase().indexOf("high") >= 0)
          ) {
            isCritical = true;
          }
        } catch (e) {}

        if (isCritical) {
          // Check full chain: AppService -> AppComponent -> Infrastructure
          let hasAppService = false;
          let hasAppComponent = false;
          let hasTechnology = false;

          try {
            const rels = el.rels ? el.rels() : $(el).rels();
            rels.each(function (r) {
              try {
                const other = r.source === el ? r.target : r.source;
                const otherType = safeType(other);

                if (
                  otherType === "ApplicationService" ||
                  (otherType &&
                    String(otherType).toLowerCase().indexOf("application") >=
                      0 &&
                    String(otherType).toLowerCase().indexOf("service") >= 0)
                ) {
                  hasAppService = true;

                  // Check if AppService links to AppComponent
                  const rels2 = other.rels ? other.rels() : $(other).rels();
                  rels2.each(function (r2) {
                    const other2 = r2.source === other ? r2.target : r2.source;
                    const t2 = safeType(other2);
                    if (
                      t2 === "ApplicationComponent" ||
                      (t2 &&
                        String(t2).toLowerCase().indexOf("application") >= 0 &&
                        String(t2).toLowerCase().indexOf("component") >= 0)
                    ) {
                      hasAppComponent = true;

                      // Check if AppComponent links to Infrastructure
                      const rels3 = other2.rels
                        ? other2.rels()
                        : $(other2).rels();
                      rels3.each(function (r3) {
                        const other3 =
                          r3.source === other2 ? r3.target : r3.source;
                        const t3 = safeType(other3);
                        if (
                          t3 === "Node" ||
                          t3 === "Device" ||
                          t3 === "SystemSoftware" ||
                          (t3 &&
                            String(t3)
                              .toLowerCase()
                              .indexOf("infrastructure") >= 0) ||
                          (t3 &&
                            String(t3).toLowerCase().indexOf("technology") >= 0)
                        ) {
                          hasTechnology = true;
                        }
                      });
                    }
                  });
                }
              } catch (e) {}
            });
          } catch (e) {}

          if (!hasAppService) {
            markElement(
              el,
              "SEM.03",
              null,
              "سرویس حیاتی کسب‌وکار: فاقد پشتیانی سرویس برنامۀ کاربردی"
            );
          } else if (!hasAppComponent) {
            markElement(
              el,
              "SEM.03",
              null,
              "سرویس حیاتی کسب‌وکار: سرویس برنامۀ کاربردی به مؤلفه نگاشت نشده است"
            );
          } else if (!hasTechnology) {
            markElement(
              el,
              "SEM.03",
              null,
              "سرویس کسب‌وکار حیاتی: مولفۀ برنامۀ کاربردی به زیرساخت نگاشت نشده است"
            );
          }
        }
      }
    });
  } catch (e) {}

  // ---------------- EXPORT & SUMMARY ----------------

  heading("پایان اسکن");

  // Summary by severity
  const bySeverity = {};
  REPORT_MODE.severityOrder.forEach(function (sev) {
    bySeverity[sev] = 0;
  });
  findings.forEach(function (f) {
    if (bySeverity.hasOwnProperty(f.severity)) bySeverity[f.severity]++;
  });

  // Summary by aspect
  const byAspect = {};
  findings.forEach(function (f) {
    if (!byAspect[f.aspect]) byAspect[f.aspect] = 0;
    byAspect[f.aspect]++;
  });

  info("خلاصۀ یافته‌ها:");
  info("  کل یافته‌ها: " + findings.length);
  info("  براساس شدت:");
  REPORT_MODE.severityOrder.forEach(function (sev) {
    const sevLabel = FA.SEVERITY_LABELS[sev] || sev;
    info("    " + sevLabel + ": " + bySeverity[sev]);
  });
  info("  براساس بُعد:");
  Object.keys(byAspect)
    .sort()
    .forEach(function (asp) {
      const aspLabel = FA.ASPECTS[asp] || asp;
      info("    " + aspLabel + ": " + byAspect[asp]);
    });

  info("\nتنظیمات فیلتر:");
  info("  شامل کردن غیرقابل‌تحلیل: " + REPORT_MODE.includeNonAnalyzable);
  // Translate configured minimum severity value to Persian (if mapping exists)
  info(
    "  حدأقل شدت گزارش: " +
      (FA.SEVERITY_LABELS[REPORT_MODE.minSeverity] || REPORT_MODE.minSeverity) +
      " و بالاتر"
  );

  if (findings.length > 0) {
    info("\nیافته‌های بحرانی و با اولویت بالا (حدأکثر ٣٠):");
    let critical = [];
    findings.forEach(function (f) {
      if (f.severity === "CRITICAL" || f.severity === "HIGH") {
        critical.push(f);
      }
    });
    for (let i = 0; i < Math.min(30, critical.length); i++) {
      let f = critical[i];
      info(
        " - [" +
          f.severity +
          "] " +
          f.elementName +
          " (" +
          f.elementType +
          ") : " +
          f.code +
          " - " +
          f.desc +
          (f.documentation ? " (" + f.documentation + ")" : "")
      );
    }
  } else {
    info(
      "هیچ یافته‌ای با سطح شدت پیکربندی‌شده یافت نشد. سطح حالت گزارش‌دهی با حدأقل شدت را تغییر دهید تا مسائل با شدت پایین‌تر گزارش شوند."
    );
  }

  // Display findings in SWT Dialog with table
  /**
   * Displays the findings in an interactive HTML table dialog within jArchi.
   * Provides visual browsing of all detected misalignments with sorting and filtering capabilities.
   *
   * The dialog shows:
   * - All findings in a formatted HTML table
   * - Color-coded severity rows (CRITICAL=red, HIGH=orange, MEDIUM=yellow, LOW=light yellow)
   * - Element name, type, code, description, and documentation columns
   *
   * Opens as a modal dialog in the jArchi UI that users can close when done reviewing
   */
  function displayTableDialog() {
    console.log("اشکال‌زدایی ▂▂ فراخوانی تابع displayTableDialog()");
    // Ensure the UI creation occurs on the SWT UI thread. If the script runs
    // outside the UI thread, schedule the dialog creation on the default Display.
    try {
      let display = SWTDisplay.getCurrent();
      if (!display) display = SWTDisplay.getDefault();
      console.log("اشکال‌زدایی ▂▂ زمان‌بندی ایجاد رابط کاربردی برای نمایش");
      display.asyncExec(function () {
        console.log("اشکال‌زدایی ▂▂ ورود به تابع بازگشتی asyncExec");
        let shell;
        let image;
        try {
          console.log("اشکال‌زدایی ▂▂ ایجاد شِل برای نمایش");
          // Before creating a new dialog, close any previous dialogs created by
          // earlier runs of this script to avoid orphaned shells and native leaks.
          try {
            const existing = display.getShells ? display.getShells() : [];
            for (let si = 0; si < existing.length; si++) {
              try {
                const sh = existing[si];
                if (sh && sh.getText && String(sh.getText()).indexOf("نتایج بررسی همراستایی") === 0) {
                  try { if (!sh.isDisposed()) sh.dispose(); } catch (dd) {}
                }
              } catch (inner) {}
            }
          } catch (e) {}
          // Use the active Archi shell as the parent if available. This helps ensure
          // correct stacking order so the dialog appears above the main window.
          const activeShell = display.getActiveShell && display.getActiveShell();
          shell = activeShell
            ? new SWTShell(activeShell, org.eclipse.swt.SWT.SHELL_TRIM)
            : new SWTShell(display, org.eclipse.swt.SWT.SHELL_TRIM);

      shell.setText("نتایج بررسی همراستایی بین کسب‌وکار و فناوری اطلاعات، در سازمان");
      shell.setSize(1400, 800);

      // Retrieve the active Display instance (always exists in jArchi context)
      // getCurrent() returns the Display for the current thread (the jArchi/Archi main thread)
      // This Display is shared with the main Archi window and manages the event loop
          shell.setLocation(
            display.getPrimaryMonitor().getBounds().x + 5,
            display.getPrimaryMonitor().getBounds().y + 5
          );

      const gridLayout = new SWTGridLayout();
      gridLayout.numColumns = 1;
      gridLayout.marginWidth = 0;
      gridLayout.marginHeight = 0;
      shell.setLayout(gridLayout);

      const table = new SWTTable(
        shell,
        org.eclipse.swt.SWT.BORDER | org.eclipse.swt.SWT.FULL_SELECTION
      );
      table.setHeaderVisible(true);
      // Track top-level table colors so we can dispose them on shell close
      const mainColorObjects = [];
      const tableHeaderFg = new SWTColor(25, 25, 112);
      const tableHeaderBg = new SWTColor(173, 216, 230);
      mainColorObjects.push(tableHeaderFg);
      mainColorObjects.push(tableHeaderBg);
      table.setHeaderForeground(tableHeaderFg);
      table.setHeaderBackground(tableHeaderBg);
      table.setLinesVisible(true);

      const tableGridData = new SWTGridData(
        org.eclipse.swt.layout.GridData.FILL_BOTH
      );
      tableGridData.grabExcessHorizontalSpace = true;
      tableGridData.grabExcessVerticalSpace = true;
      table.setLayoutData(tableGridData);

      const cols = [
        FA.COLUMNS.severity,
        FA.COLUMNS.elementId,
        FA.COLUMNS.aspect,
        FA.COLUMNS.code,
        FA.COLUMNS.elementName,
        FA.COLUMNS.elementType,
        FA.COLUMNS.description,
        FA.COLUMNS.documentation,
      ];
      for (let c = 0; c < cols.length; c++) {
        const col = new SWTTableColumn(
          table,
          org.eclipse.swt.SWT.NONE
        );
        col.setText(cols[c]);
        // Set column widths: Element ID=120, Element Name=150, Description=180, Documentation=400, others=100
        col.setWidth(
          c === 1 ? 120 : c === 4 ? 150 : c === 6 ? 180 : c === 7 ? 400 : 100
        );
      }

      // Pre-cache severity colors for the main findings table to avoid many Color allocations
      const mainSeverityColorCache = {};
      const mainSeverityTextColorCache = {};
      // Hoisted UI variables for slider and label to keep scoping clean and consistent
      let sliderComposite, sliderCompositeGD, sliderLayout, slider, sliderGD, filterLabel, footerItemRef;
      const sourceFindings = (Array.isArray(findings) && findings.length) ? findings : findingsCache;
      for (let i = 0; i < sourceFindings.length; i++) {
        const f = sourceFindings[i];
        const item = new SWTTableItem(
          table,
          org.eclipse.swt.SWT.NONE
        );
        // Translate labels and description
        const severityLabel = FA.SEVERITY_LABELS[f.severity] || f.severity || "";
        const aspectLabel = FA.ASPECTS[f.aspect] || f.aspect || "";
        const descLabel = f.desc || (SYMPTOM_CATALOGUE[f.code] && SYMPTOM_CATALOGUE[f.code].desc) || "";
        const docLabel = f.documentation || "";
        item.setText([
          severityLabel,
          f.elementId || "",
          aspectLabel,
          f.code || "",
          f.elementName || "",
          f.elementType || "",
          descLabel,
          docLabel,
        ]);
        // Set row background color based on severity (cached colors)
        try {
          if (!mainSeverityColorCache[f.severity]) {
            if (f.severity === "CRITICAL") {
              const c1 = new SWTColor(255, 0, 0);
              const ct1 = new SWTColor(61, 11, 11);
              mainSeverityColorCache[f.severity] = c1;
              mainSeverityTextColorCache[f.severity] = ct1;
              mainColorObjects.push(c1);
              mainColorObjects.push(ct1);
            } else if (f.severity === "HIGH") {
              const c2 = new SWTColor(255, 102, 0);
              const ct2 = new SWTColor(33, 15, 3);
              mainSeverityColorCache[f.severity] = c2;
              mainSeverityTextColorCache[f.severity] = ct2;
              mainColorObjects.push(c2);
              mainColorObjects.push(ct2);
            } else if (f.severity === "MEDIUM") {
              const c3 = new SWTColor(255, 204, 0);
              const ct3 = new SWTColor(38, 33, 12);
              mainSeverityColorCache[f.severity] = c3;
              mainSeverityTextColorCache[f.severity] = ct3;
              mainColorObjects.push(c3);
              mainColorObjects.push(ct3);
            } else {
              const c4 = new SWTColor(255, 255, 0);
              const ct4 = new SWTColor(36, 36, 2);
              mainSeverityColorCache[f.severity] = c4;
              mainSeverityTextColorCache[f.severity] = ct4;
              mainColorObjects.push(c4);
              mainColorObjects.push(ct4);
            }
          }
          const severityColor = mainSeverityColorCache[f.severity];
          const severityTColor = mainSeverityTextColorCache[f.severity];
          item.setBackground(severityColor);
          item.setForeground(severityTColor);
        } catch (e) {
          // If color setting fails, continue without coloring
        }
      }

      // Pack and hide the last auto-generated empty column
      table.getColumn(0).pack();
      table.getColumn(1).pack();
      table.getColumn(2).pack();
      table.getColumn(3).pack();
      table.getColumn(4).pack();
      table.getColumn(5).pack();
      table.getColumn(6).pack();
      table.getColumn(7).pack();

      // Prevent the extra column from showing by setting table header visible and using SWT.CHECK flag workaround
      if (table.getColumnCount() > 8) {
        for (let x = 8; x < table.getColumnCount(); x++) {
          try {
            table.getColumn(x).setWidth(0);
          } catch (e) {}
        }
      }

      // --- SUMMARY PANEL: create a Table below the findings table showing aggregated stats ---
      try {
        // Aggregate counts
        const sourceFindings = (Array.isArray(findings) && findings.length) ? findings : findingsCache;
        const total = (sourceFindings.filter(function (ff) { return isReportableSeverity(ff.code); }).length) || 0;
        const severityCounts = {};
        const aspectCounts = {};
        // initialize severity counts using configured severity order if available
        if (REPORT_MODE && REPORT_MODE.severityOrder && REPORT_MODE.severityOrder.length) {
          for (let si = 0; si < REPORT_MODE.severityOrder.length; si++) {
            severityCounts[REPORT_MODE.severityOrder[si]] = 0;
          }
        }
        for (let fi = 0; fi < sourceFindings.length; fi++) {
          const ff = sourceFindings[fi];
          const s = ff.severity || "LOW";
          severityCounts[s] = (severityCounts[s] || 0) + 1;
          const akey = ff.aspect || "Unclassified";
          aspectCounts[akey] = (aspectCounts[akey] || 0) + 1;
        }

        // Create a composite with two columns: left = summary table, right = optional image
        const summaryComposite = new SWTComposite(
          shell,
          org.eclipse.swt.SWT.NONE
        );
        const summaryCompLayout = new SWTGridLayout(2, false);
        summaryCompLayout.marginHeight = 0;
        summaryCompLayout.marginWidth = 0;
        summaryComposite.setLayout(summaryCompLayout);
        // Ensure the summary composite fills horizontally in the shell layout
        const summaryCompositeGridData = new SWTGridData(org.eclipse.swt.layout.GridData.FILL_HORIZONTAL);
        summaryCompositeGridData.grabExcessHorizontalSpace = true;
        summaryComposite.setLayoutData(summaryCompositeGridData);

        // Create summary Table widget inside the composite
        const summaryTable = new SWTTable(
          summaryComposite,
          org.eclipse.swt.SWT.BORDER | org.eclipse.swt.SWT.FULL_SELECTION
        );
        summaryTable.setHeaderVisible(true);
        summaryTable.setLinesVisible(true);
        // Track summary-created colors and fonts for proper disposal when the shell closes
        const summaryColorObjects = [];
        const summaryFontObjects = [];
        const summaryHeaderFg = new SWTColor(25, 25, 112);
        const summaryHeaderBg = new SWTColor(173, 216, 230);
        summaryColorObjects.push(summaryHeaderFg);
        summaryColorObjects.push(summaryHeaderBg);
        summaryTable.setHeaderForeground(summaryHeaderFg);
        summaryTable.setHeaderBackground(summaryHeaderBg);

        // Create columns
        const colAspect = new SWTTableColumn(summaryTable, org.eclipse.swt.SWT.NONE);
        colAspect.setText("براساس بُعد");
        colAspect.setWidth(200);

        const colAspectCount = new SWTTableColumn(summaryTable, org.eclipse.swt.SWT.NONE);
        colAspectCount.setText("تعداد");
        colAspectCount.setWidth(80);

        const colSeverity = new SWTTableColumn(summaryTable, org.eclipse.swt.SWT.NONE);
        colSeverity.setText("براساس شدت");
        colSeverity.setWidth(200);

        const colSeverityCount = new SWTTableColumn(summaryTable, org.eclipse.swt.SWT.NONE);
        colSeverityCount.setText("تعداد");
        colSeverityCount.setWidth(80);

        // Add aspect rows
        const aspectKeys = Object.keys(aspectCounts).sort(function (a, b) {
          return aspectCounts[b] - aspectCounts[a];
        });
        
        // Add severity rows - use configured order if available
        let sevOrder = [];
        if (REPORT_MODE && Array.isArray(REPORT_MODE.severityOrder)) {
          sevOrder = REPORT_MODE.severityOrder.filter(function (sk) {
            return severityCounts.hasOwnProperty(sk) && severityCounts[sk] > 0;
          });
        } else {
          sevOrder = Object.keys(severityCounts).filter(function (sk) {
            return severityCounts[sk] > 0;
          });
        }

        // Pre-cache severity colors to avoid creating them repeatedly
        const severityColorCache = {};
        for (let sevIdx = 0; sevIdx < sevOrder.length; sevIdx++) {
          const sk = sevOrder[sevIdx];
          if (SEVERITY[sk]) {
            const colorHex = SEVERITY[sk].color;
            const r_val = parseInt(colorHex.substring(1, 3), 16);
            const g_val = parseInt(colorHex.substring(3, 5), 16);
            const b_val = parseInt(colorHex.substring(5, 7), 16);
            const c = new SWTColor(r_val, g_val, b_val);
            severityColorCache[sk] = c;
            summaryColorObjects.push(c);
          }
        }

        // Build data rows - only rows with actual content
        const dataRows = [];
        const maxPossible = Math.max(aspectKeys.length, sevOrder.length);
        for (let r = 0; r < maxPossible; r++) {
          const hasAspect = r < aspectKeys.length;
          const hasSeverity = r < sevOrder.length;
          
          if (hasAspect || hasSeverity) {
            dataRows.push({
              aspect: hasAspect ? aspectKeys[r] : null,
              severity: hasSeverity ? sevOrder[r] : null
            });
          }
        }

        // Create table items only for rows with data
        for (let ri = 0; ri < dataRows.length; ri++) {
          const row = dataRows[ri];
          const item = new SWTTableItem(summaryTable, org.eclipse.swt.SWT.NONE);

          // Left columns: aspect
          if (row.aspect) {
            const alabel = FA.ASPECTS && FA.ASPECTS[row.aspect] ? FA.ASPECTS[row.aspect] : row.aspect;
            item.setText(0, "    " + alabel);
            item.setText(1, String(aspectCounts[row.aspect]));
          }

          // Right columns: severity
          if (row.severity) {
            const sval = FA.SEVERITY_LABELS && FA.SEVERITY_LABELS[row.severity] ? FA.SEVERITY_LABELS[row.severity] : row.severity;
            item.setText(2, "    " + sval);
            item.setText(3, String(severityCounts[row.severity] || 0));

            // Apply severity color from cache
            if (severityColorCache[row.severity]) {
              item.setBackground(2, severityColorCache[row.severity]);
              item.setBackground(3, severityColorCache[row.severity]);
            }
          }
        }

        // Add footer row with total (at the bottom)
        footerItemRef = new SWTTableItem(summaryTable, org.eclipse.swt.SWT.NONE);
        footerItemRef.setText([
          " شمار همۀ ناهمراستایی‌ها ",
          total,
          "",
          ""
        ]);
        const footerBg = new SWTColor(200, 200, 200);
        summaryColorObjects.push(footerBg);
        footerItemRef.setBackground(footerBg);
        
        // Apply bold font to footer item columns 0 and 1
        try {
          const currentFont = summaryTable.getFont();
          const boldFont = new SWTFont(
            display,
            currentFont.getFontData()[0].getName(),
            currentFont.getFontData()[0].getHeight(),
            org.eclipse.swt.SWT.BOLD
          );
          footerItemRef.setFont(0, boldFont);
          footerItemRef.setFont(1, boldFont);
          summaryFontObjects.push(boldFont);
        } catch (e) {
          // Fallback: if bold font creation fails, continue without bold
        }

        // Set table layout - calculate height based on actual row count
        const summaryGridData = new SWTGridData(org.eclipse.swt.layout.GridData.FILL_HORIZONTAL);
        // Each row is approximately 16-17 pixels + header + margins
        const itemHeight = 16;
        const rowCount = dataRows.length + 1; // +1 for footer
        summaryGridData.heightHint = Math.min(rowCount * itemHeight + 30, 240); // Cap at 240
        summaryGridData.grabExcessHorizontalSpace = true;
        summaryTable.setLayoutData(summaryGridData);

        // Right-side: image label (optional). Use the script directory and exact `img/labelPic_FA.png` if present
        let summaryImage = null;
        try {
          const scriptDir2 = new File(__FILE__).getParent();
          // Only accept the exact filename labelPic_FA.png in the `img/` folder
          const labelPath = new File(scriptDir2, "img" + File.separator + "labelPic_FA.png").getAbsolutePath();
          if (new File(labelPath).exists()) {
            try {
              summaryImage = new SWTImage(display, labelPath);
            } catch (e) {
              try {
                const imgData = new SWTImageData(labelPath);
                summaryImage = new SWTImage(display, imgData);
              } catch (e2) {}
            }
          }
        } catch (e) {}

        const imgLabel = new SWTLabel(summaryComposite, org.eclipse.swt.SWT.NONE);
        if (summaryImage) {
          imgLabel.setImage(summaryImage);
        } else {
          imgLabel.setText("");
        }
        // Set grid hints consistent with target size used above
        const imgGridData = new SWTGridData(org.eclipse.swt.layout.GridData.END | org.eclipse.swt.layout.GridData.VERTICAL_ALIGN_BEGINNING);
        imgGridData.widthHint = 220;
        imgGridData.heightHint = 198;
        imgGridData.grabExcessVerticalSpace = false;
        imgLabel.setLayoutData(imgGridData);

        // ---------- Slider control (bottom center between summary table and image)
        // Refresh functions (rebuilds summary and main tables based on REPORT_MODE)
        function refreshSummary() {
          try {
            // Reset severity counts and aspect counts (keep keys but zero values)
            for (let si = 0; si < REPORT_MODE.severityOrder.length; si++) {
              severityCounts[REPORT_MODE.severityOrder[si]] = 0;
            }
            Object.keys(aspectCounts).forEach(function (k) {
              aspectCounts[k] = 0;
            });
            // Recompute counts
            const sourceFindings = (Array.isArray(findings) && findings.length) ? findings : findingsCache;
            for (let fi = 0; fi < sourceFindings.length; fi++) {
              const ff = sourceFindings[fi];
              if (!isReportableSeverity(ff.code)) continue;
              const s = ff.severity || "LOW";
              severityCounts[s] = (severityCounts[s] || 0) + 1;
              const akey = ff.aspect || "Unclassified";
              aspectCounts[akey] = (aspectCounts[akey] || 0) + 1;
            }
            // Clear existing summary rows
            try { summaryTable.removeAll(); } catch (e) {}
            // Rebuild order and rows
            let newSevOrder = [];
            if (REPORT_MODE && Array.isArray(REPORT_MODE.severityOrder)) {
              newSevOrder = REPORT_MODE.severityOrder.filter(function (sk) {
                return severityCounts.hasOwnProperty(sk) && severityCounts[sk] > 0;
              });
            } else {
              newSevOrder = Object.keys(severityCounts).filter(function (sk) {
                return severityCounts[sk] > 0;
              });
            }
            const ak = Object.keys(aspectCounts).sort(function (a, b) { return aspectCounts[b] - aspectCounts[a]; });
            const maxR = Math.max(ak.length, newSevOrder.length);
            for (let rr = 0; rr < maxR; rr++) {
              const ar = rr < ak.length ? ak[rr] : null;
              const sr = rr < newSevOrder.length ? newSevOrder[rr] : null;
              if (!ar && !sr) continue;
              const rowItem = new SWTTableItem(summaryTable, org.eclipse.swt.SWT.NONE);
              if (ar) {
                const al = FA.ASPECTS && FA.ASPECTS[ar] ? FA.ASPECTS[ar] : ar;
                rowItem.setText(0, "    " + al);
                rowItem.setText(1, String(aspectCounts[ar]));
              }
              if (sr) {
                const sv = FA.SEVERITY_LABELS && FA.SEVERITY_LABELS[sr] ? FA.SEVERITY_LABELS[sr] : sr;
                rowItem.setText(2, "    " + sv);
                rowItem.setText(3, String(severityCounts[sr] || 0));
                if (severityColorCache[sr]) {
                  rowItem.setBackground(2, severityColorCache[sr]);
                  rowItem.setBackground(3, severityColorCache[sr]);
                }
              }
            }
            try { summaryTable.redraw(); } catch (e) {}
            try { summaryTable.layout(); } catch (e) {}
            // Footer
            try {
              // Always add footer showing the count of filtered items
              const filteredCount = sourceFindings.filter(function (ff) { return isReportableSeverity(ff.code); }).length;
              footerItemRef = new SWTTableItem(summaryTable, org.eclipse.swt.SWT.NONE);
              footerItemRef.setText([
                " شمار همۀ ناهمراستایی‌ها ",
                String(filteredCount),
                "",
                ""
              ]);
              footerItemRef.setBackground(footerBg);
            } catch (e) {}
          } catch (e) {
            console.log('refreshSummary error: ' + e);
          }
        }

        function refreshMainTable() {
          try {
            try { table.removeAll(); } catch (e) {}
            const sourceFindings = (Array.isArray(findings) && findings.length) ? findings : findingsCache;
            for (let i = 0; i < sourceFindings.length; i++) {
              const f = sourceFindings[i];
              if (!isReportableSeverity(f.code)) continue;
              const rowItem = new SWTTableItem(table, org.eclipse.swt.SWT.NONE);
              const severityLabel = FA.SEVERITY_LABELS[f.severity] || f.severity || "";
              const aspectLabel = FA.ASPECTS[f.aspect] || f.aspect || "";
              const descLabel = f.desc || (SYMPTOM_CATALOGUE[f.code] && SYMPTOM_CATALOGUE[f.code].desc) || "";
              const docLabel = f.documentation || "";
              rowItem.setText([
                severityLabel,
                f.elementId || "",
                aspectLabel,
                f.code || "",
                f.elementName || "",
                f.elementType || "",
                descLabel,
                docLabel
              ]);
              if (mainSeverityColorCache[f.severity]) {
                rowItem.setBackground(mainSeverityColorCache[f.severity]);
                rowItem.setForeground(mainSeverityTextColorCache[f.severity]);
              } else {
                // Fallback: create a simple severity color on demand when missing
                try {
                  if (SEVERITY[f.severity]) {
                    const hex = SEVERITY[f.severity].color || "#FFFFFF";
                    const r = parseInt(hex.substring(1,3), 16);
                    const g = parseInt(hex.substring(3,5), 16);
                    const b = parseInt(hex.substring(5,7), 16);
                    const c = new SWTColor(r, g, b);
                    const ct = new SWTColor(0,0,0);
                    mainSeverityColorCache[f.severity] = c;
                    mainSeverityTextColorCache[f.severity] = ct;
                    mainColorObjects.push(c);
                    mainColorObjects.push(ct);
                    rowItem.setBackground(c);
                    rowItem.setForeground(ct);
                  }
                } catch (ex) {}
              }
            }
            try { console.log('refreshMainTable: items added = ' + table.getItemCount()); } catch (e) {}
            try { table.redraw(); } catch (e) {}
            try { table.layout(); } catch (e) {}
          } catch (e) {
            console.log('refreshMainTable error:' + e);
          }
        }
        const sliderComposite = new SWTComposite(summaryComposite, org.eclipse.swt.SWT.NONE);
        const sliderCompositeGD = new SWTGridData(org.eclipse.swt.layout.GridData.FILL_HORIZONTAL);
        sliderCompositeGD.horizontalSpan = 2; // span both columns to center under summaryTable & image
        sliderCompositeGD.horizontalAlignment = org.eclipse.swt.layout.GridData.CENTER;
        sliderComposite.setLayoutData(sliderCompositeGD);
        const sliderLayout = new SWTGridLayout(1, false);
        sliderLayout.marginHeight = 6;
        sliderLayout.marginWidth = 0;
        sliderComposite.setLayout(sliderLayout);

        // Label to show the current filter state (minSeverity & includeNonAnalyzable)
        const filterLabel = new SWTLabel(sliderComposite, org.eclipse.swt.SWT.NONE);
        filterLabel.setText(
          "فیلتر: حدأقل شدت = " + (FA.SEVERITY_LABELS[REPORT_MODE.minSeverity] || REPORT_MODE.minSeverity) +
            " | شامل غیرقابل‌تحلیل = " + (REPORT_MODE.includeNonAnalyzable ? "بله" : "خیر")
        );
        const filterLabelGD = new SWTGridData(org.eclipse.swt.layout.GridData.CENTER);
        filterLabelGD.horizontalAlignment = org.eclipse.swt.layout.GridData.CENTER;
        filterLabelGD.horizontalSpan = 2;
        filterLabel.setLayoutData(filterLabelGD);

        // Helper: compute mode mapping from slider position
        function sliderPosToMode(pos) {
          const order = REPORT_MODE && Array.isArray(REPORT_MODE.severityOrder) ? REPORT_MODE.severityOrder : ["CRITICAL", "HIGH", "MEDIUM", "LOW"];
          const idx = Math.max(0, Math.min(pos, order.length - 1));
          const severity = order[idx] || REPORT_MODE.minSeverity || "LOW";
          const lowIndex = (order.indexOf("LOW") >= 0 ? order.indexOf("LOW") : order.length - 1);
          const includeNonAnalyzable = idx === lowIndex;
          return { severity: severity, includeNonAnalyzable: includeNonAnalyzable };
        }

        // Place slider (one control) mapping to severity thresholds
        const slider = new SWTScale(sliderComposite, org.eclipse.swt.SWT.HORIZONTAL);
        slider.setMinimum(0);
        slider.setMaximum(Math.max(0, REPORT_MODE.severityOrder.length - 1));
        slider.setIncrement(1);
        slider.setPageIncrement(1);
        const initialPos = Math.max(0, REPORT_MODE.severityOrder.indexOf(REPORT_MODE.minSeverity));
        slider.setSelection(initialPos >= 0 ? initialPos : 0);
        const sliderGD = new SWTGridData(org.eclipse.swt.layout.GridData.FILL_HORIZONTAL);
        sliderGD.horizontalAlignment = org.eclipse.swt.layout.GridData.CENTER;
        sliderGD.widthHint = 260;
        slider.setLayoutData(sliderGD);

        slider.addListener(org.eclipse.swt.SWT.Selection, function (e) {
          try {
            const pos = slider.getSelection();
            const newMode = sliderPosToMode(pos);
            REPORT_MODE.minSeverity = newMode.severity;
            REPORT_MODE.includeNonAnalyzable = newMode.includeNonAnalyzable;
            filterLabel.setText(
              "فیلتر: حدأقل شدت = " + (FA.SEVERITY_LABELS[REPORT_MODE.minSeverity] || REPORT_MODE.minSeverity) +
                " | شامل غیرقابل‌تحلیل = " + (REPORT_MODE.includeNonAnalyzable ? "بله" : "خیر")
            );
            // Recalculate and refresh tables
            try { refreshSummary(); } catch (fr) {}
            try { refreshMainTable(); } catch (fr) {}
            try { console.log('Slider pos: ' + pos + ' | sourceFindings: ' + ((Array.isArray(findings) && findings.length) ? findings.length : findingsCache.length) + ' | items: ' + table.getItemCount()); } catch (ex) {}
            shell.layout();
          } catch (err) {
            console.log('slider handler error: ' + err);
          }
        });
      } catch (e) {
        // Non-fatal: if summary can't be built, continue without it
        console.log("هشدار: امکان ساخت جدول خلاصه وجود نداشت" + e);
      }

        // Load and set the shell icon image (exact `img/sellIcon.png` only)
      try {
        const scriptDir = new File(__FILE__).getParent();
        const iconPath = new File(scriptDir, "img" + File.separator + "sellIcon.png").getAbsolutePath();
        if (new File(iconPath).exists()) {
          try {
            image = new SWTImage(display, iconPath);
            shell.setImage(image);
          } catch (exImage) {}
        }
      } catch (e) {
        console.log("هشدار: نتوانستیم تصویر نماد را بارگذاری کنیم: " + e);
      }

          shell.open();
          // Attempt to force the dialog above the Archi main window and focus it.
          try {
            if (activeShell && shell.moveAbove) {
              shell.moveAbove(activeShell);
            }
            // Try to force focus onto the new dialog
            shell.setActive && shell.setActive();
            shell.forceActive && shell.forceActive();
            shell.setFocus && shell.setFocus();
            shell.forceFocus && shell.forceFocus();
            // On some platforms the first focus call needs a short delay to win over the main window.
            display.timerExec && display.timerExec(50, function () {
              try {
                shell.setActive && shell.setActive();
                shell.forceActive && shell.forceActive();
                shell.setFocus && shell.setFocus();
                shell.forceFocus && shell.forceFocus();
              } catch (e) {}
            });
          } catch (e) {}
          try {
            shell.layout();
            shell.forceActive && shell.forceActive();
            shell.forceFocus && shell.forceFocus();
          } catch (e) {}
          console.log("اشکال‌زدایی ▂▂ فراخوانی تابع بازکردن شِل و تلاش برای متمرکزشدن");
          // Release the large `findings` JS array now that TableItems have been created.
          // The SWT Table stores strings internally; freeing the JS array reduces heap usage.
          try {
            if (Array.isArray(findings) && findings.length) {
              // Copy to cache first so we can re-render later if the user
              // changes the slider-based filters. Only copy if we don't already
              // have a cached version to avoid duplicate entries.
              if (!Array.isArray(findingsCache) || !findingsCache.length) {
                for (let fi = 0; fi < findings.length; fi++) {
                  findingsCache.push(findings[fi]);
                }
              }
              // Free the large `findings` JS array to reduce heap pressure.
              findings.length = 0;
              console.log("اشکال‌زدایی ▂▂ آرایۀ یافته‌ها خالی شدند تا فشار بر پشته کاهش یابد و این یافته‌ها کپی شدند، به آرایۀ: findingsCache");
            }
          } catch (e) {}

      // Proper non-modal implementation: Shell shares the main Display's event loop
      // The dialog will handle events through the existing jArchi Display without blocking
      // User can interact with both the dialog and main Archi window simultaneously
      // The shell will remain responsive until manually closed by the user

      // Add dispose listener to clean up image and color resources when shell closes
          shell.addDisposeListener(function (e) {
            if (image && !image.isDisposed()) {
              image.dispose();
            }
            if (summaryImage && !summaryImage.isDisposed()) {
              summaryImage.dispose();
            }
            try {
              // dispose cached colors
              Object.keys(mainSeverityColorCache).forEach(function (k) {
                try { if (mainSeverityColorCache[k] && !mainSeverityColorCache[k].isDisposed()) mainSeverityColorCache[k].dispose(); } catch (ex) {}
              });
              Object.keys(mainSeverityTextColorCache).forEach(function (k) {
                try { if (mainSeverityTextColorCache[k] && !mainSeverityTextColorCache[k].isDisposed()) mainSeverityTextColorCache[k].dispose(); } catch (ex) {}
              });
              try {
                // dispose top-level table colors we cached
                if (typeof mainColorObjects !== 'undefined' && mainColorObjects) {
                  for (let mi = 0; mi < mainColorObjects.length; mi++) {
                    try { const cc = mainColorObjects[mi]; if (cc && !cc.isDisposed()) cc.dispose(); } catch (inner) {}
                  }
                }
              } catch (ex) {}
            } catch (ex) {}
            try {
              // dispose summary-local color objects (header/footer/severity rows)
              if (typeof summaryColorObjects !== 'undefined' && summaryColorObjects) {
                for (let i = 0; i < summaryColorObjects.length; i++) {
                  try { const co = summaryColorObjects[i]; if (co && !co.isDisposed()) co.dispose(); } catch (inner) {}
                }
              }
            } catch (ex) {}
            try {
              // dispose the per-summary severity color cache if present
              if (typeof severityColorCache !== 'undefined' && severityColorCache) {
                Object.keys(severityColorCache).forEach(function (k) {
                  try { if (severityColorCache[k] && !severityColorCache[k].isDisposed()) severityColorCache[k].dispose(); } catch (inner) {}
                });
              }
            } catch (ex) {}
            try {
              // dispose any fonts created for the summary
              if (typeof summaryFontObjects !== 'undefined' && summaryFontObjects) {
                for (let fi = 0; fi < summaryFontObjects.length; fi++) {
                  try { const ff = summaryFontObjects[fi]; if (ff && !ff.isDisposed()) ff.dispose(); } catch (inner) {}
                }
              }
            } catch (ex) {}
            try {
              // dispose any main fonts or other global font objects if present
            } catch (ex) {}
          });
        } catch (e) {
          console.log("خطا در نمایش پنجرۀ داخلی: " + e);
        }
      });
    } catch (e) {
      console.log("خطا در زمان‌بندی پنجره روی زیربرنامۀ رابط کاربری: " + e);
    }
  }

  // produce CSV and XLS (HTML)
  /**
   * Exports findings to CSV and XLS (HTML table) formats.
   * Creates two sibling files in the script's directory with detailed misalignment reports.
   *
   * CSV format:
   * - Comma-separated values with full headers
   * - One finding per row
   * - Suitable for import into Excel, databases, or analysis tools
   *
   * XLS format:
   * - HTML table with CSS styling and color-coding by severity
   * - Professional formatting for business presentation
   * - Severity-based row coloring for quick visual scanning
   *
   * Output files:
   * - csvPath: alignment_report.csv
   * - xlsPath: alignment_report.xls
   */
  function writeFiles() {
    try {
      if (writeCSV) {
        let fw = new FileWriter(csvPath);
        // Write UTF-8 BOM to help Excel recognize encoding properly
        try { fw.write('\uFEFF'); } catch (e) {}
        // Write CSV header in Persian
        fw.write(
          FA.COLUMNS.severity +
            "," +
            FA.COLUMNS.elementId +
            "," +
            FA.COLUMNS.aspect +
            "," +
            FA.COLUMNS.code +
            "," +
            FA.COLUMNS.elementName +
            "," +
            FA.COLUMNS.elementType +
            "," +
            FA.COLUMNS.description +
            "," +
            FA.COLUMNS.documentation +
            "," +
            FA.COLUMNS.analyzable +
            "\n"
        );
        const exportFindings = (Array.isArray(findings) && findings.length) ? findings : findingsCache;
        for (let j = 0; j < exportFindings.length; j++) {
          const r = exportFindings[j];
          /**
           * Escapes and quotes a string for CSV format.
           * Wraps value in double quotes and escapes internal quotes by doubling them.
           * This ensures values with commas, quotes, or newlines are properly escaped.
           *
           * @param {string} s - The string to escape
           * @returns {string} - The CSV-escaped string with surrounding quotes\n           */
          function esc(s) {
            return '"' + String(s || "").replace(/"/g, '""') + '"';
          }
          fw.write(
            esc(FA.SEVERITY_LABELS[r.severity] || r.severity) +
              "," +
              esc(r.elementId) +
              "," +
              esc(FA.ASPECTS[r.aspect] || r.aspect) +
              "," +
              esc(r.code) +
              "," +
              esc(r.elementName) +
              "," +
              esc(r.elementType) +
              "," +
              esc(r.desc) +
              "," +
              esc(r.documentation) +
              "," +
              esc(r.analyzable ? "بله" : "خیر") +
              "\n"
          );
        }
        fw.close();
        info("\nCSV exported: " + csvPath);
      }

      if (writeXLS) {
        // Stream the HTML output to disk instead of concatenating a large string in memory.
        try {
          // Reuse hoisted FileOutputStream, OutputStreamWriter, BufferedWriter, and StandardCharsets

          const fos = new FileOutputStream(xlsPath);
          const osw = new OutputStreamWriter(fos, StandardCharsets.UTF_8);
          const bw = new BufferedWriter(osw);
          try {
            // Optional BOM for some Excel versions (keeps UTF-8 safe)
            try { bw.write('\uFEFF'); } catch (e) {}
            bw.write("<html dir='rtl' lang='fa'><head><meta charset='utf-8'><style>table{border-collapse:collapse;width:100%}th,td{border:1px solid #ddd;padding:8px;text-align:left}th{background-color:#f2f2f2}tr:nth-child(even){background-color:#f9f9f9}.CRITICAL{background-color:#ffcccc}.HIGH{background-color:#ffe6cc}.MEDIUM{background-color:#ffffe6}.LOW{background-color:#ffffcc}</style></head><body dir='rtl'>");
            bw.write("<table><thead><tr><th>"); bw.write(FA.COLUMNS.severity);
            bw.write("</th><th>"); bw.write(FA.COLUMNS.elementId);
            bw.write("</th><th>"); bw.write(FA.COLUMNS.aspect);
            bw.write("</th><th>"); bw.write(FA.COLUMNS.code);
            bw.write("</th><th>"); bw.write(FA.COLUMNS.elementName);
            bw.write("</th><th>"); bw.write(FA.COLUMNS.elementType);
            bw.write("</th><th>"); bw.write(FA.COLUMNS.description);
            bw.write("</th><th>"); bw.write(FA.COLUMNS.documentation);
            bw.write("</th></tr></thead><tbody>");

            function escHtml(s) {
              return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            }

              const exportFindings = (Array.isArray(findings) && findings.length) ? findings : findingsCache;
              for (let k = 0; k < exportFindings.length; k++) {
                const r2 = exportFindings[k];
              const rowClass = r2.severity ? " class='" + r2.severity + "'" : "";
              const sevLabel = FA.SEVERITY_LABELS[r2.severity] || r2.severity || "";
              const aspLabel = FA.ASPECTS[r2.aspect] || r2.aspect || "";
              bw.write("<tr" + rowClass + "><td>"); bw.write(escHtml(sevLabel)); bw.write("</td>");
              bw.write("<td>"); bw.write(escHtml(r2.elementId)); bw.write("</td>");
              bw.write("<td>"); bw.write(escHtml(aspLabel)); bw.write("</td>");
              bw.write("<td>"); bw.write(escHtml(r2.code)); bw.write("</td>");
              bw.write("<td>"); bw.write(escHtml(r2.elementName)); bw.write("</td>");
              bw.write("<td>"); bw.write(escHtml(r2.elementType)); bw.write("</td>");
              bw.write("<td>"); bw.write(escHtml(r2.desc)); bw.write("</td>");
              bw.write("<td>"); bw.write(escHtml(r2.documentation)); bw.write("</td>");
              bw.write("</tr>");
            }

            bw.write("</tbody></table></body></html>");
          } finally {
            try { bw.close(); } catch (e) {}
          }
          info("از گزارشِ سازگار با اِکسل خروجی گرفته شد:  " + xlsPath);
        } catch (ex) {
          console.log("خطا در نوشتن گزارش اکسل به‌صورت جریانی: " + ex);
        }
      }
    } catch (e) {
      console.log("خطا در نوشتن فایل‌های خروجی: " + e);
    }
  }

  writeFiles();

  // Display table in SWT Dialog
  // Summary diagnostics removed to clean up debug output; leave the findings available for exports and UI

  // Debugging sample insertion removed for production

  console.log("اشکال‌زدایی ▂▂ فراخوانی تابع displayTableDialog(): ");
  // LOW severity sample diagnostics removed after verification
  displayTableDialog();

  heading("پایان اسکریپت");
  info("گزارش‌ها ذخیره شدند در: " + csvPath + " و " + xlsPath);
})();

